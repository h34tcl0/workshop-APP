<!-- TAB 1: UBICACIÓN -->
<div id="tab-content-location" class="settings-tab-content space-y-4">
    <div>
        <div class="flex items-center justify-between mb-1.5">
            <div class="flex items-center gap-1.5">
                <label class="block text-[11px] font-semibold text-ink3 uppercase tracking-wide">Coordenadas del Taller</label>
                <button type="button" onclick="toggleTip('location')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Ubicación">
                    <svg class="w-3 h-3"><use href="#i-help"/></svg>
                </button>
            </div>
            <button type="button" onclick="toggleLocationMap()" class="flex items-center gap-1.5 text-[11px] font-semibold text-chalk hover:text-chalk/80">
                <svg class="w-3.5 h-3.5"><use href="#i-pin"/></svg> Elegir en el mapa
            </button>
        </div>
        <p id="tip-location" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Ubicación del taller para consultar el pronóstico del clima y determinar automáticamente la zona horaria.</p>
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
            <div>
                <label class="block text-[10px] text-ink3 mb-1">Latitud</label>
                <input type="number" step="0.0001" id="input-latitude" name="latitude" value="<%= app_settings ? app_settings.latitude : -32.99 %>" class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass transition-colors">
            </div>
            <div>
                <label class="block text-[10px] text-ink3 mb-1">Longitud</label>
                <input type="number" step="0.0001" id="input-longitude" name="longitude" value="<%= app_settings ? app_settings.longitude : -71.27 %>" class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass transition-colors">
            </div>
        </div>

        <!-- Panel de mapa (oculto por defecto) -->
        <div id="location-map-panel" class="hidden mt-3 space-y-2">
            <div class="flex items-center gap-2">
                <div class="relative flex-1">
                    <svg class="w-3.5 h-3.5 text-ink3 absolute left-3 top-1/2 -translate-y-1/2"><use href="#i-search"/></svg>
                    <input type="text" id="map-search-input" placeholder="Buscar dirección o ciudad..." class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-chalk transition-colors">
                </div>
                <button type="button" onclick="searchMapLocation()" class="bg-chalk/15 hover:bg-chalk/25 text-chalk px-3 py-2 rounded-lg text-xs font-semibold whitespace-nowrap">Buscar</button>
            </div>
            <div id="location-map" class="w-full h-52 rounded-lg border border-hairline overflow-hidden"></div>
            <p class="text-[11px] text-ink3">Toca el mapa para fijar el punto. Las coordenadas se actualizan solas.</p>
        </div>

        <!-- Indicador de Hora Local Sincronizada -->
        <div class="mt-4 p-3 bg-canvas/60 border border-hairline/80 rounded-xl flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-surface2 flex items-center justify-center text-chalk shrink-0">
                    <svg class="w-4 h-4"><use href="#i-timer"/></svg>
                </div>
                <div>
                    <span class="block text-[11px] font-semibold text-ink3 uppercase tracking-wide">Hora local sincronizada</span>
                    <span id="local-time-display" class="text-sm font-mono font-bold text-ink">
                        <%= typeof local_time_info !== 'undefined' && local_time_info ? local_time_info.formattedDisplay : 'Cargando...' %>
                    </span>
                </div>
            </div>
            <span id="timezone-display" class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-surface2 border border-hairline text-chalk font-semibold shrink-0">
                <%= app_settings && app_settings.timezone ? app_settings.timezone : 'America/Santiago' %>
            </span>
            <input type="hidden" id="input-timezone" name="timezone" value="<%= app_settings && app_settings.timezone ? app_settings.timezone : 'America/Santiago' %>">
        </div>
    </div>
</div>
