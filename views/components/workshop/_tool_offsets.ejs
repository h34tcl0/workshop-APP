<!-- SUB-TOOL: CALCULADORA DE OFFSETS & MEDIDAS -->
<div id="tool-offsets-view" class="space-y-6 w-full">
    <!-- CALCULATOR DISPLAY & MAIN CARD -->
    <div class="bg-surface border-2 border-brass/50 rounded-3xl p-5 sm:p-7 shadow-2xl space-y-5 max-w-2xl mx-auto">
        <!-- HEADER -->
        <div class="flex items-center justify-between border-b border-hairline pb-4">
            <div>
                <h2 class="font-display text-xl sm:text-2xl font-bold text-ink flex items-center gap-2">
                    <svg class="w-6 h-6 text-brass"><use href="#i-calc"/></svg>
                    Calculadora de Offsets & Medidas
                </h2>
            </div>
            <button type="button" onclick="openManageOffsetsModal()" class="flex items-center gap-1.5 bg-surface2 hover:bg-hairline border border-hairline text-ink2 hover:text-ink px-3 py-2 rounded-xl text-xs font-semibold transition-colors">
                <svg class="w-4 h-4 text-brass"><use href="#i-gear"/></svg> Presets
            </button>
        </div>

        <!-- SCREEN DISPLAY -->
        <div class="bg-canvas border border-hairline rounded-2xl p-4 sm:p-5 text-right font-mono space-y-1 shadow-inner">
            <div id="calc-expression" class="text-xs sm:text-sm text-ink3 min-h-[1.25rem] truncate font-medium">0</div>
            <div id="calc-display" class="text-3xl sm:text-4xl font-extrabold text-brass tracking-wider truncate">0</div>
            <div id="calc-offset-label" class="text-[10px] text-moss min-h-[1rem] font-semibold"></div>
        </div>

        <!-- BOTONES DE OFFSETS Y PRESETS CONFIGURADOS -->
        <div>
            <div class="flex items-center justify-between mb-2">
                <span class="text-[11px] font-semibold text-ink3 uppercase tracking-wide">Offsets Rápidos Configurados:</span>
                <span class="text-[10px] text-brass hover:underline cursor-pointer font-medium" onclick="openManageOffsetsModal()">+ Editar Presets</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="presets-quick-bar">
                <% (locals.calculator_offsets || []).forEach(off => { %>
                    <button type="button" 
                            onclick="applyOffsetPreset(<%= off.offset_value %>, '<%= off.label %>')"
                            class="flex flex-col items-center justify-center p-3 rounded-xl bg-surface2 hover:bg-brass/20 border-2 border-hairline hover:border-brass text-ink transition-all shadow-sm active:scale-95 min-h-[56px]">
                        <span class="font-bold text-sm text-brass"><%= off.label %></span>
                        <span class="text-[10px] font-mono text-ink2"><%= off.offset_value > 0 ? '+' : '' %><%= off.offset_value %> <%= off.unit %></span>
                    </button>
                <% }); %>
            </div>
        </div>

        <!-- TECLADO NUMÉRICO Y OPERACIONES (TOUCH-FRIENDLY > 48px) -->
        <div class="grid grid-cols-4 gap-2.5 pt-2">
            <!-- FILA 1 -->
            <button type="button" onclick="calcClear()" class="p-4 rounded-xl bg-rust/20 hover:bg-rust/30 border border-rust/40 text-rust font-bold text-lg min-h-[52px] active:scale-95 shadow-sm">C</button>
            <button type="button" onclick="calcBackspace()" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-lg min-h-[52px] active:scale-95 shadow-sm">⌫</button>
            <button type="button" onclick="calcInput('/')" class="p-4 rounded-xl bg-surface2 hover:bg-brass/20 border border-hairline hover:border-brass text-brass font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">÷</button>
            <button type="button" onclick="calcInput('*')" class="p-4 rounded-xl bg-surface2 hover:bg-brass/20 border border-hairline hover:border-brass text-brass font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">×</button>

            <!-- FILA 2 -->
            <button type="button" onclick="calcInput('7')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">7</button>
            <button type="button" onclick="calcInput('8')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">8</button>
            <button type="button" onclick="calcInput('9')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">9</button>
            <button type="button" onclick="calcInput('-')" class="p-4 rounded-xl bg-surface2 hover:bg-brass/20 border border-hairline hover:border-brass text-brass font-bold text-2xl min-h-[52px] active:scale-95 shadow-sm">−</button>

            <!-- FILA 3 -->
            <button type="button" onclick="calcInput('4')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">4</button>
            <button type="button" onclick="calcInput('5')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">5</button>
            <button type="button" onclick="calcInput('6')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">6</button>
            <button type="button" onclick="calcInput('+')" class="p-4 rounded-xl bg-surface2 hover:bg-brass/20 border border-hairline hover:border-brass text-brass font-bold text-2xl min-h-[52px] active:scale-95 shadow-sm">+</button>

            <!-- FILA 4 -->
            <button type="button" onclick="calcInput('1')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">1</button>
            <button type="button" onclick="calcInput('2')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">2</button>
            <button type="button" onclick="calcInput('3')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">3</button>
            <button type="button" onclick="calcEquals()" class="p-4 rounded-xl bg-brass hover:bg-brassdim text-canvas font-extrabold text-2xl min-h-[52px] row-span-2 flex items-center justify-center shadow-md active:scale-95">=</button>

            <!-- FILA 5 -->
            <button type="button" onclick="calcInput('0')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl col-span-2 min-h-[52px] active:scale-95 shadow-sm">0</button>
            <button type="button" onclick="calcInput('.')" class="p-4 rounded-xl bg-surface2 hover:bg-hairline border border-hairline text-ink font-bold text-xl min-h-[52px] active:scale-95 shadow-sm">.</button>
        </div>
    </div>

    <!-- HISTORIAL DE CÁLCULOS DE LA SESIÓN -->
    <div class="bg-surface border border-hairline rounded-2xl p-5 shadow-panel max-w-2xl mx-auto space-y-3">
        <div class="flex items-center justify-between border-b border-hairline pb-2">
            <h3 class="font-display text-sm font-semibold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-brass"><use href="#i-history"/></svg>
                Historial Reciente de Cálculos
            </h3>
            <button type="button" onclick="clearCalcHistory()" class="text-xs text-rust hover:underline font-medium">Limpiar</button>
        </div>

        <div id="calc-history-list" class="space-y-2 max-h-48 overflow-y-auto font-mono text-xs">
            <p class="text-ink3 text-center py-3 italic font-sans text-xs">Realiza cálculos en el taller para registrar aquí tu historial.</p>
        </div>
    </div>
</div>

<!-- MODAL GESTIÓN DE PRESETS DE OFFSETS -->
<div id="manage-offsets-modal" class="fixed inset-0 bg-canvas/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-surface border border-hairline rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-5">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-lg font-bold text-ink flex items-center gap-2">
                <svg class="w-5 h-5 text-brass"><use href="#i-gear"/></svg> Configurar Presets de Offsets
            </h3>
            <button type="button" onclick="closeManageOffsetsModal()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <!-- AGREGAR NUEVO PRESET -->
        <form action="/calculator/offsets/add" method="post" id="add-offset-form" onsubmit="submitAddOffsetForm(event)" class="space-y-3 bg-surface2/60 border border-hairline p-3.5 rounded-xl">
            <span class="block text-xs font-bold text-brass uppercase">Nuevo Offset de Taller</span>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-[10px] font-semibold text-ink3 uppercase mb-1">Etiqueta</label>
                    <input type="text" name="label" required placeholder="Ej. -185 Riel" class="w-full bg-surface hover:bg-surface/80 border border-hairline text-ink rounded-lg px-2.5 py-1.5 text-xs focus:outline-none focus:border-brass transition-colors">
                </div>
                <div>
                    <label class="block text-[10px] font-semibold text-ink3 uppercase mb-1">Valor Offset</label>
                    <input type="number" step="0.1" name="offset_value" required placeholder="-185 ó +3" class="w-full bg-surface hover:bg-surface/80 border border-hairline text-ink rounded-lg px-2.5 py-1.5 text-xs focus:outline-none focus:border-brass font-mono transition-colors">
                </div>
            </div>
            <div>
                <label class="block text-[10px] font-semibold text-ink3 uppercase mb-1">Descripción</label>
                <input type="text" name="description" placeholder="Ej. Descuento guía/riel cajón" class="w-full bg-surface hover:bg-surface/80 border border-hairline text-ink rounded-lg px-2.5 py-1.5 text-xs focus:outline-none focus:border-brass transition-colors">
            </div>
            <button type="submit" class="w-full bg-brass hover:bg-brassdim text-canvas py-2 rounded-lg text-xs font-bold transition-colors">
                + Guardar Preset
            </button>
        </form>

        <!-- LISTA DE PRESETS EXISTENTES -->
        <div class="space-y-2 max-h-56 overflow-y-auto">
            <span class="block text-xs font-bold text-ink3 uppercase">Presets Actuales:</span>
            <% (locals.calculator_offsets || []).forEach(off => { %>
                <div class="flex items-center justify-between p-2.5 bg-surface2 border border-hairline rounded-lg font-mono text-xs">
                    <div>
                        <span class="font-bold text-brass"><%= off.label %></span>
                        <span class="text-ink2 text-[11px] ml-2">(<%= off.offset_value > 0 ? '+' : '' %><%= off.offset_value %> <%= off.unit %>)</span>
                        <% if (off.description) { %>
                            <p class="text-[10px] text-ink3 font-sans mt-0.5"><%= off.description %></p>
                        <% } %>
                    </div>
                    <button type="button" onclick="deleteOffsetPreset(<%= off.id %>)" class="text-ink3 hover:text-rust p-1">
                        <svg class="w-4 h-4"><use href="#i-close"/></svg>
                    </button>
                </div>
            <% }); %>
        </div>

        <div class="flex justify-end pt-2">
            <button type="button" onclick="closeManageOffsetsModal()" class="bg-surface2 hover:bg-hairline text-ink px-4 py-2 rounded-xl text-xs font-semibold">Cerrar</button>
        </div>
    </div>
</div>
