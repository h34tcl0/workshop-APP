<!-- LEFT RAIL: NAVEGACIÓN VERTICAL DE HERRAMIENTAS DE TALLER (DESKTOP/TABLET >= 768px) -->
<div id="workshop-left-rail-panel" class="hidden md:flex w-14 sm:w-16 shrink-0 flex-col items-center py-3 bg-surface border border-hairline rounded-2xl shadow-panel gap-2.5 sticky top-4 z-20">

    <!-- 1. Offsets & Medidas -->
    <button type="button" 
            id="ws-rail-btn-offsets" 
            onclick="switchWorkshopTool('offsets')" 
            title="Offsets & Medidas"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-brass text-canvas font-bold flex flex-col items-center justify-center shadow-xs transition-all active:scale-95 group relative">
        <svg class="w-5 h-5"><use href="#i-calc"/></svg>
        <span class="sr-only">Offsets & Medidas</span>
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Offsets & Medidas
        </span>
    </button>

    <!-- 2. Tornillos & Fijaciones -->
    <button type="button" 
            id="ws-rail-btn-screws" 
            onclick="switchWorkshopTool('screws')" 
            title="Tornillos & Fijaciones (Huincha corrida)"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface2 hover:bg-hairline text-ink hover:text-brass flex flex-col items-center justify-center transition-all group active:scale-95 relative">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 2h4l1 4H9l1-4z"/>
            <path d="M10 6v11l2 3 2-3V6"/>
            <line x1="10" y1="9" x2="14" y2="11"/>
            <line x1="10" y1="13" x2="14" y2="15"/>
        </svg>
        <span class="sr-only">Tornillos & Fijaciones</span>
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Tornillos & Fijaciones
        </span>
    </button>

    <div class="w-8 h-px bg-hairline"></div>

    <!-- 3. Escuadra & Diagonales -->
    <button type="button" 
            id="ws-rail-btn-square" 
            onclick="switchWorkshopTool('square')" 
            title="Escuadra & Diagonales"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface2 hover:bg-hairline text-ink hover:text-brass flex flex-col items-center justify-center transition-all group active:scale-95 relative">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21h18"/>
            <path d="M3 21V3l4 4v10h10l4 4"/>
            <line x1="7" y1="17" x2="7" y2="15"/>
            <line x1="11" y1="17" x2="11" y2="15"/>
            <line x1="15" y1="17" x2="15" y2="15"/>
            <line x1="7" y1="13" x2="7" y2="11"/>
            <line x1="7" y1="9" x2="7" y2="7"/>
        </svg>
        <span class="sr-only">Escuadra & Diagonales</span>
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Escuadra & Diagonales
        </span>
    </button>

    <!-- 4. Centrador & Luces -->
    <button type="button" 
            id="ws-rail-btn-centering" 
            onclick="switchWorkshopTool('centering')" 
            title="Centrador & Luces"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface2 hover:bg-hairline text-ink hover:text-brass flex flex-col items-center justify-center transition-all group active:scale-95 relative">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/>
            <circle cx="12" cy="12" r="5"/>
            <circle cx="12" cy="12" r="1.5"/>
            <line x1="12" y1="2" x2="12" y2="5"/>
            <line x1="12" y1="19" x2="12" y2="22"/>
            <line x1="2" y1="12" x2="5" y2="12"/>
            <line x1="19" y1="12" x2="22" y2="12"/>
        </svg>
        <span class="sr-only">Centrador & Luces</span>
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Centrador & Luces
        </span>
    </button>

    <!-- 5. Visor 3D -->
    <button type="button" 
            id="ws-rail-btn-viewer3d" 
            onclick="switchWorkshopTool('viewer3d')" 
            title="Visor 3D"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface2 hover:bg-hairline text-ink hover:text-brass flex flex-col items-center justify-center transition-all group active:scale-95 relative">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
        </svg>
        <span class="sr-only">Visor 3D</span>
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Visor 3D
        </span>
    </button>

</div>
