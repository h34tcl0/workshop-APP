<!-- SUB-TOOL: CENTRADOR & REPARTO DE LUCES -->
<div id="tool-centering-view" class="space-y-6 w-full hidden">
    <div class="bg-surface border-2 border-brass/50 rounded-3xl p-5 sm:p-7 shadow-2xl space-y-5 max-w-3xl mx-auto">
        <!-- HEADER -->
        <div class="flex items-center justify-between border-b border-hairline pb-4">
            <div>
                <h2 class="font-display text-xl sm:text-2xl font-bold text-ink flex items-center gap-2">
                    <svg class="w-6 h-6 text-brass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"/>
                        <circle cx="12" cy="12" r="4"/>
                        <line x1="12" y1="2" x2="12" y2="6"/>
                        <line x1="12" y1="18" x2="12" y2="22"/>
                        <line x1="2" y1="12" x2="6" y2="12"/>
                        <line x1="18" y1="12" x2="22" y2="12"/>
                    </svg>
                    Centrador & Reparto de Luces
                </h2>
                <p class="text-xs text-ink3 mt-0.5 font-sans">Reparto equidistante de listones y plantilla de perforación para tiradores</p>
            </div>
            <!-- SELECTOR DE MODO -->
            <div class="flex bg-surface2 border border-hairline p-1 rounded-xl">
                <button type="button" id="centering-btn-mode-bars" onclick="setCenteringMode('bars')"
                        class="py-1.5 px-3 rounded-lg text-xs font-bold bg-brass text-canvas transition-all shadow-xs flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <line x1="9" y1="3" x2="9" y2="21"/>
                        <line x1="15" y1="3" x2="15" y2="21"/>
                    </svg>
                    Barrotes
                </button>
                <button type="button" id="centering-btn-mode-handles" onclick="setCenteringMode('handles')"
                        class="py-1.5 px-3 rounded-lg text-xs font-medium text-ink2 hover:text-ink transition-all flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="6" width="20" height="12" rx="2"/>
                        <circle cx="8" cy="12" r="1.5"/>
                        <circle cx="16" cy="12" r="1.5"/>
                    </svg>
                    Tiradores
                </button>
            </div>
        </div>

        <!-- FORMULARIO MODO 1: REPARTO DE BARROTES -->
        <div id="centering-panel-bars" class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 bg-surface2/60 border border-hairline p-4 rounded-2xl">
            <div>
                <label class="block text-[11px] font-bold text-ink2 uppercase mb-1">
                    Ancho Vano (<span class="text-brass">W</span> mm)
                </label>
                <input type="number" id="c-bars-width" min="10" step="1" value="1200" oninput="calculateCentering()"
                       class="w-full bg-surface border border-hairline hover:border-brass text-ink font-mono font-bold text-base rounded-xl px-3 py-2.5 focus:outline-none focus:border-brass transition-colors">
            </div>
            <div>
                <label class="block text-[11px] font-bold text-ink2 uppercase mb-1">
                    Ancho Barrote (<span class="text-brass">Sw</span> mm)
                </label>
                <input type="number" id="c-bars-bar-width" min="1" step="1" value="40" oninput="calculateCentering()"
                       class="w-full bg-surface border border-hairline hover:border-brass text-ink font-mono font-bold text-base rounded-xl px-3 py-2.5 focus:outline-none focus:border-brass transition-colors">
            </div>
            <div>
                <label class="block text-[11px] font-bold text-ink2 uppercase mb-1">
                    Cantidad Barrotes (<span class="text-brass">N</span>)
                </label>
                <input type="number" id="c-bars-count" min="1" max="100" step="1" value="5" oninput="calculateCentering()"
                       class="w-full bg-surface border border-hairline hover:border-brass text-ink font-mono font-bold text-base rounded-xl px-3 py-2.5 focus:outline-none focus:border-brass transition-colors">
            </div>
        </div>

        <!-- FORMULARIO MODO 2: CENTRADOR DE TIRADORES (OCULTO POR DEFECTO) -->
        <div id="centering-panel-handles" class="hidden space-y-3 bg-surface2/60 border border-hairline p-4 rounded-2xl">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                <div>
                    <label class="block text-[11px] font-bold text-ink2 uppercase mb-1">
                        Ancho Frente (<span class="text-brass">W</span> mm)
                    </label>
                    <input type="number" id="c-handles-w" min="10" step="1" value="600" oninput="calculateCentering()"
                           class="w-full bg-surface border border-hairline hover:border-brass text-ink font-mono font-bold text-base rounded-xl px-3 py-2.5 focus:outline-none focus:border-brass transition-colors">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-ink2 uppercase mb-1">
                        Alto Frente (<span class="text-brass">H</span> mm)
                    </label>
                    <input type="number" id="c-handles-h" min="10" step="1" value="200" oninput="calculateCentering()"
                           class="w-full bg-surface border border-hairline hover:border-brass text-ink font-mono font-bold text-base rounded-xl px-3 py-2.5 focus:outline-none focus:border-brass transition-colors">
                </div>
            </div>
            <div>
                <div class="flex items-center justify-between mb-1">
                    <label class="text-[11px] font-bold text-ink2 uppercase">
                        Distancia Entre Centros (<span class="text-brass">CC</span> mm)
                    </label>
                    <div class="flex gap-1">
                        <button type="button" onclick="setHandleCcPreset(0)" class="px-2 py-0.5 text-[10px] font-mono bg-surface border border-hairline hover:border-brass rounded text-ink2 hover:text-ink">Punto (0)</button>
                        <button type="button" onclick="setHandleCcPreset(96)" class="px-2 py-0.5 text-[10px] font-mono bg-surface border border-hairline hover:border-brass rounded text-ink2 hover:text-ink">96mm</button>
                        <button type="button" onclick="setHandleCcPreset(128)" class="px-2 py-0.5 text-[10px] font-mono bg-surface border border-hairline hover:border-brass rounded text-ink2 hover:text-ink">128mm</button>
                        <button type="button" onclick="setHandleCcPreset(160)" class="px-2 py-0.5 text-[10px] font-mono bg-surface border border-hairline hover:border-brass rounded text-ink2 hover:text-ink">160mm</button>
                        <button type="button" onclick="setHandleCcPreset(192)" class="px-2 py-0.5 text-[10px] font-mono bg-surface border border-hairline hover:border-brass rounded text-ink2 hover:text-ink">192mm</button>
                    </div>
                </div>
                <input type="number" id="c-handles-cc" min="0" step="1" value="128" oninput="calculateCentering()"
                       class="w-full bg-surface border border-hairline hover:border-brass text-ink font-mono font-bold text-base rounded-xl px-3 py-2.5 focus:outline-none focus:border-brass transition-colors">
            </div>
        </div>

        <!-- ERROR BANNER -->
        <div id="centering-error-banner" class="hidden bg-rust/10 border border-rust/30 text-rust p-3.5 rounded-2xl text-xs font-semibold flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span id="centering-error-text">Los parámetros exceden las dimensiones disponibles.</span>
        </div>

        <!-- PANEL DE MÉTRICAS -->
        <div id="centering-metrics-panel" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <!-- Métrica 1 -->
            <div class="bg-surface2/80 border border-hairline rounded-2xl p-3.5 text-center">
                <span id="c-metric-1-lbl" class="text-[10px] uppercase font-bold text-ink3 block tracking-wide">Luz Entre Barrotes</span>
                <span id="c-metric-1-val" class="text-xl sm:text-2xl font-extrabold text-brass font-mono">166.7 mm</span>
            </div>
            <!-- Métrica 2 -->
            <div class="bg-surface2/80 border border-hairline rounded-2xl p-3.5 text-center">
                <span id="c-metric-2-lbl" class="text-[10px] uppercase font-bold text-ink3 block tracking-wide">Total Espacios</span>
                <span id="c-metric-2-val" class="text-xl sm:text-2xl font-extrabold text-ink font-mono">6 vanos</span>
            </div>
            <!-- Métrica 3 -->
            <div class="bg-surface2/80 border border-hairline rounded-2xl p-3.5 text-center">
                <span id="c-metric-3-lbl" class="text-[10px] uppercase font-bold text-ink3 block tracking-wide">Total Madera</span>
                <span id="c-metric-3-val" class="text-xl sm:text-2xl font-extrabold text-ink font-mono">200 mm</span>
            </div>
            <!-- Métrica 4 -->
            <div class="bg-surface2/80 border border-hairline rounded-2xl p-3.5 text-center">
                <span id="c-metric-4-lbl" class="text-[10px] uppercase font-bold text-ink3 block tracking-wide">Paso (Luz + Sw)</span>
                <span id="c-metric-4-val" class="text-xl sm:text-2xl font-extrabold text-ink font-mono">206.7 mm</span>
            </div>
        </div>

        <!-- VISUALIZADOR SVG REACTIVO -->
        <div class="space-y-2">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-ink uppercase tracking-wide flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-brass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                        <polyline points="2 17 12 22 22 17"/>
                        <polyline points="2 12 12 17 22 12"/>
                    </svg>
                    Diagrama Técnico Acotado
                </span>
                <span id="c-svg-badge" class="text-[11px] font-mono text-ink3 bg-surface2 px-2 py-0.5 rounded-md border border-hairline">Escala automática</span>
            </div>
            <div id="centering-svg-wrapper" class="bg-canvas border border-hairline rounded-2xl p-3 sm:p-4 overflow-x-auto shadow-inner flex items-center justify-center min-h-[180px]">
                <div id="centering-svg-container" class="w-full flex items-center justify-center"></div>
            </div>
        </div>

        <!-- LISTA DE MARCAS DE HUINCHA CORRIDA / PERFORACIÓN -->
        <div class="space-y-2 pt-1">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-ink uppercase tracking-wide flex items-center gap-1.5">
                    <svg class="w-4 h-4 text-brass" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                    Marcas de Huincha Corrida (Desde Cero)
                </span>
                <button type="button" onclick="copyCenteringMarks()"
                        class="text-xs font-bold text-brass bg-surface2 hover:bg-brass hover:text-canvas border border-hairline hover:border-brass px-3 py-1.5 rounded-xl transition-all shadow-xs flex items-center gap-1.5 active:scale-95">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                    </svg>
                    <span id="c-btn-copy-text">Copiar Marcas</span>
                </button>
            </div>
            <div id="centering-marks-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2"></div>
        </div>
    </div>
</div>
