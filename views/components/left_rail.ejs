<!-- LEFT RAIL: ICONOS Y ACCESO A DRAWERS / TABS (ANCHO FIJO COMPACTO, SOLO DESKTOP/TABLET >= 768px) -->
<div id="left-rail-panel" class="hidden md:flex w-14 sm:w-16 shrink-0 flex-col items-center py-3 bg-surface border border-hairline rounded-2xl shadow-panel gap-3 sticky top-4 z-20">

    <!-- 1. Botón Acción Rápida: + Nueva Tarea (Abre Modal Directo) -->
    <button type="button" 
            id="rail-btn-add-task" 
            onclick="openAddTaskDrawer()" 
            title="Crear nueva tarea"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-brass hover:bg-brassdim text-canvas font-bold flex items-center justify-center shadow-xs transition-transform active:scale-95 group relative">
        <svg class="w-5 h-5"><use href="#i-plus"/></svg>
        <span class="sr-only">Nueva tarea</span>
        <!-- Tooltip lateral -->
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Nueva tarea
        </span>
    </button>

    <div class="w-8 h-px bg-hairline"></div>

    <!-- 2. Botón Drawer Backlog (Tareas pendientes) -->
    <button type="button" 
            id="rail-btn-backlog" 
            onclick="toggleBacklogDrawerTab('backlog')" 
            title="Abrir/Cerrar Backlog de tareas"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface2 hover:bg-hairline text-ink hover:text-brass flex flex-col items-center justify-center relative transition-all group active:scale-95">
        <svg class="w-5 h-5"><use href="#i-list"/></svg>
        <% if (tasks && tasks.length > 0) { %>
            <span class="absolute -top-1 -right-1 text-[10px] font-mono px-1.5 py-0.2 rounded-full bg-brass text-canvas font-bold border-2 border-surface shrink-0">
                <%= tasks.length %>
            </span>
        <% } %>
        <!-- Tooltip lateral -->
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Backlog (<%= (tasks || []).length %>)
        </span>
    </button>

    <!-- 3. Botón Drawer Proyectos -->
    <button type="button" 
            id="rail-btn-projects" 
            onclick="toggleBacklogDrawerTab('projects')" 
            title="Abrir/Cerrar Proyectos"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface2 hover:bg-hairline text-ink hover:text-brass flex flex-col items-center justify-center relative transition-all group active:scale-95">
        <svg class="w-5 h-5"><use href="#i-box"/></svg>
        <% const projCount = (typeof all_projects !== 'undefined' && all_projects) ? all_projects.length : 0; %>
        <% if (projCount > 0) { %>
            <span class="absolute -top-1 -right-1 text-[10px] font-mono px-1.5 py-0.2 rounded-full bg-surface border border-hairline text-ink2 font-semibold shrink-0">
                <%= projCount %>
            </span>
        <% } %>
        <!-- Tooltip lateral -->
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Proyectos (<%= projCount %>)
        </span>
    </button>

    <!-- 4. Botón Drawer Historial -->
    <button type="button" 
            id="rail-btn-history" 
            onclick="toggleBacklogDrawerTab('history')" 
            title="Abrir/Cerrar Historial de tareas completadas"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface2 hover:bg-hairline text-ink hover:text-brass flex flex-col items-center justify-center relative transition-all group active:scale-95">
        <svg class="w-5 h-5"><use href="#i-history"/></svg>
        <!-- Tooltip lateral -->
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-ink whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Historial (<%= (completed_history || []).length %>)
        </span>
    </button>

    <div class="w-8 h-px bg-hairline"></div>

    <!-- 5. Botón Importar JSON (IA) -->
    <button type="button" 
            id="rail-btn-import" 
            onclick="openImportJsonDrawer()" 
            title="Importar proyecto generado por IA (JSON)"
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-surface2 hover:bg-chalk/20 text-chalk flex flex-col items-center justify-center relative transition-all group active:scale-95">
        <svg class="w-5 h-5"><use href="#i-import"/></svg>
        <!-- Tooltip lateral -->
        <span class="absolute left-full ml-2.5 px-2.5 py-1 bg-surface2 border border-hairline rounded-lg text-xs font-semibold text-chalk whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity shadow-lg z-30">
            Importar JSON (IA)
        </span>
    </button>

</div>
