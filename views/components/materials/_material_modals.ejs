<!-- FORMULARIO NUEVO MATERIAL (OCULTO POR DEFECTO) -->
<div id="add-material-form-card" class="hidden bg-surface border border-brass/40 rounded-2xl p-5 shadow-panel space-y-4">
    <div class="flex items-center justify-between border-b border-hairline pb-3">
        <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
            <svg class="w-4 h-4 text-brass"><use href="#i-plus"/></svg> Agregar Insumo / Material al Taller
        </h3>
        <button type="button" onclick="toggleAddMaterialForm()" class="text-ink3 hover:text-ink">
            <svg class="w-5 h-5"><use href="#i-close"/></svg>
        </button>
    </div>

    <div id="add-material-error" class="hidden p-3 rounded-xl bg-rust/10 border border-rust/30 text-rust text-xs font-semibold"></div>

    <form action="/materials/add" method="post" id="add-material-form" onsubmit="submitAddMaterialForm(event)" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Proyecto Asociado</label>
                <select name="project_id" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                    <% (locals.all_projects || []).forEach(p => { %>
                        <option value="<%= p.id %>" <%= p.is_active ? 'selected' : '' %>><%= p.name %></option>
                    <% }); %>
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Nombre del Material / Insumo</label>
                <input type="text" name="name" required placeholder="Ej. Listones Roble 2x4 3.2m, Bisagras Cazoleta" class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass transition-colors">
            </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Cantidad</label>
                <input type="number" step="0.1" min="0.1" name="quantity" value="1" required class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-mono transition-colors">
            </div>
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Unidad</label>
                <select name="unit" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                    <option value="unidades">unidades</option>
                    <option value="piezas">piezas</option>
                    <option value="mm">mm</option>
                    <option value="mts">mts</option>
                    <option value="m2">m²</option>
                    <option value="kg">kg</option>
                    <option value="litros">litros</option>
                    <option value="kits">kits</option>
                    <option value="pares">pares</option>
                    <option value="cajas">cajas</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Categoría</label>
                <select name="category" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                    <option value="Madera">Madera</option>
                    <option value="Placas/Tableros">Placas / Tableros</option>
                    <option value="Tornillería">Tornillería</option>
                    <option value="Adhesivos/Barniz">Adhesivos / Barniz</option>
                    <option value="Insumos">Insumos</option>
                    <option value="Herrajes">Herrajes</option>
                    <option value="General">General</option>
                </select>
            </div>
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Estado Inicial</label>
                <select name="status" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-semibold cursor-pointer transition-colors">
                    <option value="in_stock" selected class="text-moss">En Taller</option>
                    <option value="to_buy" class="text-rust">Por Comprar</option>
                    <option value="out_of_stock" class="text-amber-500">Agotado</option>
                </select>
            </div>
        </div>

        <div class="flex justify-end gap-2 pt-2">
            <button type="button" onclick="toggleAddMaterialForm()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink bg-surface2 hover:bg-hairline border border-hairline rounded-xl transition-colors">Cancelar</button>
            <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Guardar Insumo</button>
        </div>
    </form>
</div>

<!-- MODAL: EDITAR MATERIAL -->
<div id="edit-material-modal" class="fixed inset-0 bg-canvas/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-surface border border-hairline rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-lg font-bold text-ink flex items-center gap-2">
                <svg class="w-5 h-5 text-brass"><use href="#i-edit"/></svg>
                Editar Insumo / Material
            </h3>
            <button type="button" onclick="closeEditMaterialModal()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <form id="edit-material-form" onsubmit="submitEditMaterialForm(event)" class="space-y-4">
            <input type="hidden" id="edit-mat-id">
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Nombre del Material</label>
                <input type="text" id="edit-mat-name" required class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass transition-colors">
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Cantidad</label>
                    <input type="number" step="0.1" min="0.1" id="edit-mat-quantity" required class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-mono transition-colors">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Unidad</label>
                    <select id="edit-mat-unit" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                        <option value="unidades">unidades</option>
                        <option value="piezas">piezas</option>
                        <option value="mm">mm</option>
                        <option value="mts">mts</option>
                        <option value="m2">m²</option>
                        <option value="kg">kg</option>
                        <option value="litros">litros</option>
                        <option value="kits">kits</option>
                        <option value="pares">pares</option>
                        <option value="cajas">cajas</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Categoría</label>
                    <select id="edit-mat-category" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                        <option value="Madera">Madera</option>
                        <option value="Placas/Tableros">Placas / Tableros</option>
                        <option value="Tornillería">Tornillería</option>
                        <option value="Adhesivos/Barniz">Adhesivos / Barniz</option>
                        <option value="Insumos">Insumos</option>
                        <option value="Herrajes">Herrajes</option>
                        <option value="General">General</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Estado</label>
                    <select id="edit-mat-status" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-semibold cursor-pointer transition-colors">
                        <option value="in_stock">En Taller</option>
                        <option value="to_buy">Por Comprar</option>
                        <option value="out_of_stock">Agotado</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Proyecto Asociado</label>
                <select id="edit-mat-project" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                    <% (locals.all_projects || []).forEach(p => { %>
                        <option value="<%= p.id %>"><%= p.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-hairline">
                <button type="button" onclick="closeEditMaterialModal()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink bg-surface2 hover:bg-hairline border border-hairline rounded-xl transition-colors">Cancelar</button>
                <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL IMPORTAR MATERIALES JSON -->
<div id="import-materials-modal" class="fixed inset-0 bg-canvas/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-surface border border-hairline rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-lg font-bold text-ink flex items-center gap-2">
                <svg class="w-5 h-5 text-chalk"><use href="#i-import"/></svg>
                Importar Lista de Materiales (JSON)
            </h3>
            <button type="button" onclick="closeImportMaterialsModal()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <p class="text-xs text-ink2">Pega la estructura JSON con tus materiales o selecciona un proyecto para vincular los insumos.</p>

        <form action="/materials/import" method="post" id="import-materials-form" class="space-y-4">
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Proyecto Destino</label>
                <select name="project_id" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-brass cursor-pointer transition-colors">
                    <% (locals.all_projects || []).forEach(p => { %>
                        <option value="<%= p.id %>" <%= p.is_active ? 'selected' : '' %>><%= p.name %></option>
                    <% }); %>
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Contenido JSON</label>
                <textarea name="json_data" rows="8" placeholder='[
  { "name": "Resina Epoxi Kit 1kg", "quantity": 2, "unit": "kits", "category": "Adhesivos/Barniz", "status": "to_buy" },
  { "name": "Listón Pino 2x2", "quantity": 10, "unit": "piezas", "category": "Madera", "status": "in_stock" }
]' class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 font-mono text-xs text-ink rounded-lg p-3 focus:outline-none focus:border-brass leading-relaxed transition-colors"></textarea>
            </div>

            <div class="flex items-center justify-between pt-2">
                <button type="button" onclick="loadExampleMaterialsJson()" class="text-xs text-brass hover:underline font-medium">Cargar Ejemplo</button>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="closeImportMaterialsModal()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink bg-surface2 hover:bg-hairline border border-hairline rounded-xl transition-colors">Cancelar</button>
                    <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Importar Insumos</button>
                </div>
            </div>
        </form>
    </div>
</div>
