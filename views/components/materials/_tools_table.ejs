<% const tableTools = locals.tools || []; %>
<!-- VISTA 2: LISTA DE HERRAMIENTAS -->
<div id="tools-subpanel" class="space-y-3 hidden">
    <% if (tableTools.length === 0) { %>
        <div class="bg-surface border border-dashed border-hairline rounded-2xl p-8 text-center">
            <div class="w-12 h-12 rounded-full bg-surface2 border border-hairline flex items-center justify-center text-brass mx-auto mb-3">
                <svg class="w-6 h-6"><use href="#i-terminal"/></svg>
            </div>
            <h3 class="font-display text-base font-semibold text-ink">No hay herramientas registradas</h3>
            <p class="text-xs text-ink3 mt-1 max-w-md mx-auto">Registra tus sierras, formones, prensas y herramientas para un control seguro de taller.</p>
            <div class="flex items-center justify-center gap-3 mt-4">
                <button type="button" onclick="toggleAddToolForm()" class="bg-brass text-canvas px-4 py-2 rounded-xl text-xs font-bold">Registrar Herramienta</button>
            </div>
        </div>
    <% } else { %>
        <div class="overflow-x-auto border border-hairline rounded-2xl bg-surface shadow-panel">
            <table class="w-full text-left text-xs text-ink divide-y divide-hairline min-w-[580px]">
                <thead class="bg-surface2/60 text-ink3 uppercase text-[10px] tracking-wider font-semibold">
                    <tr>
                        <th scope="col" class="py-3 px-4 w-1/2 sm:w-5/12">Herramienta & Notas</th>
                        <th scope="col" class="py-3 px-3 w-1/4 sm:w-2/12">Categoría</th>
                        <th scope="col" class="py-3 px-3 w-1/4 sm:w-3/12">Estado</th>
                        <th scope="col" class="py-3 px-4 text-right w-16 sm:w-2/12">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-hairline/60">
                    <% tableTools.forEach(tool => { %>
                        <tr class="inventory-card tool-card hover:bg-surface2/40 transition-colors"
                            data-type="tool"
                            data-status="<%= tool.status %>"
                            data-category="<%= (tool.category || '').toLowerCase() %>"
                            data-name="<%= (tool.name || '').toLowerCase() %>"
                            data-notes="<%= (tool.notes || '').toLowerCase() %>">
                            <td class="py-2.5 px-4 min-w-0">
                                <div class="font-semibold text-sm text-ink truncate max-w-[280px] sm:max-w-md" title="<%= tool.name %>">
                                    <%= tool.name %>
                                </div>
                                <% if (tool.notes) { %>
                                    <div class="text-[11px] text-ink3 mt-0.5 truncate max-w-[280px] sm:max-w-md flex items-center gap-1" title="<%= tool.notes %>">
                                        <svg class="w-3 h-3 text-ink3 shrink-0"><use href="#i-pin"/></svg>
                                        <span class="truncate"><%= tool.notes %></span>
                                    </div>
                                <% } %>
                            </td>
                            <td class="py-2.5 px-3 whitespace-nowrap">
                                <span class="inline-block bg-surface2 text-brass border border-brass/20 px-2 py-0.5 rounded text-[11px] font-medium">
                                    <%= tool.category %>
                                </span>
                            </td>
                            <td class="py-2.5 px-3 whitespace-nowrap">
                                <select onchange="updateToolStatusDirect(<%= tool.id %>, this.value)"
                                        class="status-badge-select text-xs font-bold px-2.5 py-1 rounded-lg border appearance-none pr-6 cursor-pointer focus:outline-none transition-colors hover:brightness-110 <%= tool.status === 'available' ? 'bg-moss/10 border-moss/40 text-moss hover:border-moss hover:bg-moss/20' : tool.status === 'in_use' ? 'bg-amber-500/10 border-amber-500/40 text-amber-500 hover:border-amber-500 hover:bg-amber-500/20' : tool.status === 'to_buy' || tool.status === 'Por Comprar' ? 'bg-rust/10 border-rust/40 text-rust hover:border-rust hover:bg-rust/20' : 'bg-rust/10 border-rust/40 text-rust hover:border-rust hover:bg-rust/20' %>">
                                    <option value="available" <%= tool.status === 'available' ? 'selected' : '' %>>Disponible</option>
                                    <option value="in_use" <%= tool.status === 'in_use' ? 'selected' : '' %>>En Uso</option>
                                    <option value="to_buy" <%= tool.status === 'to_buy' || tool.status === 'Por Comprar' ? 'selected' : '' %>>Por Comprar</option>
                                    <option value="broken" <%= tool.status === 'broken' ? 'selected' : '' %>>Dañada</option>
                                </select>
                            </td>
                            <td class="py-2.5 px-4 text-right whitespace-nowrap">
                                <div class="flex items-center justify-end gap-1">
                                    <button type="button" onclick='openEditToolModal(<%= JSON.stringify(tool) %>)' title="Editar herramienta" class="p-1.5 text-ink3 hover:text-brass rounded-lg hover:bg-surface2 transition-colors">
                                        <svg class="w-3.5 h-3.5"><use href="#i-edit"/></svg>
                                    </button>
                                    <button type="button" onclick="deleteTool(<%= tool.id %>)" title="Eliminar herramienta" class="p-1.5 text-ink3 hover:text-rust rounded-lg hover:bg-surface2 transition-colors">
                                        <svg class="w-3.5 h-3.5"><use href="#i-close"/></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>
