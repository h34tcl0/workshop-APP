<!-- RIGHT COLUMN: WEATHER FORECAST & EVALUATIONS (CENTRAL PANEL) -->
<div class="space-y-5 min-w-0 w-full max-w-full">
    
    <!-- BARRA DE NAVEGACIÓN ENTRE DÍAS DEL PANEL CENTRAL (Horizonte multi-día) -->
    <div class="bg-surface border border-hairline rounded-2xl p-2.5 sm:p-3 flex items-center justify-between gap-2 shadow-panel">
        <button type="button" 
                id="agenda-prev-day-btn" 
                onclick="navigateAgendaDay(-1)" 
                class="px-2.5 sm:px-3 py-1.5 rounded-xl bg-surface2 hover:bg-hairline text-ink2 hover:text-ink text-xs font-semibold flex items-center gap-1 transition-all active:scale-95">
            <svg class="w-4 h-4"><use href="#i-chev-down" class="rotate-90 origin-center"/></svg>
            <span class="hidden sm:inline">Anterior</span>
        </button>

        <div class="flex items-center gap-2 text-center min-w-0">
            <span class="text-xs font-semibold text-ink3 uppercase tracking-wide hidden sm:inline">Horizonte:</span>
            <span id="agenda-current-day-label" class="font-serif-fraunces text-xs sm:text-sm md:text-base font-bold text-ink truncate">
                <%= (forecast_evaluations && forecast_evaluations.length > 0) ? (forecast_evaluations[0].date_str || forecast_evaluations[0].eval_date) : '' %>
            </span>
        </div>

        <button type="button" 
                id="agenda-next-day-btn" 
                onclick="navigateAgendaDay(1)" 
                class="px-2.5 sm:px-3 py-1.5 rounded-xl bg-surface2 hover:bg-hairline text-ink2 hover:text-ink text-xs font-semibold flex items-center gap-1 transition-all active:scale-95">
            <span class="hidden sm:inline">Siguiente</span>
            <svg class="w-4 h-4"><use href="#i-chev-down" class="-rotate-90 origin-center"/></svg>
        </button>
    </div>

    <!-- GRILLA MULTI-DÍA (2 A 3 COLUMNAS EN PARALELO) -->
    <div id="agenda-days-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 sm:gap-5 w-full max-w-full min-w-0">

        <% (forecast_evaluations || []).forEach(function(item, dayIndex) { %>
        <% 
            const eval = item.evaluation || item;
            const is_viable = eval.status === 'DAY_VIABLE';
            const seg = eval.bar_segments;
            const cond = (eval.weather_summary && eval.weather_summary.condition) ? eval.weather_summary.condition : 'sunny';
            const is_manual_block = Boolean(eval.is_manually_blocked);
            const is_closed = (!is_viable) && (eval.reason && eval.reason.includes('Jornada concluida'));
            const is_non_working = (!is_viable) && (!is_closed) && (!is_manual_block) && (
                (eval.reason && (eval.reason.includes('Día no laborable') || eval.reason.includes('no laborable'))) ||
                (eval.unassigned_reason && (eval.unassigned_reason.includes('Día no laborable') || eval.unassigned_reason.includes('no laborable')))
            );
            const is_blocked = (!is_viable) && (!is_closed) && (is_manual_block || (eval.reason && eval.reason.includes('Bloqueado')));
            const is_amber = (!is_viable) && (!is_manual_block) && (!is_closed) && (!is_non_working) && (!is_blocked) && (eval.climate_only_status === 'clear');
            const is_blocked_or_suspended = (!is_viable) && (!is_amber);
            const date_iso = item.date_iso || eval.eval_date;
            const date_str = item.date_str || eval.date_str;
            const override = eval.day_override || item.day_override;
            const current_settings = locals.app_settings || {};
            const start_limit = (override && override.custom_start_hour != null) ? override.custom_start_hour : (current_settings.operational_start_hour != null ? current_settings.operational_start_hour : 8);
            const end_limit = (override && override.custom_end_hour != null) ? override.custom_end_hour : (current_settings.operational_end_hour != null ? current_settings.operational_end_hour : 18);
            const total_shift_hours = Math.max(1, end_limit - start_limit);

            // Efficiency Ring Data (Centralizado en evaluator.ts con fallback defensivo)
            const eff = eval.climate_efficiency || {
                score: 0,
                jornada_good: 0,
                jornada_total: 0,
                jornada_pct: 0,
                fuera_good: 0,
                fuera_total: 0,
                fuera_pct: 0,
                tooltip: 'Índice de Eficiencia Climática',
                ring_color: 'var(--w-ok)',
                stroke_dash: '0.0 163.4'
            };

            const pct = eff.score;
            const ring_color = eff.ring_color;
            const stroke_dash = eff.stroke_dash;
            const ring_tooltip = eff.tooltip;

            // Weather Emoji:
            let ico_emoji = '☀️';
            if (cond === 'rain') ico_emoji = '🌧️';
            else if (cond === 'cloudy') ico_emoji = '☁️';
            else if (cond === 'partly') ico_emoji = '⛅';

            // Card Theme Class:
            let card_theme = 'sunny';
            if (cond === 'rain' || !is_viable) {
                card_theme = is_blocked_or_suspended ? 'blocked' : (cond === 'rain' ? 'rainy' : 'sunny');
            }

            const isInitialActive = (dayIndex < 3);

            let hourly_items = eval.hourly_audit;
            if ((!hourly_items || hourly_items.length === 0) && eval.hourly_forecast && typeof getHourlyClimateAudit === 'function') {
                let rawForecasts = eval.hourly_forecast;
                if (typeof rawForecasts === 'string') {
                    try { rawForecasts = JSON.parse(rawForecasts); } catch (e) { rawForecasts = []; }
                }
                if (Array.isArray(rawForecasts) && rawForecasts.length > 0) {
                    hourly_items = getHourlyClimateAudit(rawForecasts, eval.window, eval.scheduled_tasks || [], current_settings);
                }
            }

            const dayContext = {
                ...locals,
                item,
                dayIndex,
                eval,
                is_viable,
                seg,
                cond,
                is_manual_block,
                is_closed,
                is_amber,
                is_blocked_or_suspended,
                date_iso,
                date_str,
                override,
                app_settings: current_settings,
                start_limit,
                end_limit,
                total_shift_hours,
                eff,
                pct,
                ring_color,
                stroke_dash,
                ring_tooltip,
                ico_emoji,
                card_theme,
                hourly_items,
                tasks: locals.tasks || [],
                all_projects: locals.all_projects || []
            };
        %>

        <article class="weather-card <%= card_theme %> group w-full max-w-full min-w-0 flex flex-col justify-between <%= isInitialActive ? '' : 'hidden' %>" 
                 id="agenda-day-card-<%= date_iso %>" 
                 data-day-index="<%= dayIndex %>"
                 data-date-iso="<%= date_iso %>"
                 data-date-str="<%= date_str %>">

            <div>
                <%- include('agenda/_card_header', dayContext) %>
                <%- include('agenda/_calendar_grid', dayContext) %>
                <%- include('agenda/_forced_tasks', dayContext) %>
                <%- include('agenda/_hourly_modal', dayContext) %>
            </div>

        </article>

        <%- include('agenda/_day_editor_modal', dayContext) %>

        <% }); %>

    </div>
</div>
