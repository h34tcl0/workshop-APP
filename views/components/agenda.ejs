<!-- RIGHT COLUMN: WEATHER FORECAST & EVALUATIONS -->
<div class="space-y-5 min-w-0 w-full max-w-full">
    <div class="flex items-center justify-between">
        <h2 class="font-display text-lg sm:text-xl font-semibold flex items-baseline gap-2 min-w-0">
            <span class="text-[11px] font-mono font-semibold tracking-widest text-brass uppercase">02</span>
            <span class="truncate">Ventana meteorológica</span>
        </h2>
        <span class="text-[11px] font-mono text-ink3 bg-surface border border-hairline px-2.5 py-1 rounded-full shrink-0">7 días</span>
    </div>

    <div class="agenda-days-grid flex flex-col md:grid md:grid-cols-1 xl:grid-cols-2 gap-3 sm:gap-4 w-full max-w-full min-w-0">

        <% forecast_evaluations.forEach(function(item) { %>
        <% 
            const eval = item.evaluation || item;
            const is_viable = eval.status === 'DAY_VIABLE';
            const seg = eval.bar_segments;
            const cond = (eval.weather_summary && eval.weather_summary.condition) ? eval.weather_summary.condition : 'sunny';
            const is_manual_block = Boolean(eval.is_manually_blocked);
            const is_amber = (!is_viable) && (!is_manual_block) && (eval.climate_only_status === 'clear');
            const start_limit = app_settings.operational_start_hour;
            const end_limit = app_settings.operational_end_hour;
            const date_iso = item.date_iso || eval.eval_date;
            const date_str = item.date_str || eval.date_str;
            const override = eval.day_override || item.day_override;
        %>

        <% if (is_viable) { %>
        <!-- ── DÍA VIABLE ── -->
        <div class="agenda-day-card group bg-surface border border-hairline rounded-2xl p-4 sm:p-5 shadow-panel w-full max-w-full min-w-0 shrink">

            <!-- Header del Día -->
            <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-display text-base sm:text-lg font-semibold text-ink flex items-center gap-2 min-w-0">
                    <span class="truncate"><%= date_str %></span>
                    <svg class="w-4 h-4 text-brass shrink-0">
                        <% if (cond === 'rain') { %><use href="#i-cloud-rain"/><% } else if (cond === 'cloudy') { %><use href="#i-cloud"/><% } else if (cond === 'partly') { %><use href="#i-cloud-sun"/><% } else { %><use href="#i-sun"/><% } %>
                    </svg>
                </span>
                <div class="flex items-center gap-1.5 shrink-0">
                    <button type="button" onclick="toggleDayEditor('<%= date_iso %>')" aria-label="Editar día" class="w-9 h-9 sm:w-6 sm:h-6 rounded-md bg-surface2 hover:bg-hairline text-ink3 flex items-center justify-center min-h-[44px] min-w-[44px] sm:min-h-0 sm:min-w-0 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-200">
                        <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3"><use href="#i-edit"/></svg>
                    </button>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-moss/10 text-moss border border-moss/25 whitespace-nowrap">
                        Viable
                    </span>
                </div>
            </div>

            <!-- Rango de Horario y Temps -->
            <p class="text-xs text-ink3 mb-4">
                Jornada <%= start_limit %>:00–<%= end_limit %>:00 ·
                <span class="text-ink2 font-mono"><%= eval.weather_summary.min_temp %>° - <%= eval.weather_summary.max_temp %>°C</span> ·
                <span class="text-ink2 font-mono">💧 <%= eval.weather_summary.min_humidity %>% - <%= eval.weather_summary.max_humidity %>%</span>
                <% if (eval.weather_summary.total_rain_mm && eval.weather_summary.total_rain_mm > 0) { %>
                    · <span class="text-rust font-mono font-semibold">🌧️ <%= eval.weather_summary.total_rain_mm %> mm</span>
                <% } %>
            </p>

            <% if (eval.window) { %>
            <!-- Ventana Óptima -->
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-semibold text-ink2 uppercase tracking-wide">Ventana óptima</span>
                <span class="text-sm font-mono font-semibold text-brass">
                    <%= eval.window.start_time %> — <%= eval.window.end_time %>
                </span>
            </div>

            <!-- REGLA DE JORNADA -->
            <% if (seg) { %>
            <div class="rounded-lg border border-hairline bg-canvas/50 p-2.5 mb-4">
                <div class="tick-row flex items-center justify-between text-[10px] font-mono text-ink3 mb-1.5 px-0.5">
                    <span><%= app_settings.operational_start_hour %>:00</span>
                    <span><%= app_settings.operational_end_hour %>:00</span>
                </div>
                <div class="relative h-8 rounded-md overflow-hidden flex ring-1 ring-hairline">

                    <% if (seg.before_segments) { seg.before_segments.forEach(function(bseg) { %>
                    <% if (bseg.condition === 'rain') { %>
                    <div class="h-full bg-rust/70 border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= bseg.pct %>%;" title="Lluvia <%= Math.floor(bseg.start_h) %>:00–<%= Math.floor(bseg.end_h) %>:00">
                        <span class="text-[8px] sm:text-[9px] font-mono font-semibold text-canvas whitespace-nowrap px-1">LLUVIA</span>
                    </div>
                    <% } else if (bseg.condition === 'humid') { %>
                    <div class="h-full bg-brass/50 border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= bseg.pct %>%;" title="Humedad <%= Math.floor(bseg.start_h) %>:00–<%= Math.floor(bseg.end_h) %>:00">
                        <span class="text-[8px] sm:text-[9px] font-mono font-semibold text-canvas whitespace-nowrap px-1">HUMEDAD</span>
                    </div>
                    <% } else { %>
                    <div class="h-full bg-moss/25 border-r border-canvas" style="width: <%= bseg.pct %>%;" title="Libre <%= Math.floor(bseg.start_h) %>:00–<%= Math.floor(bseg.end_h) %>:00"></div>
                    <% } %>
                    <% }); } %>

                    <div class="h-full bg-brass border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= seg.pct_setup || 10 %>%;" title="Preparación <%= seg.setup_h || 1 %>h">
                        <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1">PREP</span>
                    </div>

                    <div class="h-full bg-moss border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= seg.pct_work || 60 %>%;" title="Trabajo <%= seg.work_h || 2 %>h">
                        <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1"><%= seg.work_h || 2 %>H TRABAJO</span>
                    </div>

                    <div class="h-full bg-chalk border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= seg.pct_teardown || 10 %>%;" title="Cierre <%= seg.teardown_h || 1 %>h">
                        <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1">CIERRE</span>
                    </div>

                    <% if (seg.pct_curing && seg.pct_curing > 0) { %>
                    <div class="h-full border-r border-canvas border-dashed border-2 border-chalk/70 bg-chalk/10 flex items-center justify-center overflow-hidden" style="width: <%= seg.pct_curing %>%;" title="Curado <%= seg.curing_h %>h">
                        <span class="text-[9px] sm:text-[10px] font-mono font-semibold text-chalk whitespace-nowrap px-1">CURADO</span>
                    </div>
                    <% } %>

                    <% if (seg.after_segments) { seg.after_segments.forEach(function(aseg) { %>
                    <% if (aseg.condition === 'rain') { %>
                    <div class="h-full bg-rust/70 border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= aseg.pct %>%;" title="Lluvia <%= Math.floor(aseg.start_h) %>:00–<%= Math.floor(aseg.end_h) %>:00">
                        <span class="text-[8px] sm:text-[9px] font-mono font-semibold text-canvas whitespace-nowrap px-1">LLUVIA</span>
                    </div>
                    <% } else if (aseg.condition === 'humid') { %>
                    <div class="h-full bg-brass/50 border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= aseg.pct %>%;" title="Humedad <%= Math.floor(aseg.start_h) %>:00–<%= Math.floor(aseg.end_h) %>:00">
                        <span class="text-[8px] sm:text-[9px] font-mono font-semibold text-canvas whitespace-nowrap px-1">HUMEDAD</span>
                    </div>
                    <% } else { %>
                    <div class="h-full bg-moss/25 border-r border-canvas" style="width: <%= aseg.pct %>%;" title="Libre <%= Math.floor(aseg.start_h) %>:00–<%= Math.floor(aseg.end_h) %>:00"></div>
                    <% } %>
                    <% }); } %>

                </div>
            </div>
            <% } %>

            <!-- Cronograma Detallado -->
            <% if (eval.timeline && eval.timeline.length > 0) { %>
            <div class="border-t border-hairline pt-3 mb-3">
                <p class="text-[11px] text-ink3 font-semibold uppercase tracking-wider mb-2">Cronograma</p>
                <div class="space-y-1 bg-canvas/40 rounded-lg p-2.5 border border-hairline">
                    <% eval.timeline.forEach(function(act) { %>
                    <div class="flex items-center justify-between text-xs py-1 px-1.5 rounded-md hover:bg-surface2 transition-colors gap-2">
                        <span class="font-mono text-brass font-semibold w-24 shrink-0"><%= act.time_range %></span>
                        <span class="text-ink2 font-medium flex-1 min-w-0 flex items-center gap-1">
                            <% if (act.project_name) { %>
                                <span class="text-brass font-bold text-[10px] bg-brass/10 border border-brass/20 px-1 py-0.5 rounded shrink-0 max-w-[35%] truncate" title="<%= act.project_name %>">[<%= act.project_name %>]</span>
                            <% } %>
                            <span class="truncate" title="<%= act.title %>"><%= act.title %></span>
                        </span>
                        <span class="text-[10px] font-mono font-medium text-ink3 bg-surface2 border border-hairline px-1.5 py-0.5 rounded-full shrink-0"><%= act.duration %></span>
                    </div>
                    <% }); %>
                </div>

                <% if (eval.cutoff_reason) { %>
                <div class="mt-2.5 bg-brass/5 border border-brassdim/30 rounded-lg p-2.5 text-xs text-ink2">
                    <strong class="font-semibold text-brass">Motivo de cierre — </strong><%= eval.cutoff_reason %>
                </div>
                <% } %>
            </div>
            <% } %>

            <!-- Tareas Asignadas -->
            <% if (eval.scheduled_tasks && eval.scheduled_tasks.length > 0) { %>
            <% const panel_id = 'assigned-' + date_iso; %>
            <div class="border-t border-hairline pt-3 mt-3">
                <button type="button" onclick="toggleAssignedTasks('<%= panel_id %>')" class="w-full flex items-center justify-between text-left mb-2 group/btn">
                    <span class="text-[11px] text-ink3 font-semibold uppercase tracking-wider flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-moss shrink-0"><use href="#i-check"/></svg>
                        Tareas agendadas (<%= eval.scheduled_tasks.length %>)
                    </span>
                    <svg class="w-3.5 h-3.5 text-ink3 group-hover/btn:text-ink transition-transform duration-200"><use href="#i-chevron-down-sm"/></svg>
                </button>
                <div id="<%= panel_id %>" class="space-y-2">
                    <% eval.scheduled_tasks.forEach(function(task, idx) { %>
                    <div class="flex items-center justify-between gap-2 bg-canvas/60 border border-hairline rounded-lg px-3 py-2 shadow-sm min-w-0">
                        <div class="flex items-center gap-2 min-w-0 flex-1">
                            <span class="w-5 h-5 rounded-md bg-moss/10 text-moss border border-moss/20 flex items-center justify-center text-[10px] font-mono font-bold shrink-0">
                                #<%= task.order || (idx + 1) %>
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-medium text-ink flex items-center gap-1 min-w-0">
                                    <% if (task.project_name) { %>
                                        <span class="text-brass font-bold text-[11px] bg-brass/10 border border-brass/20 px-1.5 py-0.5 rounded shrink-0 max-w-[40%] truncate" title="<%= task.project_name %>">[<%= task.project_name %>]</span>
                                    <% } %>
                                    <span class="truncate" title="<%= task.title %>"><%= task.title %></span>
                                </p>
                                <% if (task.category && category_labels[task.category]) { %>
                                <p class="text-[10px] text-ink3 capitalize truncate"><%= category_labels[task.category] %></p>
                                <% } %>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 text-[11px] font-mono shrink-0">
                            <span class="px-2 py-0.5 rounded bg-surface2 text-ink2 border border-hairline whitespace-nowrap"><%= task.estimated_hours %>h</span>
                            <% if (task.curing_hours > 0) { %>
                            <span class="px-1.5 py-0.5 rounded bg-chalk/10 text-chalk border border-chalk/20 whitespace-nowrap">+<%= task.curing_hours %>h curado</span>
                            <% } %>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <% if (eval.forced_tasks && eval.forced_tasks.length > 0) { %>
            <div class="border-t border-hairline pt-3 mt-3">
                <p class="text-[11px] text-brass font-semibold uppercase tracking-wider mb-2">⚡ Forzadas (se saltan clima y ventana)</p>
                <div class="space-y-1.5">
                    <% eval.forced_tasks.forEach(function(ft) { %>
                    <div class="flex items-center justify-between gap-2 bg-brass/5 border border-brassdim/30 rounded-md px-3 py-2">
                        <span class="text-xs font-medium text-ink truncate"><%= ft.task.title %></span>
                        <span class="text-[11px] font-mono text-brass shrink-0"><%= String(ft.forced_start_hour).padStart(2, '0') %>:00</span>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <% } %>
        </div>

        <% } else if (is_amber) { %>
        <!-- ── CLIMA BUENO, SIN PLAN (ámbar) ── -->
        <div class="agenda-day-card group bg-surface border border-brassdim/30 rounded-2xl p-4 sm:p-5 shadow-panel w-full max-w-full min-w-0 shrink">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-display text-base sm:text-lg font-semibold text-ink flex items-center gap-2 min-w-0">
                    <span class="truncate"><%= date_str %></span>
                    <svg class="w-4 h-4 text-brass shrink-0">
                        <% if (cond === 'rain') { %><use href="#i-cloud-rain"/><% } else if (cond === 'cloudy') { %><use href="#i-cloud"/><% } else if (cond === 'partly') { %><use href="#i-cloud-sun"/><% } else { %><use href="#i-sun"/><% } %>
                    </svg>
                </span>
                <div class="flex items-center gap-1.5 shrink-0">
                    <button type="button" onclick="toggleDayEditor('<%= date_iso %>')" aria-label="Editar día" class="w-9 h-9 sm:w-6 sm:h-6 rounded-md bg-surface2 hover:bg-hairline text-ink3 flex items-center justify-center min-h-[44px] min-w-[44px] sm:min-h-0 sm:min-w-0 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-200">
                        <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3"><use href="#i-edit"/></svg>
                    </button>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-brass/10 text-brass border border-brassdim/30 whitespace-nowrap">
                        Clima bueno, sin plan
                    </span>
                </div>
            </div>
            <p class="text-xs text-ink3 mb-4">
                Jornada <%= start_limit %>:00–<%= end_limit %>:00 ·
                <span class="text-ink2 font-mono"><%= eval.weather_summary.min_temp %>° - <%= eval.weather_summary.max_temp %>°C</span> ·
                <span class="text-ink2 font-mono">💧 <%= eval.weather_summary.min_humidity %>% - <%= eval.weather_summary.max_humidity %>%</span>
                <% if (eval.weather_summary.total_rain_mm && eval.weather_summary.total_rain_mm > 0) { %>
                    · <span class="text-rust font-mono font-semibold">🌧️ <%= eval.weather_summary.total_rain_mm %> mm</span>
                <% } %>
            </p>

            <% if (eval.climate_segments) { %>
            <div class="rounded-lg border border-hairline bg-canvas/50 p-2.5 mb-3">
                <div class="tick-row flex items-center justify-between text-[10px] font-mono text-ink3 mb-1.5 px-0.5">
                    <span><%= start_limit %>:00</span>
                    <span><%= end_limit %>:00</span>
                </div>
                <div class="relative h-8 rounded-md overflow-hidden flex ring-1 ring-hairline">
                    <% const total_h = Math.max(1, end_limit - start_limit); %>
                    <% eval.climate_segments.forEach(function(cseg) { %>
                    <% const width_pct = ((cseg.end_h - cseg.start_h) / total_h) * 100; %>
                    <% if (cseg.condition === 'rain') { %>
                    <div class="h-full bg-rust border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= width_pct %>%;" title="Lluvia <%= cseg.start_h %>:00–<%= cseg.end_h %>:00">
                        <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1">LLUVIA</span>
                    </div>
                    <% } else if (cseg.condition === 'humid') { %>
                    <div class="h-full bg-brass border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= width_pct %>%;" title="Humedad <%= cseg.start_h %>:00–<%= cseg.end_h %>:00">
                        <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1">HUMEDAD</span>
                    </div>
                    <% } else { %>
                    <div class="h-full bg-moss border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= width_pct %>%;" title="Libre <%= cseg.start_h %>:00–<%= cseg.end_h %>:00">
                        <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1">LIBRE</span>
                    </div>
                    <% } %>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <% if (eval.free_windows && eval.free_windows.length > 0) { %>
            <div class="mt-3">
                <p class="text-[11px] text-ink3 font-semibold uppercase tracking-wider mb-2">Ventanas libres</p>
                <div class="space-y-1.5">
                    <% eval.free_windows.forEach(function(w) { %>
                    <div class="flex items-center justify-between gap-2 bg-canvas/40 border border-hairline rounded-md px-3 py-2">
                        <span class="text-xs font-medium text-ink"><%= w.start_label %> — <%= w.end_label %></span>
                        <span class="text-[11px] font-mono text-moss shrink-0"><%= w.duration_hours %>h libres</span>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <div class="mt-3 bg-brass/5 border border-brassdim/30 rounded-lg p-2.5 text-xs text-ink2">
                <strong class="font-semibold text-brass">Motivo de no agendamiento — </strong><%= eval.unassigned_reason || eval.reason %>
            </div>

            <% if (eval.forced_tasks && eval.forced_tasks.length > 0) { %>
            <div class="mt-3 pt-3 border-t border-hairline">
                <p class="text-[11px] text-brass font-semibold uppercase tracking-wider mb-2">⚡ Forzadas</p>
                <div class="space-y-1.5">
                    <% eval.forced_tasks.forEach(function(ft) { %>
                    <div class="flex items-center justify-between gap-2 bg-brass/5 border border-brassdim/30 rounded-md px-3 py-2">
                        <span class="text-xs font-medium text-ink truncate"><%= ft.task.title %></span>
                        <span class="text-[11px] font-mono text-brass shrink-0"><%= String(ft.forced_start_hour).padStart(2, '0') %>:00</span>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>
        </div>

        <% } else if (is_manual_block) { %>
        <!-- ── BLOQUEADO MANUALMENTE ── -->
        <div class="agenda-day-card group bg-surface border border-hairline rounded-2xl p-4 sm:p-5 shadow-panel w-full max-w-full min-w-0 shrink">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-display text-base sm:text-lg font-semibold text-ink2 flex items-center gap-2 min-w-0">
                    <span class="truncate"><%= date_str %></span>
                </span>
                <div class="flex items-center gap-1.5 shrink-0">
                    <button type="button" onclick="toggleDayEditor('<%= date_iso %>')" aria-label="Editar día" class="w-9 h-9 sm:w-6 sm:h-6 rounded-md bg-surface2 hover:bg-hairline text-ink3 flex items-center justify-center min-h-[44px] min-w-[44px] sm:min-h-0 sm:min-w-0 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-200">
                        <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3"><use href="#i-edit"/></svg>
                    </button>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-surface2 text-ink3 border border-hairline whitespace-nowrap">
                        Bloqueado manualmente
                    </span>
                </div>
            </div>
            <div class="bg-canvas/40 border border-hairline rounded-lg px-3.5 py-2.5 text-xs text-ink2">
                <strong class="font-semibold text-ink2">Motivo — </strong><%= eval.unassigned_reason || eval.reason %>
            </div>

            <% if (eval.forced_tasks && eval.forced_tasks.length > 0) { %>
            <div class="mt-3 pt-3 border-t border-hairline">
                <p class="text-[11px] text-brass font-semibold uppercase tracking-wider mb-2">⚡ Forzadas a pesar del bloqueo</p>
                <div class="space-y-1.5">
                    <% eval.forced_tasks.forEach(function(ft) { %>
                    <div class="flex items-center justify-between gap-2 bg-brass/5 border border-brassdim/30 rounded-md px-3 py-2">
                        <span class="text-xs font-medium text-ink truncate"><%= ft.task.title %></span>
                        <span class="text-[11px] font-mono text-brass shrink-0"><%= String(ft.forced_start_hour).padStart(2, '0') %>:00</span>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>
        </div>

        <% } else { %>
        <!-- ── DÍA SUSPENDIDO ── -->
        <div class="agenda-day-card group bg-surface border border-rust/20 rounded-2xl p-4 sm:p-5 shadow-panel w-full max-w-full min-w-0 shrink">
            <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-display text-base sm:text-lg font-semibold text-ink2 flex items-center gap-2 min-w-0">
                    <span class="truncate"><%= date_str %></span>
                    <svg class="w-4 h-4 text-ink3 shrink-0">
                        <% if (cond === 'rain') { %><use href="#i-cloud-rain"/><% } else if (cond === 'cloudy') { %><use href="#i-cloud"/><% } else if (cond === 'partly') { %><use href="#i-cloud-sun"/><% } else { %><use href="#i-sun"/><% } %>
                    </svg>
                </span>
                <div class="flex items-center gap-1.5 shrink-0">
                    <button type="button" onclick="toggleDayEditor('<%= date_iso %>')" aria-label="Editar día" class="w-9 h-9 sm:w-6 sm:h-6 rounded-md bg-surface2 hover:bg-hairline text-ink3 flex items-center justify-center min-h-[44px] min-w-[44px] sm:min-h-0 sm:min-w-0 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-200">
                        <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3"><use href="#i-edit"/></svg>
                    </button>
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-rust/10 text-rust border border-rust/25 whitespace-nowrap">
                        Suspendido
                    </span>
                </div>
            </div>
            <p class="text-xs text-ink3 mb-3">
                Jornada <%= start_limit %>:00–<%= end_limit %>:00 ·
                <span class="text-ink2 font-mono"><%= eval.weather_summary.min_temp %>° - <%= eval.weather_summary.max_temp %>°C</span> ·
                <span class="text-ink2 font-mono">💧 <%= eval.weather_summary.min_humidity %>% - <%= eval.weather_summary.max_humidity %>%</span>
                <% if (eval.weather_summary.total_rain_mm && eval.weather_summary.total_rain_mm > 0) { %>
                    · <span class="text-rust font-mono font-semibold">🌧️ <%= eval.weather_summary.total_rain_mm %> mm</span>
                <% } %>
            </p>

            <% if (eval.climate_segments) { %>
            <div class="mb-3">
                <div class="rounded-lg border border-hairline bg-canvas/50 p-2.5">
                    <div class="tick-row flex items-center justify-between text-[10px] font-mono text-ink3 mb-1.5 px-0.5">
                        <span><%= start_limit %>:00</span>
                        <span><%= end_limit %>:00</span>
                    </div>
                    <div class="relative h-8 rounded-md overflow-hidden flex ring-1 ring-hairline">
                        <% const total_h = Math.max(1, end_limit - start_limit); %>
                        <% eval.climate_segments.forEach(function(cseg) { %>
                        <% const width_pct = ((cseg.end_h - cseg.start_h) / total_h) * 100; %>
                        <% if (cseg.condition === 'rain') { %>
                        <div class="h-full bg-rust border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= width_pct %>%;" title="Lluvia <%= cseg.start_h %>:00–<%= cseg.end_h %>:00">
                            <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1">LLUVIA</span>
                        </div>
                        <% } else if (cseg.condition === 'humid') { %>
                        <div class="h-full bg-brass border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= width_pct %>%;" title="Humedad <%= cseg.start_h %>:00–<%= cseg.end_h %>:00">
                            <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1">HUMEDAD</span>
                        </div>
                        <% } else { %>
                        <div class="h-full bg-moss border-r border-canvas flex items-center justify-center overflow-hidden" style="width: <%= width_pct %>%;" title="Libre <%= cseg.start_h %>:00–<%= cseg.end_h %>:00">
                            <span class="text-[9px] sm:text-[10px] font-mono font-bold text-canvas whitespace-nowrap px-1">LIBRE</span>
                        </div>
                        <% } %>
                        <% }); %>
                    </div>
                </div>
            </div>
            <% } %>

            <div class="bg-canvas/40 border border-rust/20 rounded-lg px-3.5 py-2.5 text-xs text-ink2">
                <strong class="font-semibold text-rust">Motivo de no agendamiento — </strong><%= eval.unassigned_reason || eval.reason %>
            </div>

            <% if (eval.forced_tasks && eval.forced_tasks.length > 0) { %>
            <div class="mt-3 pt-3 border-t border-hairline">
                <p class="text-[11px] text-brass font-semibold uppercase tracking-wider mb-2">⚡ Forzadas a pesar del bloqueo</p>
                <div class="space-y-1.5">
                    <% eval.forced_tasks.forEach(function(ft) { %>
                    <div class="flex items-center justify-between gap-2 bg-brass/5 border border-brassdim/30 rounded-md px-3 py-2">
                        <span class="text-xs font-medium text-ink truncate"><%= ft.task.title %></span>
                        <span class="text-[11px] font-mono text-brass shrink-0"><%= String(ft.forced_start_hour).padStart(2, '0') %>:00</span>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>
        </div>
        <% } %>

        <!-- MODAL EDITOR DE DÍA -->
        <div id="day-editor-<%= date_iso %>" class="fixed inset-0 z-[120] bg-canvas/85 backdrop-blur-sm hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
            <div class="bg-surface border-t sm:border border-hairline rounded-t-2xl sm:rounded-xl w-full max-w-lg max-h-[85vh] sm:max-h-[90vh] overflow-y-auto p-5 sm:p-6 shadow-panel relative">
                <div class="w-12 h-1 bg-hairline rounded-full mx-auto mb-3 sm:hidden"></div>
                <div class="flex items-center justify-between border-b border-hairline pb-4 mb-5">
                    <h3 class="font-display text-lg font-semibold text-ink">Editar <%= date_str %></h3>
                    <button type="button" onclick="toggleDayEditor('<%= date_iso %>')" aria-label="Cerrar" class="text-ink3 hover:text-ink w-11 h-11 sm:w-8 sm:h-8 flex items-center justify-center rounded-md bg-surface2 min-h-[44px] min-w-[44px] sm:min-h-0 sm:min-w-0">
                        <svg class="w-4 h-4"><use href="#i-close"/></svg>
                    </button>
                </div>

                <form action="/day-override/<%= date_iso %>/save" method="post" class="space-y-4">
                    <div>
                        <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Estado del día</label>
                        <select name="force_status" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none min-h-[44px] sm:min-h-0">
                            <option value="" <%= (!override || !override.force_status) ? 'selected' : '' %>>Automático (según clima)</option>
                            <option value="VIABLE" <%= (override && override.force_status === 'VIABLE') ? 'selected' : '' %>>Forzar viable</option>
                            <option value="BLOCKED" <%= (override && override.force_status === 'BLOCKED') ? 'selected' : '' %>>Forzar bloqueado</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Motivo (opcional, se muestra si está bloqueado)</label>
                        <input type="text" name="note" value="<%= (override && override.note) ? override.note : '' %>" placeholder="Ej. Viaje, evento familiar..." class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Inicio jornada (este día)</label>
                            <input type="number" min="0" max="23" name="custom_start_hour" value="<%= (override && override.custom_start_hour != null) ? override.custom_start_hour : '' %>" placeholder="<%= app_settings.operational_start_hour %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                        </div>
                        <div>
                            <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Fin jornada (este día)</label>
                            <input type="number" min="0" max="23" name="custom_end_hour" value="<%= (override && override.custom_end_hour != null) ? override.custom_end_hour : '' %>" placeholder="<%= app_settings.operational_end_hour %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                        </div>
                    </div>
                    <p class="text-[11px] text-ink3 -mt-2">Vacío = usa la jornada general configurada.</p>

                    <% if (eval.scheduled_tasks && eval.scheduled_tasks.length > 0) { %>
                    <div>
                        <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Tareas agendadas este día</label>
                        <div class="space-y-2 bg-canvas/40 border border-hairline rounded-lg p-3">
                            <% eval.scheduled_tasks.forEach(function(t) { %>
                            <label class="flex items-center gap-2.5 cursor-pointer min-h-[44px] sm:min-h-0 py-1">
                                <input type="checkbox" name="removed_task_ids" value="<%= t.id %>" class="w-5 h-5 sm:w-4 sm:h-4 rounded border-hairline bg-surface2 text-rust focus:ring-rust">
                                <span class="text-xs text-ink2">Quitar <strong class="text-ink font-medium"><%= t.title %></strong> de este día</span>
                            </label>
                            <% }); %>
                        </div>
                    </div>
                    <% } %>

                    <div class="flex items-center gap-3 pt-3 border-t border-hairline">
                        <button type="submit" class="flex-1 bg-brass hover:bg-brassdim text-canvas font-semibold py-3 sm:py-2.5 rounded-lg text-sm transition-colors min-h-[44px] sm:min-h-0">Guardar</button>
                    </div>
                </form>

                <% if (override && override.id) { %>
                <form action="/day-override/<%= date_iso %>/clear" method="post" class="mt-2">
                    <button type="submit" class="w-full text-center text-xs text-ink3 hover:text-rust py-2.5 min-h-[44px] sm:min-h-0 flex items-center justify-center">Quitar todos los ajustes manuales de este día</button>
                </form>
                <% } %>

                <div class="pt-4 mt-4 border-t border-hairline">
                    <label class="block text-[11px] font-semibold text-ink3 mb-2 uppercase tracking-wide">Tareas forzadas (se saltan clima y ventana)</label>

                    <% if (eval.forced_tasks && eval.forced_tasks.length > 0) { %>
                    <div class="space-y-2 mb-3">
                        <% eval.forced_tasks.forEach(function(ft) { %>
                        <div class="flex items-center justify-between gap-2 bg-brass/5 border border-brassdim/30 rounded-lg px-3 py-2">
                            <span class="text-xs text-ink2">⚡ <strong class="text-ink font-medium"><%= ft.task.title %></strong> a las <%= String(ft.forced_start_hour).padStart(2, '0') %>:00</span>
                            <form action="/day-override/forced-task/<%= ft.id || ft.forced_id %>/delete" method="post">
                                <button type="submit" aria-label="Quitar forzada" class="w-9 h-9 sm:w-6 sm:h-6 rounded-md text-rust hover:bg-rust/10 flex items-center justify-center min-h-[44px] min-w-[44px] sm:min-h-0 sm:min-w-0"><svg class="w-3.5 h-3.5"><use href="#i-close"/></svg></button>
                            </form>
                        </div>
                        <% }); %>
                    </div>
                    <% } %>

                    <form action="/day-override/<%= date_iso %>/force-task" method="post" class="flex flex-col sm:flex-row sm:items-end gap-2">
                        <div class="flex-1 min-w-0">
                            <label class="block text-[10px] text-ink3 mb-1">Tarea</label>
                            <select name="task_id" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-2 py-2 text-xs focus:outline-none min-h-[44px] sm:min-h-0">
                                <% tasks.forEach(function(t) { %>
                                <option value="<%= t.id %>"><%= t.title %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div class="w-full sm:w-20 shrink-0">
                            <label class="block text-[10px] text-ink3 mb-1">Hora</label>
                            <input type="number" name="forced_start_hour" min="0" max="23" value="9" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-2 py-2 text-xs focus:outline-none min-h-[44px] sm:min-h-0">
                        </div>
                        <button type="submit" class="bg-chalk hover:bg-chalk/80 text-canvas font-semibold px-4 py-2.5 rounded-lg text-xs transition-colors shrink-0 min-h-[44px] sm:min-h-0 flex items-center justify-center">Forzar</button>
                    </form>
                </div>
            </div>
        </div>

        <% }); %>

    </div>
</div>
