<!-- MODALES GLOBALES DE PRIMER NIVEL (TASK CREATION & JSON IMPORT) -->

<script type="application/json" id="task-history-data">
    <%- JSON.stringify(task_history || []).replace(/</g, '\\u003c') %>
</script>

<!-- 1. MODAL: NUEVA TAREA DE TALLER (Z-INDEX 200 - TOP LEVEL) -->
<div id="add-task-drawer" 
     onclick="if (event.target === this) closeAddTaskDrawer()" 
     class="fixed inset-0 z-[200] bg-canvas/80 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
    <div class="bg-surface border border-hairline rounded-2xl w-full max-w-lg shadow-2xl p-5 sm:p-6 my-auto relative z-[201] animate-slideUp space-y-4">
        
        <!-- Header del Modal -->
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-serif-fraunces text-base sm:text-lg font-bold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-brass"><use href="#i-plus"/></svg>
                Nueva Tarea de Taller
            </h3>
            <button type="button" 
                    onclick="closeAddTaskDrawer()" 
                    aria-label="Cerrar modal" 
                    class="text-ink3 hover:text-ink w-8 h-8 flex items-center justify-center rounded-lg bg-surface2 hover:bg-hairline transition-colors">
                <svg class="w-4 h-4"><use href="#i-close"/></svg>
            </button>
        </div>

        <!-- Formulario de Creación -->
        <form id="add-task-form" action="/tasks/add" method="post" onsubmit="submitAddTaskForm(event)" class="space-y-4">
            
            <!-- Selector de Proyecto -->
            <div>
                <label for="task-project-select" class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">
                    Proyecto Asignado
                </label>
                <select name="project_id" 
                        id="task-project-select" 
                        onchange="handleProjectSelectChange(this)" 
                        class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                    <% (locals.all_projects || []).forEach(function(p) { %>
                        <option value="<%= p.id %>" <%= p.id === (locals.project ? locals.project.id : 0) ? 'selected' : '' %>><%= p.name %></option>
                    <% }); %>
                    <option value="__new__" class="font-bold text-brass">➕ [ Agregar nuevo proyecto... ]</option>
                </select>
                
                <!-- Creación rápida de proyecto inline -->
                <div id="inline-new-project-container" class="hidden mt-2.5 p-3 bg-surface2 border border-brass/50 rounded-xl space-y-2.5">
                    <p class="text-xs font-semibold text-brass flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5"><use href="#i-plus"/></svg> Crear Nuevo Proyecto
                    </p>
                    <div class="flex gap-2">
                        <input type="text" 
                               id="inline-project-name-input" 
                               placeholder="Nombre del proyecto..." 
                               class="flex-1 bg-surface border border-hairline text-ink text-xs rounded-lg px-3 py-2 focus:outline-none focus:border-brass">
                        <button type="button" 
                                onclick="createInlineProject()" 
                                class="bg-brass hover:bg-brassdim text-canvas font-semibold text-xs px-3.5 py-2 rounded-lg transition-colors shrink-0 shadow-xs">
                            Crear
                        </button>
                        <button type="button" 
                                onclick="cancelInlineProject()" 
                                class="bg-surface hover:bg-hairline border border-hairline text-ink2 text-xs px-3 py-2 rounded-lg transition-colors shrink-0">
                            Cancelar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Título de la Tarea con Autocompletado -->
            <div class="relative">
                <label for="manual-title" class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">
                    Título de la tarea
                </label>
                <input type="text" 
                       id="manual-title" 
                       name="title" 
                       required 
                       placeholder="Ej. Lijado y ensamble de cubiertas" 
                       autocomplete="off" 
                       list="task-history-datalist" 
                       class="w-full bg-surface2 border border-hairline text-ink rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:border-brass transition-colors">
                
                <datalist id="task-history-datalist">
                    <% (task_history || []).forEach(function(item) { %>
                        <option value="<%= item.title %>"></option>
                    <% }); %>
                </datalist>
                <div id="autocomplete-dropdown" class="hidden absolute left-0 right-0 top-full mt-1 bg-surface border border-hairline rounded-xl shadow-2xl z-50 overflow-hidden divide-y divide-hairline/50 max-h-56 overflow-y-auto"></div>
            </div>

            <!-- Parámetros de Trabajo y Curado (3 Columnas) -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label for="manual-category" class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">
                        Categoría
                    </label>
                    <select id="manual-category" 
                            name="category" 
                            required 
                            class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                        <option value="carpentry" selected>Carpintería</option>
                        <option value="pva_glue">Encolado PVA</option>
                        <option value="varnish_paint">Barnizado / Pintura</option>
                        <option value="epoxy">Epoxi / Resina</option>
                    </select>
                </div>
                <div>
                    <label for="manual-estimated-hours" class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">
                        Horas activas
                    </label>
                    <input type="number" 
                           step="0.5" 
                           id="manual-estimated-hours" 
                           name="estimated_hours" 
                           value="1.5" 
                           min="0.5" 
                           class="w-full bg-surface2 border border-hairline text-ink rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-brass transition-colors">
                </div>
                <div>
                    <label for="manual-curing-hours" class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">
                        Horas curado
                    </label>
                    <input type="number" 
                           step="0.5" 
                           id="manual-curing-hours" 
                           name="curing_hours" 
                           value="0.0" 
                           min="0.0" 
                           class="w-full bg-surface2 border border-hairline text-ink rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-brass transition-colors">
                </div>
            </div>

            <!-- Checkbox de Curado Bloqueante -->
            <div class="p-2.5 bg-surface2/60 border border-hairline/60 rounded-xl flex items-start gap-2.5">
                <input type="checkbox" 
                       id="manual-curing-is-blocking" 
                       name="curing_is_blocking" 
                       value="true" 
                       checked 
                       class="mt-0.5 w-4 h-4 text-brass rounded border-hairline focus:ring-brass bg-surface2 cursor-pointer">
                <label for="manual-curing-is-blocking" class="text-xs text-ink2 select-none cursor-pointer leading-relaxed">
                    <strong>Curado vinculante / bloqueante:</strong> si está marcado, no se agendarán tareas posteriores hasta que concluya el tiempo de secado de esta pieza.
                </label>
            </div>

            <!-- Botones de Acción -->
            <div class="flex items-center gap-2.5 pt-2 border-t border-hairline">
                <button type="button" 
                        onclick="closeAddTaskDrawer()" 
                        class="flex-1 bg-surface2 hover:bg-hairline text-ink2 font-semibold py-2.5 rounded-xl text-xs transition-colors min-h-[44px]">
                    Cancelar
                </button>
                <button type="submit" 
                        id="btn-submit-create-task"
                        class="flex-1 flex items-center justify-center gap-2 bg-brass hover:bg-brassdim text-canvas font-bold py-2.5 rounded-xl text-xs transition-all shadow-sm active:scale-[0.99] min-h-[44px]">
                    <svg class="w-4 h-4"><use href="#i-plus"/></svg> 
                    Crear tarea
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 2. MODAL: IMPORTAR PROYECTO DESDE IA (JSON) -->
<div id="import-json-drawer" 
     onclick="if (event.target === this) closeImportJsonDrawer()" 
     class="fixed inset-0 z-[200] bg-canvas/80 backdrop-blur-sm hidden flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
    <div class="bg-surface border border-hairline rounded-2xl w-full max-w-lg shadow-2xl p-5 sm:p-6 my-auto relative z-[201] animate-slideUp space-y-4">
        
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-serif-fraunces text-base sm:text-lg font-bold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-chalk"><use href="#i-import"/></svg>
                Importar Proyecto desde IA
            </h3>
            <button type="button" 
                    onclick="closeImportJsonDrawer()" 
                    aria-label="Cerrar modal" 
                    class="text-ink3 hover:text-ink w-8 h-8 flex items-center justify-center rounded-lg bg-surface2 hover:bg-hairline transition-colors">
                <svg class="w-4 h-4"><use href="#i-close"/></svg>
            </button>
        </div>

        <div class="space-y-4">
            <div class="flex items-center justify-between gap-3 flex-wrap">
                <p class="text-xs text-ink3">Pega el JSON estructurado de tareas:</p>
                <button type="button" 
                        onclick="copyAiPrompt()" 
                        class="text-xs font-semibold text-brass border border-brassdim/50 bg-brass/5 hover:bg-brass/10 px-2.5 py-1.5 rounded-lg transition-colors flex items-center gap-1 shadow-xs">
                    <svg class="w-3.5 h-3.5"><use href="#i-copy"/></svg> Copiar prompt IA
                </button>
            </div>
            
            <textarea id="json-import-input" 
                      rows="8" 
                      placeholder='{"project_name": "Mesa de Roble", "tasks": [{"title": "Lijado y Ensamble", "category": "carpentry", "estimated_hours": 2.5, "curing_hours": 0.0}] }' 
                      class="w-full bg-surface2 border border-hairline text-ink rounded-xl px-4 py-3 text-xs font-mono resize-none focus:outline-none focus:border-chalk transition-colors"></textarea>
            
            <div class="flex items-center gap-2.5 pt-1 border-t border-hairline">
                <button type="button" 
                        onclick="closeImportJsonDrawer()" 
                        class="flex-1 bg-surface2 hover:bg-hairline text-ink2 font-semibold py-2.5 rounded-xl text-xs transition-colors min-h-[44px]">
                    Cancelar
                </button>
                <button type="button" 
                        onclick="importJsonTasks()" 
                        class="flex-1 flex items-center justify-center gap-2 bg-chalk hover:bg-chalk/80 text-canvas font-bold py-2.5 rounded-xl text-xs transition-colors shadow-sm min-h-[44px]">
                    <svg class="w-4 h-4"><use href="#i-import"/></svg> Importar proyecto
                </button>
            </div>
        </div>
    </div>
</div>
