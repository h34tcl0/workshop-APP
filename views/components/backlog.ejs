<!-- LEFT COLUMN: BACKLOG -->
<div class="space-y-5 min-w-0">
    <div class="flex items-center justify-between">
        <h2 class="font-display text-lg sm:text-xl font-semibold flex items-baseline gap-2">
            <span class="text-[11px] font-mono font-semibold tracking-widest text-brass uppercase">01</span>
            Backlog de tareas
        </h2>
        <span class="text-[11px] font-mono text-ink3 bg-surface border border-hairline px-2.5 py-1 rounded-full">
            <%= tasks.length %> tarea<%= tasks.length !== 1 ? 's' : '' %>
        </span>
    </div>

    <div class="pill-switch relative bg-surface border border-hairline rounded-full p-1 flex min-h-[44px]">
        <div id="pill-indicator" class="pill-indicator"></div>
        <button type="button" onclick="switchTab('manual')" id="tab-btn-manual" class="relative z-10 flex-1 py-2.5 rounded-full text-sm font-semibold text-center text-canvas min-h-[44px] flex items-center justify-center">Modo manual</button>
        <button type="button" onclick="switchTab('json')" id="tab-btn-json" class="relative z-10 flex-1 py-2.5 rounded-full text-sm font-semibold text-center text-ink2 min-h-[44px] flex items-center justify-center">Importar JSON (IA)</button>
    </div>

    <!-- TAB MANUAL -->
    <script type="application/json" id="task-history-data">
        <%- JSON.stringify(task_history || []) %>
    </script>
    <div id="tab-manual" class="tab-content">
        <form action="/tasks/add" method="post" class="bg-surface border border-hairline rounded-2xl p-5 sm:p-6 space-y-4 shadow-panel">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="sm:col-span-2">
                    <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Proyecto Asignado</label>
                    <select name="project_id" id="task-project-select" onchange="handleProjectSelectChange(this)" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0 cursor-pointer">
                        <% (locals.all_projects || []).forEach(function(p) { %>
                            <option value="<%= p.id %>" <%= p.id === (locals.project ? locals.project.id : 0) ? 'selected' : '' %>><%= p.name %></option>
                        <% }); %>
                        <option value="__new__" class="font-bold text-brass">➕ [ Agregar nuevo proyecto... ]</option>
                    </select>
                    <div id="inline-new-project-container" class="hidden mt-2 p-2.5 bg-surface2 border border-brass/50 rounded-xl space-y-2">
                        <p class="text-[11px] font-semibold text-brass flex items-center gap-1">
                            <svg class="w-3.5 h-3.5"><use href="#i-plus"/></svg> Crear Nuevo Proyecto
                        </p>
                        <div class="flex gap-2">
                            <input type="text" id="inline-project-name-input" placeholder="Nombre del proyecto..." class="flex-1 bg-surface border border-hairline text-ink text-xs rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-brass">
                            <button type="button" onclick="createInlineProject()" class="bg-brass hover:bg-brassdim text-canvas font-semibold text-xs px-3 py-1.5 rounded-lg transition-colors shrink-0">Crear</button>
                            <button type="button" onclick="cancelInlineProject()" class="bg-surface border border-hairline text-ink2 text-xs px-2.5 py-1.5 rounded-lg transition-colors shrink-0">Cancelar</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="relative">
                <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Título de la tarea</label>
                <input type="text" id="manual-title" name="title" required placeholder="Ej. Lijado de cubiertas" autocomplete="off" list="task-history-datalist" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                <datalist id="task-history-datalist">
                    <% (task_history || []).forEach(function(item) { %>
                        <option value="<%= item.title %>"></option>
                    <% }); %>
                </datalist>
                <div id="autocomplete-dropdown" class="hidden absolute left-0 right-0 top-full mt-1 bg-surface border border-hairline rounded-xl shadow-2xl z-50 overflow-hidden divide-y divide-hairline/50 max-h-56 overflow-y-auto"></div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Categoría</label>
                    <select id="manual-category" name="category" required class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0 cursor-pointer">
                        <option value="carpentry" selected>Carpintería</option>
                        <option value="pva_glue">Encolado PVA</option>
                        <option value="varnish_paint">Barnizado / Pintura</option>
                        <option value="epoxy">Epoxi / Resina</option>
                    </select>
                    <p class="text-[10px] text-ink3 mt-1 sm:hidden">Selecciona la categoría y pulsa "Agregar tarea" abajo.</p>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Horas activas</label>
                    <input type="number" step="0.5" id="manual-estimated-hours" name="estimated_hours" value="1.5" min="0.5" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 mb-1.5 uppercase tracking-wide">Horas curado</label>
                    <input type="number" step="0.5" id="manual-curing-hours" name="curing_hours" value="0.0" min="0.0" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                </div>
            </div>
            <button type="submit" class="w-full flex items-center justify-center gap-2 bg-brass hover:bg-brassdim text-canvas font-semibold py-3 rounded-lg text-sm transition-colors min-h-[44px]">
                <svg class="w-4 h-4"><use href="#i-plus"/></svg> Agregar tarea
            </button>
        </form>
    </div>

    <!-- TAB JSON -->
    <div id="tab-json" class="tab-content hidden">
        <div class="bg-surface border border-hairline rounded-2xl p-5 sm:p-6 space-y-4 shadow-panel">
            <div class="flex items-center justify-between gap-3 flex-wrap">
                <p class="text-xs text-ink3">Pega el JSON generado por IA:</p>
                <button type="button" onclick="copyAiPrompt()" class="text-xs font-semibold text-brass border border-brassdim/50 bg-brass/5 hover:bg-brass/10 px-3 py-2 rounded-md transition-colors whitespace-nowrap min-h-[44px] sm:min-h-0 flex items-center">Copiar prompt IA</button>
            </div>
            <textarea id="json-import-input" rows="7" placeholder='{"project_name": "...", "tasks": [...] }' class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-4 py-3 text-sm font-mono resize-none focus:outline-none focus:border-chalk"></textarea>
            <button type="button" onclick="importJsonTasks()" class="w-full flex items-center justify-center gap-2 bg-chalk hover:bg-chalk/80 text-canvas font-semibold py-3 rounded-lg text-sm transition-colors min-h-[44px]">
                <svg class="w-4 h-4"><use href="#i-import"/></svg> Importar proyecto
            </button>
        </div>
    </div>

    <!-- TASK LIST -->
    <div id="backlog-task-list" class="space-y-2.5">
        <% tasks.forEach(function(task, index) { %>
        <div class="task-card group bg-surface border border-hairline rounded-xl overflow-hidden cursor-grab active:cursor-grabbing" data-task-id="<%= task.id %>" data-id="<%= task.id %>">
            <div class="p-3.5 flex items-stretch gap-3">
                <div class="flex flex-col gap-1 justify-center">
                    <form action="/tasks/<%= task.id %>/move-up" method="post"><button type="submit" aria-label="Subir" class="w-8 h-8 rounded-md bg-surface2 hover:bg-hairline text-ink3 flex items-center justify-center min-h-[36px] min-w-[36px]"><svg class="w-3.5 h-3.5"><use href="#i-chev-up"/></svg></button></form>
                    <form action="/tasks/<%= task.id %>/move-down" method="post"><button type="submit" aria-label="Bajar" class="w-8 h-8 rounded-md bg-surface2 hover:bg-hairline text-ink3 flex items-center justify-center min-h-[36px] min-w-[36px]"><svg class="w-3.5 h-3.5"><use href="#i-chev-down"/></svg></button></form>
                </div>
                <div class="flex-1 min-w-0 flex flex-col justify-center">
                    <div class="flex items-center gap-2 mb-1.5 flex-wrap">
                        <span class="text-[10px] font-mono font-semibold text-brass shrink-0">#<%= index + 1 %></span>
                        <h4 class="text-sm font-medium text-ink truncate"><%= task.title %></h4>
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="font-mono text-ink2"><%= task.estimated_hours %>h <span class="text-ink3">activo</span></span>
                        <% if (task.curing_hours > 0) { %><span class="font-mono text-chalk"><%= task.curing_hours %>h <span class="text-ink3">curado</span></span><% } %>
                    </div>
                </div>
                <div class="flex flex-col gap-1 justify-center opacity-100 sm:opacity-0 sm:group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-200">
                    <button type="button" onclick="toggleEditTask(<%= task.id %>)" aria-label="Editar tiempos" class="w-9 h-9 sm:w-8 sm:h-8 rounded-md bg-chalk/10 hover:bg-chalk/20 text-chalk flex items-center justify-center transition-colors min-h-[36px] min-w-[36px] sm:min-h-0 sm:min-w-0"><svg class="w-3.5 h-3.5"><use href="#i-edit"/></svg></button>
                    <form action="/tasks/<%= task.id %>/delete" method="post">
                        <button type="submit" aria-label="Eliminar" class="w-9 h-9 sm:w-8 sm:h-8 rounded-md bg-rust/10 hover:bg-rust/20 text-rust flex items-center justify-center transition-colors min-h-[36px] min-w-[36px] sm:min-h-0 sm:min-w-0"><svg class="w-4 h-4"><use href="#i-close"/></svg></button>
                    </form>
                </div>
            </div>

            <!-- Panel inline de edición de tiempos -->
            <div id="edit-task-<%= task.id %>" class="hidden border-t border-hairline bg-canvas/40 p-3.5">
                <form action="/tasks/<%= task.id %>/update" method="post" class="space-y-3">
                    <div>
                        <label class="block text-[10px] font-semibold text-ink3 mb-1 uppercase tracking-wide">Título</label>
                        <input type="text" name="title" value="<%= task.title %>" required class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-chalk min-h-[44px] sm:min-h-0">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <div>
                            <label class="block text-[10px] font-semibold text-ink3 mb-1 uppercase tracking-wide">Categoría</label>
                            <select name="category" required class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-2 py-2.5 text-xs focus:outline-none focus:border-chalk min-h-[44px] sm:min-h-0 cursor-pointer">
                                <option value="carpentry" <%= task.category === 'carpentry' ? 'selected' : '' %>>Carpintería</option>
                                <option value="pva_glue" <%= task.category === 'pva_glue' ? 'selected' : '' %>>Encolado PVA</option>
                                <option value="varnish_paint" <%= task.category === 'varnish_paint' ? 'selected' : '' %>>Barnizado</option>
                                <option value="epoxy" <%= task.category === 'epoxy' ? 'selected' : '' %>>Epoxi / Resina</option>
                            </select>
                            <p class="text-[9px] text-ink3 mt-0.5 sm:hidden">Toca "Guardar cambios" para aplicar.</p>
                        </div>
                        <div>
                            <label class="block text-[10px] font-semibold text-ink3 mb-1 uppercase tracking-wide">Horas activas</label>
                            <input type="number" step="0.5" min="0.5" name="estimated_hours" value="<%= task.estimated_hours %>" required class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-2 py-2.5 text-xs focus:outline-none focus:border-chalk min-h-[44px] sm:min-h-0">
                        </div>
                        <div>
                            <label class="block text-[10px] font-semibold text-ink3 mb-1 uppercase tracking-wide">Horas curado</label>
                            <input type="number" step="0.5" min="0.0" name="curing_hours" value="<%= task.curing_hours %>" required class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-2 py-2.5 text-xs focus:outline-none focus:border-chalk min-h-[44px] sm:min-h-0">
                        </div>
                    </div>
                    <div class="flex items-center gap-2 pt-1">
                        <button type="button" onclick="toggleEditTask(<%= task.id %>)" class="flex-1 bg-surface2 hover:bg-hairline text-ink2 font-semibold py-2.5 rounded-lg text-xs transition-colors min-h-[44px] sm:min-h-0">Cancelar</button>
                        <button type="submit" class="flex-1 bg-chalk hover:bg-chalk/80 text-canvas font-semibold py-2.5 rounded-lg text-xs transition-colors min-h-[44px] sm:min-h-0">Guardar cambios</button>
                    </div>
                </form>
                <form action="/tasks/<%= task.id %>/update_status" method="post" class="mt-2">
                    <input type="hidden" name="status" value="completed"><input type="hidden" name="progress" value="100">
                    <button type="submit" class="w-full flex items-center justify-center gap-1.5 bg-moss/10 hover:bg-moss/20 text-moss font-semibold py-2.5 rounded-lg text-xs transition-colors min-h-[44px] sm:min-h-0">
                        <svg class="w-3.5 h-3.5"><use href="#i-check"/></svg> Marcar como completada
                    </button>
                </form>
            </div>
        </div>
        <% }); %>
    </div>

    <!-- HISTORIAL DE ÚLTIMOS 7 DÍAS -->
    <div class="bg-surface border border-hairline rounded-2xl overflow-hidden shadow-panel">
        <button type="button" onclick="toggleHistory()" class="w-full flex items-center justify-between px-4 py-3 text-left">
            <span class="flex items-center gap-2 text-sm font-semibold text-ink2">
                <svg class="w-4 h-4 text-ink3"><use href="#i-history"/></svg>
                Historial (últimos 7 días)
                <span class="text-[11px] font-mono text-ink3 bg-surface2 border border-hairline px-2 py-0.5 rounded-full"><%= completed_history ? completed_history.length : 0 %></span>
            </span>
            <svg id="history-chevron" class="w-4 h-4 text-ink3 transition-transform"><use href="#i-chevron-down-sm"/></svg>
        </button>
        <div id="history-panel" class="hidden border-t border-hairline">
            <% if (completed_history && completed_history.length > 0) { %>
            <div class="divide-y divide-hairline max-h-72 overflow-y-auto">
                <% completed_history.forEach(function(t) { %>
                <div class="flex items-center justify-between gap-2 px-4 py-2.5">
                    <div class="min-w-0">
                        <p class="text-xs font-medium text-ink truncate"><%= t.title %></p>
                        <p class="text-[10px] text-ink3 font-mono"><%= t.completed_at ? new Date(t.completed_at).toLocaleString('es-ES') : '' %></p>
                    </div>
                    <span class="text-[11px] font-mono text-moss shrink-0"><%= t.estimated_hours %>h</span>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <p class="px-4 py-3 text-xs text-ink3">Todavía no hay tareas completadas en los últimos 7 días.</p>
            <% } %>
        </div>
    </div>

    <!-- SECCIÓN PROYECTOS -->
    <div class="bg-surface border border-hairline rounded-2xl overflow-hidden shadow-panel">
        <button type="button" onclick="toggleProjects()" class="w-full flex items-center justify-between px-4 py-3 text-left">
            <span class="flex items-center gap-2 text-sm font-semibold text-ink2">
                <svg class="w-4 h-4 text-brass"><use href="#i-import"/></svg>
                Proyectos
                <span class="text-[11px] font-mono text-ink3 bg-surface2 border border-hairline px-2 py-0.5 rounded-full">
                    <%= typeof all_projects !== 'undefined' && all_projects ? all_projects.length : 0 %>
                </span>
            </span>
            <svg id="projects-chevron" class="w-4 h-4 text-ink3 transition-transform"><use href="#i-chevron-down-sm"/></svg>
        </button>
        <div id="projects-panel" class="hidden border-t border-hairline p-4 space-y-4">
            <!-- Form Crear nuevo proyecto -->
            <form action="/projects/add" method="post" id="add-project-form" class="bg-surface2/60 border border-hairline rounded-xl p-3.5 space-y-3">
                <p class="text-xs font-semibold text-ink2">Crear nuevo proyecto</p>
                <div class="flex flex-col sm:flex-row gap-2">
                    <input type="text" name="name" required placeholder="Nombre (ej. Estructura Pérgola)" class="flex-1 bg-surface border border-hairline text-ink text-xs rounded-lg px-3 py-2 focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    <button type="submit" class="bg-brass hover:bg-brassdim text-canvas font-semibold text-xs px-4 py-2 rounded-lg transition-colors whitespace-nowrap min-h-[44px] sm:min-h-0 flex items-center justify-center gap-1.5">
                        <svg class="w-3.5 h-3.5"><use href="#i-plus"/></svg> Crear
                    </button>
                </div>
            </form>

            <!-- Lista de Proyectos con Acordeón y Edición Directa de Tareas -->
            <% if (typeof all_projects !== 'undefined' && all_projects && all_projects.length > 0) { %>
            <div class="space-y-3 max-h-96 overflow-y-auto pr-1">
                <% all_projects.forEach(function(p) { 
                    const projTasks = (typeof all_tasks !== 'undefined' && all_tasks) ? all_tasks.filter(function(t) { return t.project_id === p.id; }) : [];
                    const isProjActive = p.is_active !== false;
                %>
                <div class="bg-surface border <%= isProjActive ? 'border-brass/40 bg-brass/5' : 'border-hairline opacity-75' %> rounded-xl overflow-hidden shadow-xs transition-all" id="project-card-<%= p.id %>">
                    <!-- Header Acordeón Proyecto -->
                    <div class="p-3 flex items-center justify-between gap-2 cursor-pointer select-none" onclick="toggleProjectAccordion('<%= p.id %>')">
                        <div class="flex items-center gap-2 min-w-0 flex-1">
                            <svg id="proj-chevron-<%= p.id %>" class="w-4 h-4 text-ink3 transition-transform duration-200 shrink-0"><use href="#i-chevron-down-sm"/></svg>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h5 class="text-xs font-bold text-ink truncate"><%= p.name %></h5>
                                    <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border <%= isProjActive ? 'bg-moss/10 text-moss border-moss/30 font-semibold' : 'bg-surface2 text-ink3 border-hairline' %> shrink-0">
                                        <%= isProjActive ? '⚡ Agendable' : 'Pausado' %>
                                    </span>
                                    <span class="text-[10px] font-mono text-ink3 bg-surface2 border border-hairline px-1.5 py-0.5 rounded-full shrink-0">
                                        <%= projTasks.length %> tareas
                                    </span>
                                </div>
                                <% if (p.description) { %>
                                <p class="text-[11px] text-ink3 truncate mt-0.5"><%= p.description %></p>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Toggle Activo para Agendar -->
                        <div class="flex items-center gap-2 shrink-0" onclick="event.stopPropagation()">
                            <form action="/projects/<%= p.id %>/toggle" method="post" class="inline-block">
                                <input type="hidden" name="is_active" value="<%= isProjActive ? 'false' : 'true' %>">
                                <button type="submit" title="<%= isProjActive ? 'Desactivar proyecto para agendamiento' : 'Activar proyecto para agendamiento' %>" class="px-2.5 py-1 rounded-lg text-xs font-semibold border transition-colors flex items-center gap-1.5 min-h-[32px] sm:min-h-0 <%= isProjActive ? 'bg-moss/10 text-moss border-moss/30 hover:bg-moss/20' : 'bg-surface2 text-ink2 border-hairline hover:bg-hairline' %>">
                                    <span class="w-2 h-2 rounded-full <%= isProjActive ? 'bg-moss' : 'bg-ink3' %>"></span>
                                    <%= isProjActive ? 'Activo' : 'Activar' %>
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Cuerpo Acordeón: Tareas del Proyecto -->
                    <div id="proj-body-<%= p.id %>" class="hidden border-t border-hairline bg-canvas/40 p-3 space-y-2.5">
                        <% if (projTasks.length > 0) { %>
                        <div class="space-y-2">
                            <% projTasks.forEach(function(t) { 
                                const isTaskActive = t.is_active !== false;
                            %>
                            <div class="bg-surface border border-hairline rounded-lg p-2.5 space-y-2 shadow-xs" id="task-card-<%= t.id %>">
                                <div class="flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-2 min-w-0 flex-1">
                                        <!-- Task Active Checkbox -->
                                        <form action="/tasks/<%= t.id %>/toggle-active" method="post" class="inline-block shrink-0">
                                            <input type="hidden" name="is_active" value="<%= isTaskActive ? 'false' : 'true' %>">
                                            <button type="submit" title="<%= isTaskActive ? 'Desactivar esta tarea del agendamiento' : 'Activar esta tarea para el agendamiento' %>" class="w-5 h-5 rounded flex items-center justify-center border transition-colors <%= isTaskActive ? 'bg-moss text-canvas border-moss' : 'bg-surface2 text-transparent border-hairline hover:border-ink3' %>">
                                                <svg class="w-3.5 h-3.5"><use href="#i-check"/></svg>
                                            </button>
                                        </form>

                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-[10px] font-mono text-ink3 font-bold">#<%= t.order %></span>
                                                <p class="text-xs font-semibold text-ink truncate <%= !isTaskActive ? 'line-through text-ink3' : '' %>"><%= t.title %></p>
                                            </div>
                                            <div class="flex items-center gap-2 mt-0.5 text-[10px] font-mono text-ink3">
                                                <span class="capitalize text-brass font-medium"><%= category_labels[t.category] || t.category %></span>
                                                <span>•</span>
                                                <span><%= t.estimated_hours %>h activas</span>
                                                <% if (t.curing_hours > 0) { %>
                                                <span>•</span>
                                                <span class="text-chalk"><%= t.curing_hours %>h curado</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <!-- 1. Agregar a tareas actuales (Mover al backlog activo) -->
                                        <button type="button" 
                                                onclick="activateTaskToBacklog('<%= t.id %>', '<%= t.title.replace(/'/g, "\\'") %>')" 
                                                title="Agregar a tareas actuales / Mover al Backlog" 
                                                aria-label="Agregar a tareas actuales" 
                                                class="px-2 py-1 rounded-md bg-brass/10 hover:bg-brass/20 text-brass border border-brass/30 text-xs font-semibold transition-colors flex items-center gap-1 shadow-xs">
                                            <svg class="w-3.5 h-3.5"><use href="#i-inbox"/></svg>
                                            <span class="text-[10px] font-medium hidden sm:inline">Al Backlog</span>
                                        </button>

                                        <!-- 2. Editar -->
                                        <button type="button" 
                                                onclick="toggleTaskInlineEdit('<%= t.id %>')" 
                                                title="Editar tarea" 
                                                aria-label="Editar tarea" 
                                                class="p-1.5 rounded-md bg-surface2 hover:bg-hairline text-ink2 border border-hairline text-xs font-semibold transition-colors flex items-center gap-1 shadow-xs">
                                            <svg class="w-3.5 h-3.5"><use href="#i-edit"/></svg>
                                        </button>

                                        <!-- 3. Eliminar -->
                                        <form action="/tasks/<%= t.id %>/delete" method="post" class="inline-block" onsubmit="return handleTaskDelete(event, '<%= t.id %>', '<%= t.title.replace(/'/g, "\\'") %>')">
                                            <button type="submit" 
                                                    title="Eliminar tarea" 
                                                    aria-label="Eliminar tarea" 
                                                    class="p-1.5 rounded-md bg-rust/10 hover:bg-rust/20 text-rust border border-rust/30 text-xs transition-colors flex items-center justify-center shadow-xs">
                                                <svg class="w-3.5 h-3.5"><use href="#i-close"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                 <!-- Inline Edit Form -->
                                <form id="task-edit-form-<%= t.id %>" action="/tasks/<%= t.id %>/update" method="post" onsubmit="return handleTaskUpdate(event, '<%= t.id %>')" class="hidden border-t border-hairline pt-2.5 mt-2 space-y-2 bg-surface2/50 rounded-md p-2">
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                        <div class="sm:col-span-2">
                                            <label class="block text-[10px] font-semibold text-ink3 uppercase">Título</label>
                                            <input type="text" name="title" value="<%= t.title %>" required class="w-full bg-surface border border-hairline text-ink text-xs rounded px-2 py-1.5 focus:outline-none focus:border-brass">
                                        </div>
                                        <div>
                                            <label class="block text-[10px] font-semibold text-ink3 uppercase">Categoría</label>
                                            <select name="category" class="w-full bg-surface border border-hairline text-ink text-xs rounded px-2 py-1.5 focus:outline-none focus:border-brass">
                                                <% categories.forEach(function(cat) { %>
                                                <option value="<%= cat %>" <%= cat === t.category ? 'selected' : '' %>><%= category_labels[cat] || cat %></option>
                                                <% }); %>
                                            </select>
                                        </div>
                                        <div>
                                            <label class="block text-[10px] font-semibold text-ink3 uppercase">Horas Activas</label>
                                            <input type="number" step="0.5" min="0.5" name="estimated_hours" value="<%= t.estimated_hours %>" required class="w-full bg-surface border border-hairline text-ink text-xs rounded px-2 py-1.5 focus:outline-none focus:border-brass">
                                        </div>
                                        <div>
                                            <label class="block text-[10px] font-semibold text-ink3 uppercase">Horas Curado</label>
                                            <input type="number" step="0.5" min="0" name="curing_hours" value="<%= t.curing_hours %>" class="w-full bg-surface border border-hairline text-ink text-xs rounded px-2 py-1.5 focus:outline-none focus:border-brass">
                                        </div>
                                        <div>
                                            <label class="block text-[10px] font-semibold text-ink3 uppercase">Proyecto</label>
                                            <select name="project_id" class="w-full bg-surface border border-hairline text-ink text-xs rounded px-2 py-1.5 focus:outline-none focus:border-brass">
                                                <% all_projects.forEach(function(proj) { %>
                                                <option value="<%= proj.id %>" <%= proj.id === t.project_id ? 'selected' : '' %>><%= proj.name %></option>
                                                <% }); %>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="flex justify-end gap-1.5 pt-1">
                                        <button type="button" onclick="toggleTaskInlineEdit('<%= t.id %>')" class="px-2.5 py-1 text-xs text-ink3 hover:text-ink bg-surface border border-hairline rounded transition-colors">Cancelar</button>
                                        <button type="submit" class="px-3 py-1 text-xs bg-brass hover:bg-brassdim text-canvas font-semibold rounded transition-colors">Guardar</button>
                                    </div>
                                </form>
                            </div>
                            <% }); %>
                        </div>
                        <% } else { %>
                        <p class="text-xs text-ink3 italic py-1 text-center">Sin tareas en este proyecto.</p>
                        <% } %>

                        <button type="button" onclick="quickAddTaskToProject('<%= p.id %>')" class="w-full border border-dashed border-hairline hover:border-brass text-ink3 hover:text-brass text-xs py-1.5 rounded-lg transition-colors flex items-center justify-center gap-1 font-medium">
                            <svg class="w-3.5 h-3.5"><use href="#i-plus"/></svg> Añadir tarea a <%= p.name %>
                        </button>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <p class="text-xs text-ink3 italic text-center py-2">No hay proyectos registrados aún.</p>
            <% } %>
        </div>
    </div>
</div>
