<!-- MODAL: CONFIGURACIÓN -->
<div id="settings-modal" class="fixed inset-0 z-[110] bg-canvas/85 backdrop-blur-sm hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
    <!-- En móviles: Bottom Sheet con altura fija. En desktop: modal centrado con altura fija. -->
    <div class="bg-surface border-t sm:border border-hairline rounded-t-2xl sm:rounded-xl w-full sm:max-w-2xl flex flex-col shadow-panel relative h-[82vh] sm:h-[580px]">
        <div class="w-12 h-1 bg-hairline rounded-full mx-auto mb-2 sm:hidden shrink-0 mt-2"></div>

        <!-- Header del Modal -->
        <div class="flex items-center justify-between border-b border-hairline px-5 py-3 shrink-0">
            <h3 class="font-display text-base font-semibold text-ink">Parámetros y configuración</h3>
            <button type="button" onclick="closeSettingsModal()" aria-label="Cerrar" class="text-ink3 hover:text-ink w-8 h-8 flex items-center justify-center rounded-md bg-surface2">
                <svg class="w-4 h-4"><use href="#i-close"/></svg>
            </button>
        </div>

        <!-- NAVEGACIÓN MÓVIL: Select dropdown (solo visible en pantallas pequeñas) -->
        <div class="sm:hidden px-4 py-2.5 border-b border-hairline bg-canvas/20 shrink-0">
            <div class="relative">
                <select id="settings-tab-select" onchange="switchSettingsTab(this.value)"
                    class="w-full appearance-none bg-surface2 border border-hairline text-ink text-sm font-semibold rounded-xl px-4 py-2.5 pr-10 focus:outline-none focus:border-brass cursor-pointer">
                    <option value="location">Ubicación</option>
                    <option value="workday">Jornada y Clima</option>
                    <option value="notifications">Notificaciones</option>
                    <option value="integrations">Integraciones</option>
                    <option value="security">Seguridad</option>
                </select>
                <svg class="w-4 h-4 text-ink3 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none"><use href="#i-chevron-down-sm"/></svg>
            </div>
        </div>

        <!-- NAVEGACIÓN DESKTOP: Grid de tabs (oculto en móviles) -->
        <div class="hidden sm:grid sm:grid-cols-5 border-b border-hairline bg-canvas/20 shrink-0">
            <button type="button" onclick="switchSettingsTab('location')" id="tab-btn-location"
                class="settings-tab-btn flex flex-col items-center gap-1 py-2.5 text-[10px] font-semibold transition-colors border-b-2 border-brass text-brass bg-surface/60">
                <svg class="w-3.5 h-3.5"><use href="#i-pin"/></svg>
                Ubicación
            </button>
            <button type="button" onclick="switchSettingsTab('workday')" id="tab-btn-workday"
                class="settings-tab-btn flex flex-col items-center gap-1 py-2.5 text-[10px] font-semibold transition-colors border-b-2 border-transparent text-ink3 hover:text-ink hover:bg-surface/40">
                <svg class="w-3.5 h-3.5"><use href="#i-timer"/></svg>
                Jornada
            </button>
            <button type="button" onclick="switchSettingsTab('notifications')" id="tab-btn-notifications"
                class="settings-tab-btn flex flex-col items-center gap-1 py-2.5 text-[10px] font-semibold transition-colors border-b-2 border-transparent text-ink3 hover:text-ink hover:bg-surface/40">
                <svg class="w-3.5 h-3.5"><use href="#i-bell"/></svg>
                Avisos
            </button>
            <button type="button" onclick="switchSettingsTab('integrations')" id="tab-btn-integrations"
                class="settings-tab-btn flex flex-col items-center gap-1 py-2.5 text-[10px] font-semibold transition-colors border-b-2 border-transparent text-ink3 hover:text-ink hover:bg-surface/40">
                <svg class="w-3.5 h-3.5"><use href="#i-calendar"/></svg>
                Calendario
            </button>
            <button type="button" onclick="switchSettingsTab('security')" id="tab-btn-security"
                class="settings-tab-btn flex flex-col items-center gap-1 py-2.5 text-[10px] font-semibold transition-colors border-b-2 border-transparent text-ink3 hover:text-ink hover:bg-surface/40">
                <svg class="w-3.5 h-3.5"><use href="#i-settings"/></svg>
                Seguridad
            </button>
        </div>

        <form id="settings-form" action="/settings/update" method="post" onsubmit="saveSettings(event)" class="flex flex-col flex-1 min-h-0">
            <!-- Contenido scrollable de las pestañas — altura fija garantizada -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4">
                <%- include('settings/_tab_location') %>

                <div id="tab-content-workday" class="settings-tab-content hidden space-y-4">
                    <%- include('settings/_tab_operational') %>
                    <%- include('settings/_tab_climate') %>
                </div>

                <%- include('settings/_tab_telegram') %>
                <%- include('settings/_tab_integrations') %>
                <%- include('settings/_tab_security_backup') %>
            </div>

            <!-- Footer Fijo de Acciones -->
            <div class="flex items-center gap-3 p-4 border-t border-hairline bg-surface shrink-0">
                <button type="button" onclick="closeSettingsModal()" class="flex-1 bg-surface2 hover:bg-hairline text-ink2 font-semibold py-2.5 rounded-lg text-xs transition-colors">Cancelar</button>
                <button type="submit" id="btn-save-settings" class="flex-1 bg-brass hover:bg-brassdim disabled:opacity-60 disabled:cursor-not-allowed text-canvas font-semibold py-2.5 rounded-lg text-xs transition-colors flex items-center justify-center gap-2">
                    <span id="btn-save-settings-text">Guardar ajustes</span>
                </button>
            </div>
        </form>
    </div>
</div>
