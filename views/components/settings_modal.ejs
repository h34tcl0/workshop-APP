<!-- MODAL: CONFIGURACIÓN -->
<div id="settings-modal" class="fixed inset-0 z-[110] bg-canvas/85 backdrop-blur-sm hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-surface border-t sm:border border-hairline rounded-t-2xl sm:rounded-xl w-full max-w-lg max-h-[85vh] sm:max-h-[90vh] overflow-y-auto p-5 sm:p-6 shadow-panel relative">
        <div class="w-12 h-1 bg-hairline rounded-full mx-auto mb-3 sm:hidden"></div>
        <div class="flex items-center justify-between border-b border-hairline pb-4 mb-5">
            <h3 class="font-display text-lg font-semibold text-ink">Parámetros y ubicación</h3>
            <button type="button" onclick="closeSettingsModal()" aria-label="Cerrar" class="text-ink3 hover:text-ink w-11 h-11 sm:w-8 sm:h-8 flex items-center justify-center rounded-md bg-surface2 min-h-[44px] min-w-[44px] sm:min-h-0 sm:min-w-0">
                <svg class="w-4 h-4"><use href="#i-close"/></svg>
            </button>
        </div>

        <form action="/settings/update" method="post" class="space-y-4">
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <div class="flex items-center gap-1.5">
                        <label class="block text-[11px] font-semibold text-ink3 uppercase tracking-wide">Ubicación</label>
                        <button type="button" onclick="toggleTip('location')" class="text-ink3 hover:text-chalk shrink-0 min-h-[32px] min-w-[32px] flex items-center justify-center" aria-label="Ayuda: Ubicación">
                            <svg class="w-3 h-3"><use href="#i-help"/></svg>
                        </button>
                    </div>
                    <button type="button" onclick="toggleLocationMap()" class="flex items-center gap-1.5 text-[11px] font-semibold text-chalk hover:text-chalk/80 min-h-[36px]">
                        <svg class="w-3.5 h-3.5"><use href="#i-pin"/></svg> Elegir en el mapa
                    </button>
                </div>
                <p id="tip-location" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Ubicación del taller. Se usa para pedir el pronóstico del clima.</p>
                <div class="grid grid-cols-2 gap-3 sm:gap-4">
                    <div>
                        <input type="number" step="0.0001" id="input-latitude" name="latitude" value="<%= app_settings ? app_settings.latitude : -32.99 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>
                    <div>
                        <input type="number" step="0.0001" id="input-longitude" name="longitude" value="<%= app_settings ? app_settings.longitude : -71.27 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>
                </div>

                <!-- Panel de mapa (oculto por defecto) -->
                <div id="location-map-panel" class="hidden mt-3 space-y-2">
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1">
                            <svg class="w-3.5 h-3.5 text-ink3 absolute left-3 top-1/2 -translate-y-1/2"><use href="#i-search"/></svg>
                            <input type="text" id="map-search-input" placeholder="Buscar dirección o ciudad..." class="w-full bg-surface2 border border-hairline text-ink rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-chalk min-h-[44px] sm:min-h-0">
                        </div>
                        <button type="button" onclick="searchMapLocation()" class="bg-chalk/15 hover:bg-chalk/25 text-chalk px-3 py-2.5 rounded-lg text-xs font-semibold whitespace-nowrap min-h-[44px] sm:min-h-0 flex items-center">Buscar</button>
                    </div>
                    <div id="location-map" class="w-full h-56 rounded-lg border border-hairline overflow-hidden"></div>
                    <p class="text-[11px] text-ink3">Toca el mapa para fijar el punto. Los campos de arriba se actualizan solos.</p>
                </div>

                <!-- Indicador de Hora Local Sincronizada y Huso Horario -->
                <div class="mt-3 p-3 bg-canvas/60 border border-hairline/80 rounded-xl flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                        <div class="w-8 h-8 rounded-lg bg-surface2 flex items-center justify-center text-chalk text-base shrink-0">
                            🕒
                        </div>
                        <div>
                            <span class="block text-[11px] font-semibold text-ink3 uppercase tracking-wide">Hora local sincronizada</span>
                            <span id="local-time-display" class="text-sm font-mono font-bold text-ink">
                                <%= typeof local_time_info !== 'undefined' && local_time_info ? local_time_info.formattedDisplay : 'Cargando...' %>
                            </span>
                        </div>
                    </div>
                    <span id="timezone-display" class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-surface2 border border-hairline text-chalk font-semibold shrink-0">
                        <%= app_settings && app_settings.timezone ? app_settings.timezone : 'America/Santiago' %>
                    </span>
                    <input type="hidden" id="input-timezone" name="timezone" value="<%= app_settings && app_settings.timezone ? app_settings.timezone : 'America/Santiago' %>">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 sm:gap-4">
                <div>
                    <div class="flex items-center gap-1.5 mb-1.5">
                        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink3">Inicio jornada</label>
                        <button type="button" onclick="toggleTip('start-hour')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Inicio jornada">
                            <svg class="w-3 h-3"><use href="#i-help"/></svg>
                        </button>
                    </div>
                    <p id="tip-start-hour" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Hora en que puede empezar a evaluarse trabajo ese día.</p>
                    <input type="number" name="operational_start_hour" min="0" max="23" value="<%= app_settings ? app_settings.operational_start_hour : 9 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                </div>
                <div>
                    <div class="flex items-center gap-1.5 mb-1.5">
                        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink3">Fin jornada</label>
                        <button type="button" onclick="toggleTip('end-hour')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Fin jornada">
                            <svg class="w-3 h-3"><use href="#i-help"/></svg>
                        </button>
                    </div>
                    <p id="tip-end-hour" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Hora límite del día. Todo (setup + trabajo + teardown) debe caber antes de esto.</p>
                    <input type="number" name="operational_end_hour" min="0" max="23" value="<%= app_settings ? app_settings.operational_end_hour : 18 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-3 sm:gap-4">
                <div>
                    <div class="flex items-center gap-1.5 mb-1.5">
                        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink3">Humedad máxima (%)</label>
                        <button type="button" onclick="toggleTip('humidity')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Humedad máxima (%)">
                            <svg class="w-3 h-3"><use href="#i-help"/></svg>
                        </button>
                    </div>
                    <p id="tip-humidity" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Si la humedad del aire supera este valor durante el trabajo, se bloquea la ventana.</p>
                    <input type="number" name="max_humidity_percent" min="0" max="100" value="<%= app_settings ? app_settings.max_humidity_percent : 80 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                </div>
                <div>
                    <div class="flex items-center gap-1.5 mb-1.5">
                        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink3">Umbral de lluvia (mm)</label>
                        <button type="button" onclick="toggleTip('rain-threshold')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Umbral de lluvia (mm)">
                            <svg class="w-3 h-3"><use href="#i-help"/></svg>
                        </button>
                    </div>
                    <p id="tip-rain-threshold" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">A partir de cuántos mm por hora se considera que 'está lloviendo'. Más bajo = más estricto. Más alto = más tolerante.</p>
                    <input type="number" step="0.1" min="0" name="min_rain_precipitation_mm" value="<%= app_settings ? app_settings.min_rain_precipitation_mm : 0.2 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                </div>
            </div>

            <div class="pt-1">
                <p class="text-[11px] font-semibold text-ink3 uppercase tracking-wide mb-2">Tiempos operativos</p>
                <div class="grid grid-cols-2 gap-3 sm:gap-4">
                    <div>
                        <div class="flex items-center gap-1.5 mb-1.5">
                            <label class="block text-[10px] text-ink3">Setup (h)</label>
                            <button type="button" onclick="toggleTip('setup')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Setup (h)">
                                <svg class="w-3 h-3"><use href="#i-help"/></svg>
                            </button>
                        </div>
                        <p id="tip-setup" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Tiempo fijo de preparación antes de empezar a trabajar (sacar herramientas, ordenar, etc.).</p>
                        <input type="number" step="0.5" min="0" name="setup_hours" value="<%= app_settings ? app_settings.setup_hours : 1.0 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5 mb-1.5">
                            <label class="block text-[10px] text-ink3">Teardown (h)</label>
                            <button type="button" onclick="toggleTip('teardown')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Teardown (h)">
                                <svg class="w-3 h-3"><use href="#i-help"/></svg>
                            </button>
                        </div>
                        <p id="tip-teardown" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Tiempo fijo de cierre al final (guardar herramientas, limpiar).</p>
                        <input type="number" step="0.5" min="0" name="teardown_hours" value="<%= app_settings ? app_settings.teardown_hours : 1.0 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5 mb-1.5">
                            <label class="block text-[10px] text-ink3">Trabajo mínimo (h)</label>
                            <button type="button" onclick="toggleTip('min-work')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Trabajo mínimo (h)">
                                <svg class="w-3 h-3"><use href="#i-help"/></svg>
                            </button>
                        </div>
                        <p id="tip-min-work" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Si no se puede agendar al menos esta cantidad de horas activas, ese día se descarta.</p>
                        <input type="number" step="0.5" min="0" name="min_work_hours" value="<%= app_settings ? app_settings.min_work_hours : 1.0 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5 mb-1.5">
                            <label class="block text-[10px] text-ink3">Mínimo salvo tarea final (h)</label>
                            <button type="button" onclick="toggleTip('min-work-final')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Mínimo salvo tarea final (h)">
                                <svg class="w-3 h-3"><use href="#i-help"/></svg>
                            </button>
                        </div>
                        <p id="tip-min-work-final" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">No vale la pena abrir el taller por menos de esto — salvo que sea la última tarea que te queda en todo el backlog.</p>
                        <input type="number" step="0.5" min="0" name="min_work_hours_unless_final" value="<%= app_settings ? app_settings.min_work_hours_unless_final : 4.0 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>
                </div>
            </div>

            <div class="pt-1">
                <p class="text-[11px] font-semibold text-ink3 uppercase tracking-wide mb-2">Avisos y horarios</p>
                <div class="grid grid-cols-2 gap-3 sm:gap-4">
                    <div>
                        <div class="flex items-center gap-1.5 mb-1.5">
                            <label class="block text-[10px] text-ink3">Hora de check-in de cierre</label>
                            <button type="button" onclick="toggleTip('checkin-hour')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Hora de check-in de cierre">
                                <svg class="w-3 h-3"><use href="#i-help"/></svg>
                            </button>
                        </div>
                        <p id="tip-checkin-hour" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">A esta hora fija te pregunta por Telegram si terminaste las tareas de hoy.</p>
                        <input type="number" min="0" max="23" name="checkin_hour" value="<%= app_settings ? app_settings.checkin_hour : 19 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>
                    <div>
                        <div class="flex items-center gap-1.5 mb-1.5">
                            <label class="block text-[10px] text-ink3">Margen evaluación matutina (h)</label>
                            <button type="button" onclick="toggleTip('morning-lead')" class="text-ink3 hover:text-chalk shrink-0" aria-label="Ayuda: Margen evaluación matutina (h)">
                                <svg class="w-3 h-3"><use href="#i-help"/></svg>
                            </button>
                        </div>
                        <p id="tip-morning-lead" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mb-2 leading-snug">Cuántas horas antes de que abra tu jornada se evalúa el clima del día y se manda el aviso matutino.</p>
                        <input type="number" min="0" max="12" name="morning_eval_lead_hours" value="<%= app_settings ? app_settings.morning_eval_lead_hours : 1 %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                    </div>
                </div>
            </div>

            <div class="pt-1">
                <p class="text-[11px] font-semibold text-ink3 uppercase tracking-wide mb-2">Días no laborables</p>
                <div class="space-y-3">
                    <div>
                        <label class="flex items-center gap-3 cursor-pointer min-h-[44px] py-1">
                            <input type="checkbox" name="exclude_saturdays" value="true" <%= (app_settings && app_settings.exclude_saturdays) ? 'checked' : '' %> class="w-5 h-5 sm:w-4 sm:h-4 rounded border-hairline bg-surface2 text-brass focus:ring-brass">
                            <span class="text-xs text-ink2 font-medium flex-1">Excluir sábados</span>
                            <button type="button" onclick="toggleTip('excl-sat')" class="text-ink3 hover:text-chalk shrink-0 min-h-[36px] min-w-[36px] flex items-center justify-center" aria-label="Ayuda: Excluir sábados">
                                <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3"><use href="#i-help"/></svg>
                            </button>
                        </label>
                        <p id="tip-excl-sat" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mt-1.5 ml-7 leading-snug">Nunca agenda trabajo ese día de la semana, sin importar el clima.</p>
                    </div>

                    <div>
                        <label class="flex items-center gap-3 cursor-pointer min-h-[44px] py-1">
                            <input type="checkbox" name="exclude_sundays" value="true" <%= (app_settings && app_settings.exclude_sundays) ? 'checked' : '' %> class="w-5 h-5 sm:w-4 sm:h-4 rounded border-hairline bg-surface2 text-brass focus:ring-brass">
                            <span class="text-xs text-ink2 font-medium flex-1">Excluir domingos</span>
                            <button type="button" onclick="toggleTip('excl-sun')" class="text-ink3 hover:text-chalk shrink-0 min-h-[36px] min-w-[36px] flex items-center justify-center" aria-label="Ayuda: Excluir domingos">
                                <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3"><use href="#i-help"/></svg>
                            </button>
                        </label>
                        <p id="tip-excl-sun" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mt-1.5 ml-7 leading-snug">Nunca agenda trabajo ese día de la semana, sin importar el clima.</p>
                    </div>

                    <div>
                        <label class="flex items-center gap-3 cursor-pointer min-h-[44px] py-1">
                            <input type="checkbox" name="exclude_holidays" value="true" <%= (app_settings && app_settings.exclude_holidays) ? 'checked' : '' %> class="w-5 h-5 sm:w-4 sm:h-4 rounded border-hairline bg-surface2 text-brass focus:ring-brass">
                            <span class="text-xs text-ink2 font-medium flex-1">Excluir feriados (Chile)</span>
                            <button type="button" onclick="toggleTip('excl-hol')" class="text-ink3 hover:text-chalk shrink-0 min-h-[36px] min-w-[36px] flex items-center justify-center" aria-label="Ayuda: Excluir feriados">
                                <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3"><use href="#i-help"/></svg>
                            </button>
                        </label>
                        <p id="tip-excl-hol" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mt-1.5 ml-7 leading-snug">Consulta los feriados oficiales de Chile del año y nunca agenda trabajo esos días.</p>
                    </div>

                    <div>
                        <label class="flex items-center gap-3 cursor-pointer min-h-[44px] py-1">
                            <input type="checkbox" name="require_curing_before_cutoff" value="true" <%= (app_settings && app_settings.require_curing_before_cutoff) ? 'checked' : '' %> class="w-5 h-5 sm:w-4 sm:h-4 rounded border-hairline bg-surface2 text-brass focus:ring-brass">
                            <span class="text-xs text-ink2 font-medium flex-1">Exigir que el curado termine antes del cierre de jornada</span>
                            <button type="button" onclick="toggleTip('curing-cutoff')" class="text-ink3 hover:text-chalk shrink-0 min-h-[36px] min-w-[36px] flex items-center justify-center" aria-label="Ayuda: Exigir curado antes del cierre">
                                <svg class="w-3.5 h-3.5 sm:w-3 sm:h-3"><use href="#i-help"/></svg>
                            </button>
                        </label>
                        <p id="tip-curing-cutoff" class="hidden text-[11px] text-ink2 bg-canvas/50 border border-hairline rounded-md px-2.5 py-2 mt-1.5 ml-7 leading-snug">Si está activado, una tarea con curado solo se agenda si el secado también termina antes del fin de jornada.</p>
                    </div>
                </div>
            </div>

            <div class="pt-1 border-t border-hairline mt-3 pt-3">
                <p class="text-[11px] font-semibold text-ink3 uppercase tracking-wide mb-2">Integraciones (Telegram y Google Calendar)</p>
                <div class="space-y-3">
                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink3 mb-1">Telegram</label>
                        <% if (app_settings && app_settings.telegram_chat_id) { %>
                            <div class="flex items-center justify-between gap-2 bg-surface2 border border-hairline rounded-lg px-3 py-2.5">
                                <span class="text-sm text-ink">✅ Vinculado (Chat ID: <%= app_settings.telegram_chat_id %>)</span>
                                <form action="/settings/telegram/unlink" method="post" onsubmit="return confirm('¿Desvincular este chat de Telegram? Dejarás de recibir notificaciones hasta volver a vincularlo.');">
                                    <button type="submit" class="text-xs font-semibold text-red-400 hover:text-red-300 shrink-0 min-h-[36px] px-2">Desvincular</button>
                                </form>
                            </div>
                            <p class="text-[10px] text-ink3 mt-1">Tus notificaciones de aviso y check-in llegan exclusivamente a este chat.</p>
                        <% } else { %>
                            <div id="telegram-link-box">
                                <button type="button" onclick="generateTelegramLinkCode()" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm hover:border-brass min-h-[44px] sm:min-h-0">
                                    🔗 Generar código de vinculación
                                </button>
                            </div>
                            <div id="telegram-link-result" class="hidden mt-2 bg-surface2 border border-hairline rounded-lg px-3 py-2.5 text-sm text-ink">
                                <p>Mandá este código a tu bot de Telegram:</p>
                                <p class="font-mono text-lg font-bold text-brass tracking-wider mt-1"><code id="telegram-link-code"></code></p>
                                <p class="text-[10px] text-ink3 mt-1"><code>/vincular <span id="telegram-link-code-inline"></span></code></p>
                                <p class="text-[10px] text-ink3 mt-1" id="telegram-link-expiry"></p>
                            </div>
                            <p class="text-[10px] text-ink3 mt-1">Generá un código desde acá y mandalo al bot de Telegram para vincular tu cuenta de forma segura.</p>
                        <% } %>
                    </div>

                    <div>
                        <label class="block text-[11px] font-semibold uppercase tracking-wide text-ink3 mb-1">Google Calendar ID</label>
                        <input type="text" name="google_calendar_id" placeholder="Ej: usuario@gmail.com o ID de calendario" value="<%= app_settings && app_settings.google_calendar_id ? app_settings.google_calendar_id : '' %>" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-brass min-h-[44px] sm:min-h-0">
                        <p class="text-[10px] text-ink3 mt-1">ID de tu calendario personal de Google para agendar bloques macro de trabajo.</p>
                    </div>

                    <div>
                        <label class="flex items-center gap-3 cursor-pointer min-h-[44px] py-1">
                            <input type="checkbox" name="google_calendar_enabled" value="true" <%= (app_settings && app_settings.google_calendar_enabled) ? 'checked' : '' %> class="w-5 h-5 sm:w-4 sm:h-4 rounded border-hairline bg-surface2 text-brass focus:ring-brass">
                            <span class="text-xs text-ink2 font-medium flex-1">Sincronizar eventos en Google Calendar automáticamente</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3 pt-4 border-t border-hairline mt-5">
                <button type="button" onclick="closeSettingsModal()" class="flex-1 bg-surface2 hover:bg-hairline text-ink2 font-semibold py-3 rounded-lg text-sm transition-colors min-h-[44px]">Cancelar</button>
                <button type="submit" class="flex-1 bg-brass hover:bg-brassdim text-canvas font-semibold py-3 rounded-lg text-sm transition-colors min-h-[44px]">Guardar ajustes</button>
            </div>
        </form>
    </div>
</div>
