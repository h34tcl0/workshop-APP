<!-- PANEL DESPLEGABLE DE CLIMA 24H (Se activa al hacer clic en el ícono de clima o anillo) -->
<%
    const eval = locals.eval || (locals.item && (locals.item.evaluation || locals.item)) || {};
    const date_iso = locals.date_iso || (locals.item && locals.item.date_iso) || eval.eval_date || '';
    const date_str = locals.date_str || (locals.item && locals.item.date_str) || eval.date_str || '';
    const ico_emoji = locals.ico_emoji || '☀️';
    const app_settings = locals.app_settings || {};
    const max_hum = app_settings.max_humidity_percent != null ? app_settings.max_humidity_percent : 80;
    const min_rain = app_settings.min_rain_precipitation_mm != null ? app_settings.min_rain_precipitation_mm : 0.1;
    const hourly_items = locals.hourly_items || eval.hourly_audit || [];
%>
<% if (hourly_items && hourly_items.length > 0) { %>
    <% const hourly_panel_id = 'hourly-panel-' + date_iso; %>
    <div id="<%= hourly_panel_id %>" class="hidden border-t border-[var(--w-bd)] bg-[var(--w-s2)]/90 p-3 sm:p-4 text-xs shadow-inner rounded-b-2xl">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2.5 pb-2 border-b border-[var(--w-bd)] text-[11px] sm:text-xs">
            <span class="font-semibold text-[var(--w-t1)] uppercase tracking-wider flex items-center gap-1.5">
                <span><%= ico_emoji %></span>
                Pronóstico Horario (24h) — <%= date_str %>
            </span>
            <div class="flex flex-wrap items-center gap-2 text-[10px] font-mono-jb text-[var(--w-t2)]">
                <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[var(--w-warn)] shrink-0"></span> Humedad &gt; <%= max_hum %>%</span>
                <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[var(--w-rust)] shrink-0"></span> Lluvia &ge; <%= min_rain %>mm</span>
                <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[var(--w-amber)] shrink-0"></span> &Delta;T &lt; 3&deg;C (Riesgo Roc&iacute;o)</span>
                <span class="inline-flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-[var(--w-sky)] shrink-0"></span> R&aacute;fagas &gt; 25 km/h</span>
            </div>
        </div>

        <div class="max-h-72 overflow-y-auto pr-1 custom-scrollbar space-y-1">
            <% hourly_items.forEach(function(item) { %>
                <%
                    const f = item.forecast || item || {};
                    const hLabel = item.time_label || (String(f.hour != null ? f.hour : 0).padStart(2, '0') + ':00');
                    const temp = (f.temperature_c != null) ? Number(f.temperature_c) : 20.0;
                    const hum = (f.relative_humidity != null) ? Number(f.relative_humidity) : 50;
                    const rainMm = (f.precipitation_mm != null) ? Number(f.precipitation_mm) : 0;
                    const pop = (f.precipitation_probability != null) ? Number(f.precipitation_probability) : 0;
                    
                    const windSpd = Math.round(f.wind_speed_kmh || f.wind_speed_10m || 0);
                    const windGust = Math.round(f.wind_gusts_kmh || f.wind_gusts_10m || (windSpd * 1.3));
                    const dewPoint = (f.dew_point_c != null) ? Number(f.dew_point_c) : (f.dew_point_2m != null ? Number(f.dew_point_2m) : (temp - ((100 - hum) / 5)));
                    const dewMargin = (f.dew_point_margin_c != null) ? Number(f.dew_point_margin_c) : (temp - dewPoint);
                    
                    const isRain = rainMm >= min_rain;
                    const isProbWarning = (pop >= 50) && !isRain;
                    const isHumid = hum > max_hum;
                    const isDewRisk = dewMargin < 3.0;
                    const isGustCritical = windGust > 40;
                    const isGustWarning = windGust > 25 && !isGustCritical;
                    const isCuring = item.is_curing;
                    const isActive = item.is_active_work;

                    let rowBg = 'bg-[var(--w-s1)] border-[var(--w-bd)] text-[var(--w-t2)]';
                    if (isRain) {
                        rowBg = 'bg-[var(--w-rust)]/15 border-[var(--w-rust)]/40 text-[var(--w-t1)] font-semibold';
                    } else if (isDewRisk && (isActive || isCuring)) {
                        rowBg = 'bg-[var(--w-amber)]/15 border-[var(--w-amber)]/40 text-[var(--w-t1)]';
                    } else if (isHumid) {
                        rowBg = 'bg-[var(--w-warn)]/15 border-[var(--w-warn)]/40 text-[var(--w-t1)]';
                    } else if (isProbWarning) {
                        rowBg = 'bg-[var(--w-warn)]/10 border-[var(--w-warn)]/30 text-[var(--w-t1)]';
                    } else if (isActive) {
                        rowBg = 'bg-[var(--w-amber)]/10 border-[var(--w-amber)]/30 text-[var(--w-t1)]';
                    } else if (isCuring) {
                        rowBg = 'bg-[var(--w-sky)]/10 border-[var(--w-sky)]/30 text-[var(--w-t1)]';
                    }

                    const marginSign = dewMargin >= 0 ? '+' : '';
                %>
                <div class="flex items-center justify-between gap-1 px-2 py-1 rounded-lg border text-[10px] transition-colors <%= rowBg %>">
                    <!-- 1. Hora + Fase -->
                    <div class="flex items-center gap-1 w-20 shrink-0 font-mono-jb text-[10px]">
                        <span class="font-bold text-[var(--w-t1)]"><%= hLabel %></span>
                        <% if (item.phase_label || item.phase) { %>
                            <% const p = item.phase || (item.phase_label === 'WORK' ? 'WORK' : (item.phase_label === 'SETUP' ? 'SETUP' : (item.phase_label === 'TEARDOWN' ? 'TEARDOWN' : 'CURING'))); %>
                            <% if (p === 'WORK' || p === 'TRABAJO') { %>
                                <span class="text-[8px] font-bold bg-[var(--w-amber)]/20 text-[var(--w-amber-hi)] border border-[var(--w-amber)]/30 px-1 rounded uppercase">TRAB</span>
                            <% } else if (p === 'SETUP' || p === 'PREP') { %>
                                <span class="text-[8px] font-bold bg-[var(--w-amber)]/20 text-[var(--w-amber-hi)] border border-[var(--w-amber)]/30 px-1 rounded uppercase">PREP</span>
                            <% } else if (p === 'TEARDOWN' || p === 'CIERRE') { %>
                                <span class="text-[8px] font-bold bg-[var(--w-sky)]/20 text-[var(--w-sky)] border border-[var(--w-sky)]/30 px-1 rounded uppercase">CIER</span>
                            <% } else if (p === 'CURING' || p === 'CURADO') { %>
                                <span class="text-[8px] font-bold bg-[var(--w-sky)]/20 text-[var(--w-sky)] border border-[var(--w-sky)]/30 px-1 rounded uppercase">CURA</span>
                            <% } %>
                        <% } %>
                    </div>

                    <!-- 2. Temp + Humedad -->
                    <div class="flex items-center justify-end gap-1.5 w-20 text-right shrink-0 font-mono-jb text-[10px]">
                        <span class="font-medium text-[var(--w-t1)]"><%= temp.toFixed(1) %>°</span>
                        <span class="font-medium <%= isHumid ? 'text-[var(--w-warn)] font-bold' : 'text-[var(--w-sky)]' %>">
                            💧<%= Math.round(hum) %>%
                        </span>
                    </div>

                    <!-- 3. Viento -->
                    <div class="w-14 text-center shrink-0 font-mono-jb text-[10px] <%= isGustCritical ? 'text-[var(--w-rust)] font-bold' : (isGustWarning ? 'text-[var(--w-amber)] font-medium' : 'text-[var(--w-t2)]') %>" title="Viento: <%= windSpd %> km/h | Ráfagas: <%= windGust %> km/h">
                        💨<%= windSpd %><span class="text-[9px] opacity-75">(<%= windGust %>)</span>
                    </div>

                    <!-- 4. ΔT Rocío -->
                    <div class="w-14 text-center shrink-0 font-mono-jb text-[10px]" title="Punto de Rocío: <%= dewPoint.toFixed(1) %>°C | Margen: <%= marginSign %><%= dewMargin.toFixed(1) %>°C">
                        <% if (isDewRisk) { %>
                            <span class="text-[var(--w-amber-hi)] font-semibold bg-[var(--w-amber)]/10 px-0.5 py-0.2 rounded border border-[var(--w-amber)]/20">
                                ⚠️<%= marginSign %><%= dewMargin.toFixed(1) %>°
                            </span>
                        <% } else { %>
                            <span class="text-[var(--w-ok)] font-medium">
                                ✓<%= marginSign %><%= dewMargin.toFixed(1) %>°
                            </span>
                        <% } %>
                    </div>

                    <!-- 5. Lluvia -->
                    <div class="w-12 text-right shrink-0 font-mono-jb text-[10px] <%= (isRain || pop >= 30) ? 'text-[var(--w-rust)] font-bold' : 'text-[var(--w-t2)]' %>">
                        🌧️<%= rainMm.toFixed(1) %>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
<% } %>
