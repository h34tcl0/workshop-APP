<!-- MODAL DE RESCATE DE JORNADAS VENCIDAS PENDIENTES DE CIERRE -->
<div id="overdue-checkins-modal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4 hidden animate-fade-in" role="dialog" aria-modal="true" aria-labelledby="overdue-modal-title">
    <div class="bg-surface border border-amber-500/40 rounded-2xl w-full max-w-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden animate-scale-up">
        
        <!-- HEADER DEL MODAL -->
        <div class="px-5 py-4 border-b border-hairline flex items-center justify-between gap-3 bg-amber-500/10">
            <div class="flex items-center gap-2.5 min-w-0">
                <div class="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5"><use href="#i-alert"/></svg>
                </div>
                <div class="min-w-0">
                    <h3 id="overdue-modal-title" class="font-serif-fraunces text-base sm:text-lg font-bold text-ink truncate">
                        Jornadas Anteriores Pendientes de Cierre
                    </h3>
                    <p class="text-xs text-ink2">
                        Tareas programadas en días previos que quedaron sin resolución.
                    </p>
                </div>
            </div>
            <button type="button" onclick="closeOverdueCheckinsModal()" class="text-ink3 hover:text-ink p-1.5 rounded-lg hover:bg-surface2 transition-colors">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <!-- CONTENIDO: LISTA DE DÍAS PENDIENTES -->
        <div class="p-4 sm:p-5 overflow-y-auto space-y-4 flex-1">
            <% if (locals.overdue_checkins && locals.overdue_checkins.length > 0) { %>
                <p class="text-xs text-ink3 mb-2">
                    Marca las tareas que efectivamente completaste en cada día. Las que no marques volverán al backlog automáticamente para ser reprogramadas en las próximas jornadas viables.
                </p>

                <div class="space-y-3" id="overdue-checkins-list">
                    <% overdue_checkins.forEach(function(dayLog, idx) { %>
                        <div class="border border-hairline rounded-xl bg-surface2/60 p-3.5 space-y-3" id="overdue-card-<%= dayLog.eval_date %>">
                            <div class="flex items-center justify-between gap-2 flex-wrap border-b border-hairline/60 pb-2">
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold text-xs sm:text-sm text-ink font-mono bg-surface px-2 py-0.5 rounded border border-hairline">
                                        📅 <%= dayLog.eval_date %>
                                    </span>
                                    <span class="text-[11px] text-amber-400 font-medium">
                                        <%= (dayLog.tasks || []).length %> tarea(s) agendada(s)
                                    </span>
                                </div>
                                <span class="text-[10.5px] text-ink3">Sin check-in registrado</span>
                            </div>

                            <!-- LISTA DE TAREAS DEL DÍA -->
                            <div class="space-y-1.5" id="overdue-tasks-<%= dayLog.eval_date %>">
                                <% if (dayLog.tasks && dayLog.tasks.length > 0) { %>
                                    <% dayLog.tasks.forEach(function(task) { %>
                                        <label class="flex items-center gap-2.5 p-2 rounded-lg bg-surface border border-hairline/70 hover:border-brass/40 cursor-pointer transition-colors text-xs">
                                            <input type="checkbox" 
                                                   name="task-completed-<%= dayLog.eval_date %>" 
                                                   value="<%= task.id %>" 
                                                   class="w-4 h-4 rounded border-hairline text-brass focus:ring-brass/30">
                                            <span class="flex-1 min-w-0 font-medium text-ink truncate"><%= task.title %></span>
                                            <% if (task.estimated_hours) { %>
                                                <span class="text-[10px] text-ink3 font-mono shrink-0"><%= task.estimated_hours %>h</span>
                                            <% } %>
                                        </label>
                                    <% }); %>
                                <% } else { %>
                                    <p class="text-xs text-ink3 italic">Sin detalle de tareas individuales registrado.</p>
                                <% } %>
                            </div>

                            <!-- ACCIONES POR DÍA -->
                            <div class="flex items-center justify-end gap-2 pt-1">
                                <button type="button" 
                                        onclick="resolveOverdueDay('<%= dayLog.eval_date %>', '<%= dayLog.id %>', false)" 
                                        class="px-2.5 py-1 rounded-lg text-xs font-medium text-ink2 hover:text-ink hover:bg-surface border border-hairline transition-colors">
                                    No se trabajó (reprogramar)
                                </button>
                                <button type="button" 
                                        onclick="resolveOverdueDay('<%= dayLog.eval_date %>', '<%= dayLog.id %>', true)" 
                                        class="px-3 py-1 rounded-lg text-xs font-semibold bg-brass hover:bg-brassdim text-canvas transition-colors flex items-center gap-1 shadow-xs">
                                    <svg class="w-3.5 h-3.5"><use href="#i-check"/></svg>
                                    <span>Guardar y Cerrar Día</span>
                                </button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="text-center py-8 text-ink3 text-sm space-y-2">
                    <svg class="w-10 h-10 mx-auto text-ok/60"><use href="#i-check"/></svg>
                    <p class="font-medium text-ink">No hay jornadas anteriores pendientes de cierre.</p>
                    <p class="text-xs">Todos tus días previos están resueltos y al día.</p>
                </div>
            <% } %>
        </div>

        <!-- FOOTER: ACCIÓN MASIVA -->
        <div class="px-5 py-3.5 border-t border-hairline bg-surface flex items-center justify-between gap-3 flex-wrap">
            <% if (locals.overdue_checkins && locals.overdue_checkins.length > 0) { %>
                <button type="button" 
                        id="btn-resolve-all-overdue" 
                        onclick="resolveAllOverdueDays()" 
                        class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-amber-500/15 hover:bg-amber-500/25 text-amber-400 border border-amber-500/30 transition-all flex items-center gap-1.5 active:scale-95">
                    <svg class="w-4 h-4"><use href="#i-refresh"/></svg>
                    <span>Reprogramar todas las tareas pendientes al backlog</span>
                </button>
            <% } else { %>
                <div></div>
            <% } %>

            <button type="button" 
                    onclick="closeOverdueCheckinsModal()" 
                    class="px-4 py-2 rounded-xl text-xs font-semibold text-ink2 hover:text-ink bg-surface2 hover:bg-hairline transition-colors">
                Cerrar
            </button>
        </div>

    </div>
</div>
