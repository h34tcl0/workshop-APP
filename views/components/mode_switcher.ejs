<!-- GRUPO DE NAVEGACIÓN PRINCIPAL EN HEADER -->
<div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
    <!-- CONMUTADOR SEGMENTADO DE MODOS DE PRIMER NIVEL (Planificación | Taller | Inventario) -->
    <div class="bg-surface2/80 border border-hairline p-1 rounded-xl flex items-center gap-1 shadow-inner shrink-0">
        <button type="button" 
                id="mode-btn-planning" 
                onclick="switchWorkspaceMode('planning')" 
                class="px-3 py-1.5 rounded-lg text-xs font-bold flex items-center gap-1.5 transition-all bg-brass text-canvas shadow-sm">
            <svg class="w-3.5 h-3.5 shrink-0"><use href="#i-calendar"/></svg>
            <span class="hidden sm:inline">Planificación</span>
        </button>
        <button type="button" 
                id="mode-btn-workshop" 
                onclick="switchWorkspaceMode('workshop')" 
                class="px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all text-ink2 hover:text-ink">
            <svg class="w-3.5 h-3.5 shrink-0"><use href="#i-wrench"/></svg>
            <span class="hidden sm:inline">Taller</span>
        </button>
        <button type="button" 
                id="mode-btn-inventory" 
                onclick="switchWorkspaceMode('inventory')" 
                class="px-3 py-1.5 rounded-lg text-xs font-medium flex items-center gap-1.5 transition-all text-ink2 hover:text-ink">
            <svg class="w-3.5 h-3.5 shrink-0"><use href="#i-box"/></svg>
            <span class="hidden sm:inline">Inventario</span>
            <% if (((locals.materials || []).filter(m => m.status === 'to_buy').length > 0) || ((locals.tools || []).filter(t => t.status === 'to_buy' || t.status === 'Por Comprar').length > 0)) { %>
                <span class="w-1.5 h-1.5 rounded-full bg-rust"></span>
            <% } %>
        </button>
    </div>
</div>

<script>
function switchWorkspaceMode(mode) {
    const planningBtn = document.getElementById('mode-btn-planning');
    const workshopBtn = document.getElementById('mode-btn-workshop');
    const inventoryBtn = document.getElementById('mode-btn-inventory');

    const planningContainer = document.getElementById('main-layout-grid');
    const workshopContainer = document.getElementById('workshop-mode-view');
    const materialsView = document.getElementById('materials-view-wrapper');

    if (!planningBtn || !workshopBtn || !inventoryBtn) return;

    // Reset de clases de todos los botones de modo
    [planningBtn, workshopBtn, inventoryBtn].forEach(btn => {
        btn.classList.remove('bg-brass', 'text-canvas', 'shadow-sm', 'font-bold');
        btn.classList.add('text-ink2', 'font-medium');
    });

    // Ocultar todas las vistas principales
    if (planningContainer) planningContainer.classList.add('hidden');
    if (workshopContainer) workshopContainer.classList.add('hidden');
    if (materialsView) materialsView.classList.add('hidden');

    if (mode === 'workshop') {
        workshopBtn.classList.add('bg-brass', 'text-canvas', 'shadow-sm', 'font-bold');
        workshopBtn.classList.remove('text-ink2', 'font-medium');

        if (workshopContainer) workshopContainer.classList.remove('hidden');

        localStorage.setItem('agendapp_workspace_mode', 'workshop');
    } else if (mode === 'inventory') {
        inventoryBtn.classList.add('bg-brass', 'text-canvas', 'shadow-sm', 'font-bold');
        inventoryBtn.classList.remove('text-ink2', 'font-medium');

        if (materialsView) materialsView.classList.remove('hidden');

        localStorage.setItem('agendapp_workspace_mode', 'inventory');
    } else {
        // Por defecto: 'planning'
        planningBtn.classList.add('bg-brass', 'text-canvas', 'shadow-sm', 'font-bold');
        planningBtn.classList.remove('text-ink2', 'font-medium');

        if (planningContainer) planningContainer.classList.remove('hidden');

        localStorage.setItem('agendapp_workspace_mode', 'planning');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const savedMode = localStorage.getItem('agendapp_workspace_mode');
    const savedSubtab = localStorage.getItem('agendapp_planning_subtab'); // compatibilidad previa

    if (savedMode === 'workshop') {
        switchWorkspaceMode('workshop');
    } else if (savedMode === 'inventory' || savedSubtab === 'materials') {
        switchWorkspaceMode('inventory');
    } else {
        switchWorkspaceMode('planning');
    }
});

// Exponer en window para acceso global si se requiere
if (typeof window !== 'undefined') {
    window.switchWorkspaceMode = switchWorkspaceMode;
}
</script>
