<!-- 4. CONTENEDOR: TAB HISTORIAL (ÚLTIMOS 7 DÍAS) -->
<div id="content-tab-history" class="main-tab-content hidden space-y-3">
    <div class="bg-surface border border-hairline rounded-2xl p-4 shadow-panel space-y-3">
        <div class="flex items-center justify-between border-b border-hairline/60 pb-2.5">
            <span class="text-xs font-semibold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-moss"><use href="#i-check"/></svg>
                Tareas completadas recientemente
            </span>
            <span class="text-[11px] font-mono text-ink3 bg-surface2 border border-hairline px-2 py-0.5 rounded-full">
                <%= (completed_history || []).length %>
            </span>
        </div>

        <% if (completed_history && completed_history.length > 0) { %>
        <div class="divide-y divide-hairline max-h-96 overflow-y-auto pr-1 space-y-1">
            <% completed_history.forEach(function(t) { %>
            <div class="flex items-center justify-between gap-2 py-2.5">
                <div class="min-w-0">
                    <p class="text-xs font-medium text-ink truncate"><%= t.title %></p>
                    <p class="text-[10px] text-ink3 font-mono"><%= t.completed_at ? new Date(t.completed_at).toLocaleString('es-ES') : '' %></p>
                </div>
                <span class="text-[11px] font-mono text-moss shrink-0"><%= t.estimated_hours %>h</span>
            </div>
            <% }); %>
        </div>
        <% } else { %>
        <p class="py-4 text-xs text-ink3 text-center">Todavía no hay tareas completadas en los últimos 7 días.</p>
        <% } %>
    </div>
</div>
