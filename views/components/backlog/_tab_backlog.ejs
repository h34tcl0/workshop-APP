<!-- 1. CONTENEDOR: TAB BACKLOG (TAREAS ACTIVAS) -->
<div id="content-tab-backlog" class="main-tab-content space-y-3">
    <!-- Acciones Rápidas: Botón Nueva Tarea (Abre Drawer) + Modo Importar IA -->
    <div class="flex items-center justify-between gap-2">
        <button type="button" 
                onclick="openAddTaskDrawer()" 
                class="flex-1 flex items-center justify-center gap-2 bg-brass hover:bg-brassdim text-canvas font-semibold py-2.5 px-4 rounded-xl text-xs transition-colors shadow-xs">
            <svg class="w-4 h-4"><use href="#i-plus"/></svg>
            <span>Nueva tarea</span>
        </button>
        <button type="button" 
                onclick="openImportJsonDrawer()" 
                title="Importar tareas generadas por Inteligencia Artificial (JSON)"
                class="flex items-center justify-center gap-1.5 bg-surface hover:bg-surface2 text-ink2 hover:text-ink border border-hairline font-medium py-2.5 px-3 rounded-xl text-xs transition-colors shrink-0">
            <svg class="w-3.5 h-3.5 text-chalk"><use href="#i-import"/></svg>
            <span class="hidden sm:inline">Importar JSON</span>
        </button>
    </div>

    <!-- LISTA DE TAREAS REORDENABLES CON DRAG HANDLE -->
    <div id="backlog-task-list" class="space-y-2">
        <% if (tasks && tasks.length > 0) { %>
        <% tasks.forEach(function(task, index) { 
            const projColor = (typeof all_projects !== 'undefined' && all_projects && task.project_id) 
                ? (all_projects.find(p => p.id === task.project_id)?.color || null) 
                : (task.project_color || null);
            const projName = (typeof all_projects !== 'undefined' && all_projects && task.project_id)
                ? (all_projects.find(p => p.id === task.project_id)?.name || 'Proyecto')
                : 'Proyecto';
        %>
        <div class="task-card group bg-surface border border-hairline hover:border-hairline/80 rounded-xl overflow-hidden shadow-xs transition-all cursor-grab active:cursor-grabbing select-none" data-task-id="<%= task.id %>" data-id="<%= task.id %>">
            <div class="p-3 flex items-center gap-2.5">
                <!-- Drag Handle Grip Icon -->
                <div class="drag-handle text-ink3 group-hover:text-brass p-1 rounded transition-colors shrink-0" title="Arrastrar para reordenar">
                    <svg class="w-4 h-4"><use href="#i-grip"/></svg>
                </div>

                <!-- Project Color Dot (Organic) -->
                <% if (projColor) { %>
                    <span class="w-2.5 h-2.5 rounded-full shrink-0 shadow-xs" style="background-color: <%= projColor %>;" title="Proyecto: <%= projName %>"></span>
                <% } else { %>
                    <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-brass/60" title="Backlog general"></span>
                <% } %>

                <!-- Información de la Tarea -->
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                        <span class="text-[10px] font-mono font-bold text-brass shrink-0">#<%= index + 1 %></span>
                        <h4 class="text-xs font-semibold text-ink truncate"><%= task.title %></h4>
                    </div>
                    <div class="flex items-center gap-2 text-[10px] font-mono text-ink3">
                        <span class="text-ink2 font-medium"><%= task.estimated_hours %>h activas</span>
                        <% if (task.curing_hours > 0) { %>
                            <span>•</span>
                            <span class="text-chalk font-medium"><%= task.curing_hours %>h curado</span>
                        <% } %>
                        <% if (task.category) { %>
                            <span>•</span>
                            <span class="capitalize text-brass/90"><%= category_labels[task.category] || task.category %></span>
                        <% } %>
                    </div>
                </div>

                <!-- Acciones: Editar / Eliminar -->
                <div class="flex items-center gap-1 shrink-0">
                    <button type="button" onclick="toggleEditTask(<%= task.id %>)" aria-label="Editar tiempos" class="w-8 h-8 rounded-lg bg-surface2 hover:bg-hairline text-ink2 hover:text-ink flex items-center justify-center transition-colors">
                        <svg class="w-3.5 h-3.5"><use href="#i-edit"/></svg>
                    </button>
                    <form action="/tasks/<%= task.id %>/delete" method="post" onsubmit="return handleTaskDelete(event, '<%= task.id %>', '<%= task.title.replace(/'/g, "\\'") %>')">
                        <button type="submit" aria-label="Eliminar tarea" class="w-8 h-8 rounded-lg bg-rust/10 hover:bg-rust/20 text-rust flex items-center justify-center transition-colors">
                            <svg class="w-3.5 h-3.5"><use href="#i-close"/></svg>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Panel inline de edición de tiempos -->
            <div id="edit-task-<%= task.id %>" class="hidden border-t border-hairline bg-surface2/40 p-3.5">
                <form action="/tasks/<%= task.id %>/update" method="post" class="space-y-3">
                    <div>
                        <label class="block text-[10px] font-semibold text-ink3 mb-1 uppercase tracking-wide">Título</label>
                        <input type="text" name="title" value="<%= task.title %>" required class="w-full bg-surface border border-hairline text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-brass transition-colors">
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                        <div>
                            <label class="block text-[10px] font-semibold text-ink3 mb-1 uppercase tracking-wide">Categoría</label>
                            <select name="category" required class="w-full bg-surface border border-hairline text-ink rounded-lg px-2 py-2 text-xs focus:outline-none focus:border-brass cursor-pointer transition-colors">
                                <option value="carpentry" <%= task.category === 'carpentry' ? 'selected' : '' %>>Carpintería</option>
                                <option value="pva_glue" <%= task.category === 'pva_glue' ? 'selected' : '' %>>Encolado PVA</option>
                                <option value="varnish_paint" <%= task.category === 'varnish_paint' ? 'selected' : '' %>>Barnizado</option>
                                <option value="epoxy" <%= task.category === 'epoxy' ? 'selected' : '' %>>Epoxi / Resina</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-semibold text-ink3 mb-1 uppercase tracking-wide">Horas activas</label>
                            <input type="number" step="0.5" min="0.5" name="estimated_hours" value="<%= task.estimated_hours %>" required class="w-full bg-surface border border-hairline text-ink rounded-lg px-2 py-2 text-xs focus:outline-none focus:border-brass transition-colors">
                        </div>
                        <div>
                            <label class="block text-[10px] font-semibold text-ink3 mb-1 uppercase tracking-wide">Horas curado</label>
                            <input type="number" step="0.5" min="0.0" name="curing_hours" value="<%= task.curing_hours %>" required class="w-full bg-surface border border-hairline text-ink rounded-lg px-2 py-2 text-xs focus:outline-none focus:border-brass transition-colors">
                        </div>
                    </div>
                    <div class="flex items-center gap-2 pt-0.5">
                        <input type="checkbox" id="edit-curing-is-blocking-<%= task.id %>" name="curing_is_blocking" value="true" <%= task.curing_is_blocking !== false ? 'checked' : '' %> class="w-3.5 h-3.5 text-brass rounded border-hairline focus:ring-brass bg-surface2">
                        <label for="edit-curing-is-blocking-<%= task.id %>" class="text-[11px] text-ink2 select-none cursor-pointer">
                            Curado vinculante / bloqueante (desmarca para curado en paralelo)
                        </label>
                    </div>
                    <div class="flex items-center gap-2 pt-1">
                        <button type="button" onclick="toggleEditTask(<%= task.id %>)" class="flex-1 bg-surface hover:bg-hairline text-ink2 font-semibold py-2 rounded-lg text-xs transition-colors">Cancelar</button>
                        <button type="submit" class="flex-1 bg-brass hover:bg-brassdim text-canvas font-semibold py-2 rounded-lg text-xs transition-colors">Guardar cambios</button>
                    </div>
                </form>
                <form action="/tasks/<%= task.id %>/update_status" method="post" onsubmit="submitTaskUpdateStatusForm(event)" class="mt-2">
                    <input type="hidden" name="status" value="completed"><input type="hidden" name="progress" value="100">
                    <button type="submit" class="w-full flex items-center justify-center gap-1.5 bg-moss/10 hover:bg-moss/20 text-moss font-semibold py-2 rounded-lg text-xs transition-colors">
                        <svg class="w-3.5 h-3.5"><use href="#i-check"/></svg> Marcar como completada
                    </button>
                </form>
            </div>
        </div>
        <% }); %>
        <% } else { %>
        <div class="p-6 text-center border border-dashed border-hairline rounded-2xl bg-surface/40 space-y-2">
            <p class="text-xs text-ink3">No hay tareas pendientes en el backlog activo.</p>
            <button type="button" onclick="openAddTaskDrawer()" class="text-xs font-semibold text-brass hover:underline">
                + Crear la primera tarea
            </button>
        </div>
        <% } %>
    </div>
</div>
