async function refreshMaterialsView() {
    try {
        await reloadInventoryData();
        const res = await fetch(window.location.href);
        if (res.ok) {
            const html = await res.text();
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            const newWrapper = doc.getElementById('materials-view-wrapper');
            const oldWrapper = document.getElementById('materials-view-wrapper');
            if (newWrapper && oldWrapper) {
                oldWrapper.innerHTML = newWrapper.innerHTML;
            } else {
                const newContainer = doc.getElementById('materials-module-container');
                const oldContainer = document.getElementById('materials-module-container');
                if (newContainer && oldContainer) {
                    oldContainer.innerHTML = newContainer.innerHTML;
                }
            }
            if (typeof activeInventorySubtab !== 'undefined' && typeof switchInventoryTab === 'function') {
                switchInventoryTab(activeInventorySubtab);
            }
        }
    } catch (e) {
        console.error('Error refreshing materials view:', e);
    }
}

