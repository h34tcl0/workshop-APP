<!-- MÓDULO DE GESTIÓN DE MATERIALES -->
<div id="materials-module-container" class="space-y-6">
    <!-- HEADER DE MATERIALES Y MÉTRICAS -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-surface border border-hairline rounded-2xl p-5 shadow-panel">
        <div>
            <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono font-semibold tracking-widest text-brass uppercase">LOGÍSTICA E INSUMOS</span>
            </div>
            <h2 class="font-display text-xl font-bold text-ink mt-1 flex items-center gap-2">
                <svg class="w-5 h-5 text-brass"><use href="#i-box"/></svg>
                Gestión de Materiales e Insumos
            </h2>
            <p class="text-xs text-ink2 mt-0.5">Control de inventario, lista de compras y checklist por proyecto</p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            <button type="button" onclick="openImportMaterialsModal()" class="flex items-center gap-1.5 bg-surface2 hover:bg-hairline text-ink border border-hairline px-3.5 py-2 rounded-xl text-xs font-semibold transition-colors">
                <svg class="w-4 h-4 text-chalk"><use href="#i-import"/></svg> Importar JSON
            </button>
            <button type="button" onclick="toggleAddMaterialForm()" class="flex items-center gap-1.5 bg-brass hover:bg-brassdim text-canvas px-4 py-2 rounded-xl text-xs font-bold transition-colors shadow-sm">
                <svg class="w-4 h-4"><use href="#i-plus"/></svg> Nuevo Material
            </button>
        </div>
    </div>

    <!-- MÉTRICAS DE MATERIALES -->
    <%
      const allMats = locals.materials || [];
      const toBuyCount = allMats.filter(m => m.status === 'to_buy').length;
      const inStockCount = allMats.filter(m => m.status === 'in_stock').length;
    %>
    <div class="grid grid-cols-3 gap-3">
        <div class="bg-surface border border-hairline rounded-xl p-3.5 sm:p-4 text-center">
            <span class="block text-[10px] sm:text-xs font-semibold text-ink3 uppercase tracking-wider">Total Registrados</span>
            <span class="block text-xl sm:text-2xl font-bold font-mono text-ink mt-0.5"><%= allMats.length %></span>
        </div>
        <div class="bg-surface border border-rust/30 bg-rust/5 rounded-xl p-3.5 sm:p-4 text-center">
            <span class="block text-[10px] sm:text-xs font-semibold text-rust uppercase tracking-wider flex items-center justify-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-rust"></span> Por Comprar
            </span>
            <span class="block text-xl sm:text-2xl font-bold font-mono text-rust mt-0.5" id="mat-to-buy-count"><%= toBuyCount %></span>
        </div>
        <div class="bg-surface border border-moss/30 bg-moss/5 rounded-xl p-3.5 sm:p-4 text-center">
            <span class="block text-[10px] sm:text-xs font-semibold text-moss uppercase tracking-wider flex items-center justify-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-moss"></span> En Taller
            </span>
            <span class="block text-xl sm:text-2xl font-bold font-mono text-moss mt-0.5" id="mat-in-stock-count"><%= inStockCount %></span>
        </div>
    </div>

    <!-- FORMULARIO NUEVO MATERIAL (OCULTO POR DEFECTO) -->
    <div id="add-material-form-card" class="hidden bg-surface border border-brass/40 rounded-2xl p-5 shadow-panel space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-brass"><use href="#i-plus"/></svg> Agregar Material al Proyecto
            </h3>
            <button type="button" onclick="toggleAddMaterialForm()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <form action="/materials/add" method="post" id="add-material-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Proyecto</label>
                    <select name="project_id" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                        <% (locals.all_projects || []).forEach(p => { %>
                            <option value="<%= p.id %>" <%= p.is_active ? 'selected' : '' %>><%= p.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Nombre del Material / Insumo</label>
                    <input type="text" name="name" required placeholder="Ej. Listones Roble 2x4 3.2m, Bisagras Cazoleta" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Cantidad</label>
                    <input type="number" step="0.1" min="0.1" name="quantity" value="1" required class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-mono">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Unidad</label>
                    <select name="unit" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                        <option value="unidades">unidades</option>
                        <option value="piezas">piezas</option>
                        <option value="mm">mm</option>
                        <option value="mts">mts</option>
                        <option value="m2">m²</option>
                        <option value="kg">kg</option>
                        <option value="litros">litros</option>
                        <option value="kits">kits</option>
                        <option value="pares">pares</option>
                        <option value="cajas">cajas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Categoría</label>
                    <select name="category" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                        <option value="Madera">Madera</option>
                        <option value="Tornillería">Tornillería</option>
                        <option value="Adhesivos/Barniz">Adhesivos / Barniz</option>
                        <option value="Insumos">Insumos</option>
                        <option value="Herrajes">Herrajes</option>
                        <option value="Placas/Tableros">Placas / Tableros</option>
                        <option value="General">General</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Estado Inicial</label>
                    <select name="status" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-semibold">
                        <option value="to_buy" selected class="text-rust">Por Comprar</option>
                        <option value="in_stock" class="text-moss">En Taller</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="toggleAddMaterialForm()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink">Cancelar</button>
                <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Guardar Material</button>
            </div>
        </form>
    </div>

    <!-- BARRA DE FILTROS Y CONTROLES -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-surface border border-hairline rounded-xl p-3">
        <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0">
            <button type="button" onclick="filterMaterials('all')" id="mat-filter-all" class="mat-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-brass text-canvas">
                Todos (<%= allMats.length %>)
            </button>
            <button type="button" onclick="filterMaterials('to_buy')" id="mat-filter-to_buy" class="mat-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-surface2 text-ink2 hover:text-ink border border-hairline flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-rust"></span> Por Comprar (<%= toBuyCount %>)
            </button>
            <button type="button" onclick="filterMaterials('in_stock')" id="mat-filter-in_stock" class="mat-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-surface2 text-ink2 hover:text-ink border border-hairline flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-moss"></span> En Taller (<%= inStockCount %>)
            </button>
        </div>

        <div class="relative min-w-[200px]">
            <svg class="w-4 h-4 absolute left-3 top-2.5 text-ink3"><use href="#i-search"/></svg>
            <input type="text" id="material-search-input" onkeyup="searchMaterials()" placeholder="Buscar material o categoría..." class="w-full bg-surface2 border border-hairline text-ink rounded-lg pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:border-brass">
        </div>
    </div>

    <!-- LISTA CHECKLIST DE MATERIALES -->
    <div class="space-y-3" id="materials-list-container">
        <% if (allMats.length === 0) { %>
            <div class="bg-surface border border-dashed border-hairline rounded-2xl p-8 text-center">
                <div class="w-12 h-12 rounded-full bg-surface2 border border-hairline flex items-center justify-center text-ink3 mx-auto mb-3">
                    <svg class="w-6 h-6"><use href="#i-box"/></svg>
                </div>
                <h3 class="font-display text-base font-semibold text-ink">No hay materiales registrados</h3>
                <p class="text-xs text-ink3 mt-1 max-w-md mx-auto">Agrega tus insumos manualmente o importa una lista en formato JSON para llevar el control de compras de tu taller.</p>
                <div class="flex items-center justify-center gap-3 mt-4">
                    <button type="button" onclick="toggleAddMaterialForm()" class="bg-brass text-canvas px-4 py-2 rounded-xl text-xs font-bold">Agregar Material</button>
                    <button type="button" onclick="openImportMaterialsModal()" class="bg-surface2 text-ink border border-hairline px-4 py-2 rounded-xl text-xs font-semibold">Importar JSON</button>
                </div>
            </div>
        <% } else { %>
            <% allMats.forEach(mat => { %>
                <div class="material-item-card bg-surface hover:bg-surface2/60 border border-hairline rounded-xl p-4 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-panel"
                     data-status="<%= mat.status %>"
                     data-category="<%= mat.category.toLowerCase() %>"
                     data-name="<%= mat.name.toLowerCase() %>">
                    
                    <div class="flex items-start sm:items-center gap-3 min-w-0">
                        <!-- TOGGLE STATUS BUTTON -->
                        <button type="button" onclick="toggleMaterialStatus(<%= mat.id %>)" 
                                title="Cambiar estado"
                                class="shrink-0 transition-transform active:scale-95 text-xs font-bold px-3 py-2 rounded-xl border flex items-center gap-1.5 shadow-sm min-h-[44px] min-w-[130px] justify-center <%= mat.status === 'to_buy' ? 'bg-rust/10 border-rust/40 text-rust hover:bg-rust/20' : 'bg-moss/10 border-moss/40 text-moss hover:bg-moss/20' %>">
                            <% if (mat.status === 'to_buy') { %>
                                <span class="w-2.5 h-2.5 rounded-full bg-rust animate-pulse"></span>
                                Por Comprar
                            <% } else { %>
                                <svg class="w-3.5 h-3.5"><use href="#i-check"/></svg>
                                En Taller
                            <% } %>
                        </button>

                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h4 class="font-semibold text-sm text-ink <%= mat.status === 'in_stock' ? 'line-through text-ink2' : '' %>">
                                    <%= mat.name %>
                                </h4>
                                <span class="text-[10px] font-mono bg-surface2 border border-hairline text-chalk px-2 py-0.5 rounded-md font-semibold">
                                    <%= mat.quantity %> <%= mat.unit %>
                                </span>
                            </div>
                            <div class="flex items-center gap-2 mt-1 text-[11px] text-ink3">
                                <span class="font-medium bg-surface2/80 px-2 py-0.5 rounded border border-hairline/60"><%= mat.category %></span>
                                <% if (mat.project_name) { %>
                                    <span>• Proyecto: <strong class="text-ink2"><%= mat.project_name %></strong></span>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- ACCIONES DE MATERIAL -->
                    <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
                        <button type="button" onclick="deleteMaterial(<%= mat.id %>)" title="Eliminar material" class="p-2 text-ink3 hover:text-rust rounded-lg hover:bg-surface2 transition-colors">
                            <svg class="w-4 h-4"><use href="#i-close"/></svg>
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } %>
    </div>
</div>

<!-- MODAL IMPORTAR MATERIALES JSON -->
<div id="import-materials-modal" class="fixed inset-0 bg-canvas/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-surface border border-hairline rounded-2xl w-full max-w-lg p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-lg font-bold text-ink flex items-center gap-2">
                <svg class="w-5 h-5 text-chalk"><use href="#i-import"/></svg>
                Importar Lista de Materiales (JSON)
            </h3>
            <button type="button" onclick="closeImportMaterialsModal()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <p class="text-xs text-ink2">Pega la estructura JSON con tus materiales o selecciona un proyecto para vincular los insumos.</p>

        <form action="/materials/import" method="post" id="import-materials-form" class="space-y-4">
            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Proyecto Destino</label>
                <select name="project_id" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-brass">
                    <% (locals.all_projects || []).forEach(p => { %>
                        <option value="<%= p.id %>" <%= p.is_active ? 'selected' : '' %>><%= p.name %></option>
                    <% }); %>
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Contenido JSON</label>
                <textarea name="json_data" rows="8" placeholder='[
  { "name": "Resina Epoxi Kit 1kg", "quantity": 2, "unit": "kits", "category": "Adhesivos/Barniz", "status": "to_buy" },
  { "name": "Listón Pino 2x2", "quantity": 10, "unit": "piezas", "category": "Madera", "status": "in_stock" }
]' class="w-full bg-surface2 border border-hairline font-mono text-xs text-ink rounded-lg p-3 focus:outline-none focus:border-brass leading-relaxed"></textarea>
            </div>

            <div class="flex items-center justify-between pt-2">
                <button type="button" onclick="loadExampleMaterialsJson()" class="text-xs text-brass hover:underline font-medium">Cargar Ejemplo</button>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="closeImportMaterialsModal()" class="px-4 py-2 text-xs font-semibold text-ink2">Cancelar</button>
                    <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Importar Insumos</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
function toggleAddMaterialForm() {
    const card = document.getElementById('add-material-form-card');
    if (card) card.classList.toggle('hidden');
}

function openImportMaterialsModal() {
    const modal = document.getElementById('import-materials-modal');
    if (modal) modal.classList.remove('hidden');
}

function closeImportMaterialsModal() {
    const modal = document.getElementById('import-materials-modal');
    if (modal) modal.classList.add('hidden');
}

function loadExampleMaterialsJson() {
    const textarea = document.querySelector('#import-materials-modal textarea[name="json_data"]');
    if (textarea) {
        textarea.value = JSON.stringify([
            { "name": "Plancha Terciado Estructural 18mm", "quantity": 3, "unit": "piezas", "category": "Placas/Tableros", "status": "to_buy" },
            { "name": "Cola Fría Titebond II 500ml", "quantity": 1, "unit": "botella", category: "Adhesivos/Barniz", "status": "in_stock" },
            { "name": "Tornillos Drywall 1 5/8", "quantity": 200, "unit": "unidades", "category": "Tornillería", "status": "to_buy" },
            { "name": "Lijas Grano 80 / 120 / 220", "quantity": 6, "unit": "piezas", "category": "Insumos", "status": "to_buy" }
        ], null, 2);
    }
}

async function toggleMaterialStatus(id) {
    try {
        const res = await fetch(`/materials/${id}/toggle`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        });
        if (res.ok) {
            window.location.reload();
        }
    } catch (e) {
        console.error('Error toggling status:', e);
    }
}

async function deleteMaterial(id) {
    if (!confirm('¿Seguro que deseas eliminar este material?')) return;
    try {
        const res = await fetch(`/materials/${id}/delete`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        });
        if (res.ok) {
            window.location.reload();
        }
    } catch (e) {
        console.error('Error deleting material:', e);
    }
}

function filterMaterials(status) {
    const items = document.querySelectorAll('.material-item-card');
    document.querySelectorAll('.mat-filter-btn').forEach(btn => {
        btn.classList.remove('bg-brass', 'text-canvas');
        btn.classList.add('bg-surface2', 'text-ink2');
    });

    const activeBtn = document.getElementById(`mat-filter-${status}`);
    if (activeBtn) {
        activeBtn.classList.remove('bg-surface2', 'text-ink2');
        activeBtn.classList.add('bg-brass', 'text-canvas');
    }

    items.forEach(item => {
        const itemStatus = item.getAttribute('data-status');
        if (status === 'all' || itemStatus === status) {
            item.style.display = 'flex';
        } else {
            item.style.display = 'none';
        }
    });
}

function searchMaterials() {
    const query = document.getElementById('material-search-input').value.toLowerCase().trim();
    const items = document.querySelectorAll('.material-item-card');

    items.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const cat = item.getAttribute('data-category') || '';
        if (name.includes(query) || cat.includes(query)) {
            item.style.display = 'flex';
        } else {
            item.style.display = 'none';
        }
    });
}
</script>
