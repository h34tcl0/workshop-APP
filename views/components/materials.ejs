<script>
// RAW DATA FOR CLIENT-SIDE FILTERING & AI EXPORT
const rawMaterialsData = <%- JSON.stringify(locals.materials || []) %>;
const rawToolsData = <%- JSON.stringify(locals.tools || []) %>;

// TABS SWITCHING
function switchInventoryTab(tab) {
    const matPanel = document.getElementById('materials-subpanel');
    const toolPanel = document.getElementById('tools-subpanel');
    const buttons = document.querySelectorAll('.inv-tab-btn');

    buttons.forEach(b => {
        b.classList.remove('bg-brass', 'text-canvas', 'shadow-sm');
        b.classList.add('text-ink2');
    });

    const activeBtn = document.getElementById(`inv-tab-${tab}`);
    if (activeBtn) {
        activeBtn.classList.remove('text-ink2');
        activeBtn.classList.add('bg-brass', 'text-canvas', 'shadow-sm');
    }

    if (tab === 'materials') {
        if (matPanel) matPanel.classList.remove('hidden');
        if (toolPanel) toolPanel.classList.add('hidden');
    } else if (tab === 'tools') {
        if (matPanel) matPanel.classList.add('hidden');
        if (toolPanel) toolPanel.classList.remove('hidden');
    } else {
        if (matPanel) matPanel.classList.remove('hidden');
        if (toolPanel) toolPanel.classList.remove('hidden');
    }
}

// TOGGLE FORM CARDS
function toggleAddMaterialForm() {
    const card = document.getElementById('add-material-form-card');
    const err = document.getElementById('add-material-error');
    if (err) { err.classList.add('hidden'); err.textContent = ''; }
    if (card) card.classList.toggle('hidden');
}

function toggleAddToolForm() {
    const card = document.getElementById('add-tool-form-card');
    const err = document.getElementById('add-tool-error');
    if (err) { err.classList.add('hidden'); err.textContent = ''; }
    if (card) card.classList.toggle('hidden');
}

async function submitAddMaterialForm(e) {
    e.preventDefault();
    const form = e.target;
    const errorContainer = document.getElementById('add-material-error');
    if (errorContainer) {
        errorContainer.classList.add('hidden');
        errorContainer.textContent = '';
    }

    const formData = new FormData(form);
    const data = {
        project_id: formData.get('project_id'),
        name: formData.get('name'),
        quantity: formData.get('quantity'),
        unit: formData.get('unit'),
        category: formData.get('category'),
        status: formData.get('status')
    };

    try {
        const res = await fetch('/materials/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            },
            body: JSON.stringify(data)
        });

        const result = await res.json().catch(() => ({}));

        if (res.ok && result.success) {
            form.reset();
            // Asegurar que la subtab se mantenga en 'materials'
            localStorage.setItem('agendapp_planning_subtab', 'materials');
            window.location.reload();
        } else {
            const errorMsg = result.error || 'Error al guardar el material';
            if (errorContainer) {
                errorContainer.textContent = '⚠️ ' + errorMsg;
                errorContainer.classList.remove('hidden');
            } else {
                alert(errorMsg);
            }
        }
    } catch (err) {
        console.error('Error adding material:', err);
        if (errorContainer) {
            errorContainer.textContent = '⚠️ Error de conexión al guardar el material.';
            errorContainer.classList.remove('hidden');
        } else {
            alert('Error de conexión al guardar el material.');
        }
    }
}

async function submitAddToolForm(e) {
    e.preventDefault();
    const form = e.target;
    const errorContainer = document.getElementById('add-tool-error');
    if (errorContainer) {
        errorContainer.classList.add('hidden');
        errorContainer.textContent = '';
    }

    const formData = new FormData(form);
    const data = {
        name: formData.get('name'),
        category: formData.get('category'),
        status: formData.get('status'),
        notes: formData.get('notes')
    };

    try {
        const res = await fetch('/tools/add', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            },
            body: JSON.stringify(data)
        });

        const result = await res.json().catch(() => ({}));

        if (res.ok && result.success) {
            form.reset();
            localStorage.setItem('agendapp_planning_subtab', 'materials');
            window.location.reload();
        } else {
            const errorMsg = result.error || 'Error al registrar la herramienta';
            if (errorContainer) {
                errorContainer.textContent = '⚠️ ' + errorMsg;
                errorContainer.classList.remove('hidden');
            } else {
                alert(errorMsg);
            }
        }
    } catch (err) {
        console.error('Error adding tool:', err);
        if (errorContainer) {
            errorContainer.textContent = '⚠️ Error de conexión al guardar la herramienta.';
            errorContainer.classList.remove('hidden');
        } else {
            alert('Error de conexión al guardar la herramienta.');
        }
    }
}

function openImportMaterialsModal() {
    const modal = document.getElementById('import-materials-modal');
    if (modal) modal.classList.remove('hidden');
}

function closeImportMaterialsModal() {
    const modal = document.getElementById('import-materials-modal');
    if (modal) modal.classList.add('hidden');
}

function loadExampleMaterialsJson() {
    const textarea = document.querySelector('#import-materials-modal textarea[name="json_data"]');
    if (textarea) {
        textarea.value = JSON.stringify([
            { "name": "Plancha Terciado Estructural 18mm", "quantity": 3, "unit": "piezas", "category": "Placas/Tableros", "status": "to_buy" },
            { "name": "Cola Fría Titebond II 500ml", "quantity": 1, "unit": "botella", "category": "Adhesivos/Barniz", "status": "in_stock" },
            { "name": "Tornillos Drywall 1 5/8", "quantity": 200, "unit": "unidades", "category": "Tornillería", "status": "to_buy" },
            { "name": "Lijas Grano 80 / 120 / 220", "quantity": 6, "unit": "piezas", "category": "Insumos", "status": "to_buy" }
        ], null, 2);
    }
}

// DIRECT STATUS UPDATES
async function updateMaterialStatusDirect(id, status) {
    try {
        const res = await fetch(`/materials/${id}/set-status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: JSON.stringify({ status })
        });
        if (res.ok) window.location.reload();
    } catch (e) {
        console.error('Error setting material status:', e);
    }
}

async function updateToolStatusDirect(id, status) {
    try {
        const res = await fetch(`/tools/${id}/set-status`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: JSON.stringify({ status })
        });
        if (res.ok) window.location.reload();
    } catch (e) {
        console.error('Error setting tool status:', e);
    }
}

async function deleteMaterial(id) {
    if (!confirm('¿Seguro que deseas eliminar este material?')) return;
    try {
        const res = await fetch(`/materials/${id}/delete`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        });
        if (res.ok) window.location.reload();
    } catch (e) {
        console.error('Error deleting material:', e);
    }
}

async function deleteTool(id) {
    if (!confirm('¿Seguro que deseas eliminar esta herramienta del registro?')) return;
    try {
        const res = await fetch(`/tools/${id}/delete`, {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        });
        if (res.ok) window.location.reload();
    } catch (e) {
        console.error('Error deleting tool:', e);
    }
}

// EDIT MATERIAL MODAL
function openEditMaterialModal(mat) {
    document.getElementById('edit-mat-id').value = mat.id;
    document.getElementById('edit-mat-name').value = mat.name;
    document.getElementById('edit-mat-quantity').value = mat.quantity;
    document.getElementById('edit-mat-unit').value = mat.unit || 'unidades';
    document.getElementById('edit-mat-category').value = mat.category || 'General';
    document.getElementById('edit-mat-status').value = mat.status || 'to_buy';
    if (mat.project_id) {
        document.getElementById('edit-mat-project').value = mat.project_id;
    }
    document.getElementById('edit-material-modal').classList.remove('hidden');
}

function closeEditMaterialModal() {
    document.getElementById('edit-material-modal').classList.add('hidden');
}

async function submitEditMaterialForm(e) {
    e.preventDefault();
    const id = document.getElementById('edit-mat-id').value;
    const data = {
        name: document.getElementById('edit-mat-name').value,
        quantity: document.getElementById('edit-mat-quantity').value,
        unit: document.getElementById('edit-mat-unit').value,
        category: document.getElementById('edit-mat-category').value,
        status: document.getElementById('edit-mat-status').value,
        project_id: document.getElementById('edit-mat-project').value
    };

    try {
        const res = await fetch(`/materials/${id}/update`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: JSON.stringify(data)
        });
        if (res.ok) window.location.reload();
    } catch (err) {
        console.error('Error editing material:', err);
    }
}

// EDIT TOOL MODAL
function openEditToolModal(tool) {
    document.getElementById('edit-tool-id').value = tool.id;
    document.getElementById('edit-tool-name').value = tool.name;
    document.getElementById('edit-tool-category').value = tool.category || 'Herramientas Manuales';
    document.getElementById('edit-tool-status').value = tool.status || 'available';
    document.getElementById('edit-tool-notes').value = tool.notes || '';
    document.getElementById('edit-tool-modal').classList.remove('hidden');
}

function closeEditToolModal() {
    document.getElementById('edit-tool-modal').classList.add('hidden');
}

async function submitEditToolForm(e) {
    e.preventDefault();
    const id = document.getElementById('edit-tool-id').value;
    const data = {
        name: document.getElementById('edit-tool-name').value,
        category: document.getElementById('edit-tool-category').value,
        status: document.getElementById('edit-tool-status').value,
        notes: document.getElementById('edit-tool-notes').value
    };

    try {
        const res = await fetch(`/tools/${id}/update`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: JSON.stringify(data)
        });
        if (res.ok) window.location.reload();
    } catch (err) {
        console.error('Error editing tool:', err);
    }
}

// FILTERING
function filterInventory() {
    const cat = document.getElementById('inventory-category-filter').value.toLowerCase();
    const query = document.getElementById('inventory-search-input').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.inventory-card');

    cards.forEach(card => {
        const cardCat = card.getAttribute('data-category') || '';
        const cardName = card.getAttribute('data-name') || '';
        const cardNotes = card.getAttribute('data-notes') || '';
        const cardProj = card.getAttribute('data-project') || '';

        const catMatches = cat === 'all' || cardCat.includes(cat);
        const searchMatches = !query || cardName.includes(query) || cardCat.includes(query) || cardNotes.includes(query) || cardProj.includes(query);

        if (catMatches && searchMatches) {
            card.style.display = 'flex';
        } else {
            card.style.display = 'none';
        }
    });
}

// AI EXPORT MODAL
function openAiExportModal() {
    generateAiExportText();
    document.getElementById('ai-export-modal').classList.remove('hidden');
}

function closeAiExportModal() {
    document.getElementById('ai-export-modal').classList.add('hidden');
}

function generateAiExportText() {
    const incTools = document.getElementById('ai-opt-tools')?.checked ?? true;
    const incStock = document.getElementById('ai-opt-stock')?.checked ?? true;
    const incToBuy = document.getElementById('ai-opt-tobuy')?.checked ?? true;

    let txt = `### INVENTARIO TALLER - CONTEXTO PARA PROMPTS IA (WORKSHOP OS)\n\n`;

    if (incTools) {
        txt += `**HERRAMIENTAS EN TALLER (${rawToolsData.length} total):**\n`;
        if (rawToolsData.length > 0) {
            rawToolsData.forEach(t => {
                const st = t.status === 'available' ? '🟢 Disponible' : t.status === 'in_use' ? '🟡 En Uso' : '🔴 Dañada';
                txt += `• ${t.name} [${t.category}] - ${st}${t.notes ? ` (Notas: ${t.notes})` : ''}\n`;
            });
        } else {
            txt += `• Sin herramientas registradas.\n`;
        }
        txt += `\n`;
    }

    if (incStock) {
        const stockMats = rawMaterialsData.filter(m => m.status === 'in_stock');
        txt += `**MATERIALES Y INSUMOS EN STOCK (EN TALLER - ${stockMats.length}):**\n`;
        if (stockMats.length > 0) {
            stockMats.forEach(m => {
                txt += `• ${m.name}: ${m.quantity} ${m.unit} [${m.category}] - 🟢 En Taller (Proyecto: ${m.project_name || 'General'})\n`;
            });
        } else {
            txt += `• Sin materiales en stock.\n`;
        }
        txt += `\n`;
    }

    if (incToBuy) {
        const toBuyMats = rawMaterialsData.filter(m => m.status === 'to_buy' || m.status === 'out_of_stock');
        txt += `**MATERIALES POR COMPRAR / AGOTADOS (${toBuyMats.length}):**\n`;
        if (toBuyMats.length > 0) {
            toBuyMats.forEach(m => {
                const tag = m.status === 'out_of_stock' ? '⚠️ Agotado' : '🔴 Por Comprar';
                txt += `• ${m.name}: ${m.quantity} ${m.unit} [${m.category}] - ${tag}\n`;
            });
        } else {
            txt += `• Sin insumos pendientes por comprar.\n`;
        }
    }

    const textarea = document.getElementById('ai-export-textarea');
    if (textarea) textarea.value = txt;
}

function copyAiExportToClipboard() {
    const textarea = document.getElementById('ai-export-textarea');
    if (!textarea) return;
    textarea.select();
    navigator.clipboard.writeText(textarea.value).then(() => {
        const toast = document.getElementById('ai-copy-toast');
        if (toast) {
            toast.classList.remove('hidden');
            setTimeout(() => toast.classList.add('hidden'), 3000);
        }
    }).catch(e => console.error('Error copying:', e));
}
</script>
