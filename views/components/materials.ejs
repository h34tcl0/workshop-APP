<!-- MÓDULO DE GESTIÓN DE MATERIALES E INVENTARIO DE TALLER -->
<div id="materials-module-container" class="space-y-4">
    <%
      const allMats = locals.materials || [];
      const allTools = locals.tools || [];
      const toBuyCount = allMats.filter(m => m.status === 'to_buy').length;
      const inStockCount = allMats.filter(m => m.status === 'in_stock').length;
      const outOfStockCount = allMats.filter(m => m.status === 'out_of_stock').length;
      const toolsAvailable = allTools.filter(t => t.status === 'available').length;
      const toolsInUse = allTools.filter(t => t.status === 'in_use').length;
      const toolsToBuy = allTools.filter(t => t.status === 'to_buy' || t.status === 'Por Comprar').length;
      const toolsBroken = allTools.filter(t => t.status === 'broken').length;
    %>

    <!-- BARRA UNIFICADA DE TABS, FILTROS Y ACCIONES -->
    <div class="w-full bg-surface border border-hairline rounded-2xl p-2.5 shadow-panel space-y-2.5">
        <!-- FILA 1: PESTAÑAS (IZQUIERDA) Y ACCIONES PRIMARIAS (DERECHA) -->
        <div class="flex flex-wrap items-center justify-between gap-2.5">
            <!-- IZQUIERDA: PESTAÑAS CON ÍCONOS DEL SISTEMA -->
            <div class="flex items-center gap-1 p-1 bg-surface2 rounded-xl shrink-0 overflow-x-auto max-w-full">
                <button type="button" onclick="switchInventoryTab('materials')" id="inv-tab-materials" class="inv-tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-brass text-canvas shadow-xs whitespace-nowrap">
                    <svg class="w-3.5 h-3.5 shrink-0"><use href="#i-box"/></svg>
                    <span>Insumos y Materiales (<%= allMats.length %>)</span>
                </button>
                <button type="button" onclick="switchInventoryTab('tools')" id="inv-tab-tools" class="inv-tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-ink2 hover:text-ink whitespace-nowrap">
                    <svg class="w-3.5 h-3.5 shrink-0"><use href="#i-wrench"/></svg>
                    <span>Herramientas (<%= allTools.length %>)</span>
                </button>
                <button type="button" onclick="switchInventoryTab('all')" id="inv-tab-all" class="inv-tab-btn flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all text-ink2 hover:text-ink whitespace-nowrap">
                    <svg class="w-3.5 h-3.5 shrink-0"><use href="#i-list"/></svg>
                    <span>Vista Unificada</span>
                </button>
            </div>

            <!-- DERECHA: BOTONES DE ACCIÓN PRINCIPALES -->
            <div class="flex items-center gap-1.5 shrink-0 flex-wrap">
                <button type="button" onclick="openAiExportModal()" title="Exportar Inventario" class="flex items-center justify-center gap-1.5 bg-surface2 hover:bg-hairline text-ink border border-hairline px-3 py-1.5 rounded-xl text-xs font-medium transition-colors whitespace-nowrap">
                    <svg class="w-3.5 h-3.5 text-ink2 shrink-0"><use href="#i-terminal"/></svg>
                    <span>Exportar</span>
                </button>
                <button type="button" id="btn-add-material-action" onclick="toggleAddMaterialForm()" title="Nuevo Material" class="flex items-center justify-center gap-1.5 bg-brass hover:bg-brassdim text-canvas px-3.5 py-1.5 rounded-xl text-xs font-bold transition-colors shadow-xs whitespace-nowrap">
                    <svg class="w-3.5 h-3.5 shrink-0"><use href="#i-plus"/></svg>
                    <span>Nuevo Material</span>
                </button>
                <button type="button" id="btn-add-tool-action" onclick="toggleAddToolForm()" title="Nueva Herramienta" class="flex items-center justify-center gap-1.5 bg-surface2 hover:bg-hairline text-ink border border-hairline px-3 py-1.5 rounded-xl text-xs font-medium transition-colors whitespace-nowrap">
                    <svg class="w-3.5 h-3.5 text-chalk shrink-0"><use href="#i-plus"/></svg>
                    <span>Nueva Herramienta</span>
                </button>
                <button type="button" onclick="openImportMaterialsModal()" title="Importar JSON" class="p-1.5 bg-surface2 hover:bg-hairline text-ink border border-hairline rounded-xl text-xs font-medium transition-colors shrink-0">
                    <svg class="w-4 h-4 text-chalk shrink-0"><use href="#i-import"/></svg>
                </button>
            </div>
        </div>

        <!-- FILA 2: FILTRO CONTEXTUAL DE CATEGORÍA Y BUSCADOR EN TIEMPO REAL -->
        <div class="flex items-center gap-2 pt-0.5 border-t border-hairline/50">
            <!-- FILTRO DE CATEGORÍA DE TALLER -->
            <div class="shrink-0 min-w-[150px] sm:min-w-[170px]">
                <select id="inventory-category-filter" onchange="filterInventory()" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-xl px-2.5 py-1.5 text-xs font-medium focus:outline-none focus:border-brass cursor-pointer transition-colors">
                    <option value="all">Todas las Categorías</option>
                </select>
            </div>

            <!-- BÚSQUEDA RÁPIDA -->
            <div class="relative flex-1 min-w-0">
                <svg class="w-3.5 h-3.5 absolute left-3 top-2.5 text-ink3 pointer-events-none"><use href="#i-search"/></svg>
                <input type="text" id="inventory-search-input" onkeyup="filterInventory()" placeholder="Buscar insumo, herramienta, notas o proyecto..." class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-xl pl-8 pr-3 py-1.5 text-xs focus:outline-none focus:border-brass placeholder:text-ink3 transition-colors">
            </div>
        </div>
    </div>

    <!-- BARRA DELGADA DE RESUMEN DE STATS -->
    <div class="flex items-center gap-3 px-4 py-2 bg-surface2/50 border border-hairline/70 rounded-xl text-xs text-ink2 overflow-x-auto whitespace-nowrap">
        <span><strong class="text-ink font-semibold"><%= allMats.length %></strong> insumos registrados</span>
        <span class="text-hairline">·</span>
        <span class="inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-moss inline-block shrink-0"></span>
            <span><strong class="text-ink font-semibold"><%= inStockCount %></strong> en taller / stock</span>
        </span>
        <span class="text-hairline">·</span>
        <span class="inline-flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rust inline-block shrink-0"></span>
            <span><strong class="text-ink font-semibold"><%= toBuyCount + outOfStockCount %></strong> por comprar / agotados</span>
        </span>
        <span class="text-hairline">·</span>
        <span class="inline-flex items-center gap-1.5">
            <span><strong class="text-ink font-semibold"><%= allTools.length %></strong> herramientas registradas</span>
        </span>
    </div>

    <!-- FORMULARIO NUEVO MATERIAL (OCULTO POR DEFECTO) -->
    <div id="add-material-form-card" class="hidden bg-surface border border-brass/40 rounded-2xl p-5 shadow-panel space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-brass"><use href="#i-plus"/></svg> Agregar Insumo / Material al Taller
            </h3>
            <button type="button" onclick="toggleAddMaterialForm()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <div id="add-material-error" class="hidden p-3 rounded-xl bg-rust/10 border border-rust/30 text-rust text-xs font-semibold"></div>

        <form action="/materials/add" method="post" id="add-material-form" onsubmit="submitAddMaterialForm(event)" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Proyecto Asociado</label>
                    <select name="project_id" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                        <% (locals.all_projects || []).forEach(p => { %>
                            <option value="<%= p.id %>" <%= p.is_active ? 'selected' : '' %>><%= p.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Nombre del Material / Insumo</label>
                    <input type="text" name="name" required placeholder="Ej. Listones Roble 2x4 3.2m, Bisagras Cazoleta" class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass transition-colors">
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Cantidad</label>
                    <input type="number" step="0.1" min="0.1" name="quantity" value="1" required class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-mono transition-colors">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Unidad</label>
                    <select name="unit" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                        <option value="unidades">unidades</option>
                        <option value="piezas">piezas</option>
                        <option value="mm">mm</option>
                        <option value="mts">mts</option>
                        <option value="m2">m²</option>
                        <option value="kg">kg</option>
                        <option value="litros">litros</option>
                        <option value="kits">kits</option>
                        <option value="pares">pares</option>
                        <option value="cajas">cajas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Categoría</label>
                    <select name="category" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                        <option value="Madera">Madera</option>
                        <option value="Placas/Tableros">Placas / Tableros</option>
                        <option value="Tornillería">Tornillería</option>
                        <option value="Adhesivos/Barniz">Adhesivos / Barniz</option>
                        <option value="Insumos">Insumos</option>
                        <option value="Herrajes">Herrajes</option>
                        <option value="General">General</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Estado Inicial</label>
                    <select name="status" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-semibold cursor-pointer transition-colors">
                        <option value="in_stock" selected class="text-moss">En Taller</option>
                        <option value="to_buy" class="text-rust">Por Comprar</option>
                        <option value="out_of_stock" class="text-amber-500">Agotado</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="toggleAddMaterialForm()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink bg-surface2 hover:bg-hairline border border-hairline rounded-xl transition-colors">Cancelar</button>
                <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Guardar Insumo</button>
            </div>
        </form>
    </div>

    <!-- FORMULARIO NUEVA HERRAMIENTA (OCULTO POR DEFECTO) -->
    <div id="add-tool-form-card" class="hidden bg-surface border border-brass/40 rounded-2xl p-5 shadow-panel space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-brass"><use href="#i-plus"/></svg> Registrar Nueva Herramienta
            </h3>
            <button type="button" onclick="toggleAddToolForm()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <div id="add-tool-error" class="hidden p-3 rounded-xl bg-rust/10 border border-rust/30 text-rust text-xs font-semibold"></div>

        <form action="/tools/add" method="post" id="add-tool-form" onsubmit="submitAddToolForm(event)" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="sm:col-span-1">
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Nombre Herramienta</label>
                    <input type="text" name="name" required placeholder="Ej. Sierra de Inmersión Makita SP6000, Formón 18mm" class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass transition-colors">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Categoría</label>
                    <select name="category" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass cursor-pointer transition-colors">
                        <option value="Herramientas Eléctricas">Herramientas Eléctricas</option>
                        <option value="Herramientas Manuales" selected>Herramientas Manuales</option>
                        <option value="Medición y Trazado">Medición y Trazado</option>
                        <option value="Prensas y Sujeción">Prensas y Sujeción</option>
                        <option value="Accesorios y Plantillas">Accesorios y Plantillas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Estado</label>
                    <select name="status" class="w-full bg-surface2 hover:bg-[#223041] border border-hairline hover:border-brass/50 text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-semibold cursor-pointer transition-colors">
                        <option value="available" selected class="text-moss">Disponible en Taller</option>
                        <option value="in_use" class="text-amber-500">En Uso / Mantención</option>
                        <option value="to_buy" class="text-rust">Por Comprar (Falta en Taller)</option>
                        <option value="broken" class="text-rust">Dañada / Reemplazar</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Notas / Ubicación / Especificaciones</label>
                <input type="text" name="notes" placeholder="Ej. Estante A, requiere afilado de hoja, disco 56T" class="w-full bg-surface2 hover:bg-surface2/80 border border-hairline hover:border-hairline/90 text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-brass transition-colors">
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="toggleAddToolForm()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink bg-surface2 hover:bg-hairline border border-hairline rounded-xl transition-colors">Cancelar</button>
                <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Guardar Herramienta</button>
            </div>
        </form>
    </div>

    <!-- VISTA 1: LISTA DE MATERIALES E INSUMOS -->
    <div id="materials-subpanel" class="space-y-3">
        <% if (allMats.length === 0) { %>
            <div class="bg-surface border border-dashed border-hairline rounded-2xl p-8 text-center">
                <div class="w-12 h-12 rounded-full bg-surface2 border border-hairline flex items-center justify-center text-ink3 mx-auto mb-3">
                    <svg class="w-6 h-6"><use href="#i-box"/></svg>
                </div>
                <h3 class="font-display text-base font-semibold text-ink">No hay insumos o materiales registrados</h3>
                <p class="text-xs text-ink3 mt-1 max-w-md mx-auto">Agrega tus insumos manualmente o importa una lista en JSON para sincronizar tu taller.</p>
                <div class="flex items-center justify-center gap-3 mt-4">
                    <button type="button" onclick="toggleAddMaterialForm()" class="bg-brass text-canvas px-4 py-2 rounded-xl text-xs font-bold">Agregar Material</button>
                </div>
            </div>
        <% } else { %>
            <div class="overflow-x-auto border border-hairline rounded-2xl bg-surface shadow-panel">
                <table class="w-full text-left text-xs text-ink divide-y divide-hairline min-w-[580px]">
                    <thead class="bg-surface2/60 text-ink3 uppercase text-[10px] tracking-wider font-semibold">
                        <tr>
                            <th scope="col" class="py-3 px-4 w-1/2 sm:w-5/12">Nombre & Cantidad</th>
                            <th scope="col" class="py-3 px-3 w-1/4 sm:w-2/12">Categoría</th>
                            <th scope="col" class="py-3 px-3 w-1/4 sm:w-3/12">Estado</th>
                            <th scope="col" class="py-3 px-4 text-right w-16 sm:w-2/12">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-hairline/60">
                        <% allMats.forEach(mat => { %>
                            <tr class="inventory-card material-card hover:bg-surface2/40 transition-colors"
                                data-type="material"
                                data-status="<%= mat.status %>"
                                data-category="<%= (mat.category || '').toLowerCase() %>"
                                data-name="<%= (mat.name || '').toLowerCase() %>"
                                data-project="<%= (mat.project_name || '').toLowerCase() %>">
                                <td class="py-2.5 px-4 min-w-0">
                                    <div class="font-semibold text-sm text-ink truncate max-w-[280px] sm:max-w-md" title="<%= mat.name %>">
                                        <%= mat.name %>
                                    </div>
                                    <div class="flex items-center gap-2 mt-0.5 text-[11px] text-ink3 flex-wrap">
                                        <span class="font-mono bg-surface2 border border-hairline text-chalk px-1.5 py-0.2 rounded font-medium">
                                            <%= mat.quantity %> <%= mat.unit %>
                                        </span>
                                        <% if (mat.project_name) { %>
                                            <span class="truncate max-w-[160px]" title="Proyecto: <%= mat.project_name %>">• Proyecto: <strong class="text-ink2"><%= mat.project_name %></strong></span>
                                        <% } %>
                                    </div>
                                </td>
                                <td class="py-2.5 px-3 whitespace-nowrap">
                                    <span class="inline-block bg-surface2 text-ink2 border border-hairline/80 px-2 py-0.5 rounded text-[11px] font-medium">
                                        <%= mat.category || 'General' %>
                                    </span>
                                </td>
                                <td class="py-2.5 px-3 whitespace-nowrap">
                                    <select onchange="updateMaterialStatusDirect(<%= mat.id %>, this.value)" 
                                            class="status-badge-select text-xs font-bold px-2.5 py-1 rounded-lg border appearance-none pr-6 cursor-pointer shadow-sm focus:outline-none transition-colors hover:brightness-110 <%= mat.status === 'in_stock' ? 'bg-moss/10 border-moss/40 text-moss hover:border-moss hover:bg-moss/20' : mat.status === 'out_of_stock' ? 'bg-amber-500/10 border-amber-500/40 text-amber-500 hover:border-amber-500 hover:bg-amber-500/20' : 'bg-rust/10 border-rust/40 text-rust hover:border-rust hover:bg-rust/20' %>">
                                        <option value="in_stock" <%= mat.status === 'in_stock' ? 'selected' : '' %>>En Taller</option>
                                        <option value="to_buy" <%= mat.status === 'to_buy' ? 'selected' : '' %>>Por Comprar</option>
                                        <option value="out_of_stock" <%= mat.status === 'out_of_stock' ? 'selected' : '' %>>Agotado</option>
                                    </select>
                                </td>
                                <td class="py-2.5 px-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1">
                                        <button type="button" onclick='openEditMaterialModal(<%= JSON.stringify(mat) %>)' title="Editar material" class="p-1.5 text-ink3 hover:text-brass rounded-lg hover:bg-surface2 transition-colors">
                                            <svg class="w-3.5 h-3.5"><use href="#i-edit"/></svg>
                                        </button>
                                        <button type="button" onclick="deleteMaterial(<%= mat.id %>)" title="Eliminar material" class="p-1.5 text-ink3 hover:text-rust rounded-lg hover:bg-surface2 transition-colors">
                                            <svg class="w-3.5 h-3.5"><use href="#i-close"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- VISTA 2: LISTA DE HERRAMIENTAS -->
    <div id="tools-subpanel" class="space-y-3 hidden">
        <% if (allTools.length === 0) { %>
            <div class="bg-surface border border-dashed border-hairline rounded-2xl p-8 text-center">
                <div class="w-12 h-12 rounded-full bg-surface2 border border-hairline flex items-center justify-center text-brass mx-auto mb-3">
                    <svg class="w-6 h-6"><use href="#i-terminal"/></svg>
                </div>
                <h3 class="font-display text-base font-semibold text-ink">No hay herramientas registradas</h3>
                <p class="text-xs text-ink3 mt-1 max-w-md mx-auto">Registra tus sierras, formones, prensas y herramientas para un control seguro de taller.</p>
                <div class="flex items-center justify-center gap-3 mt-4">
                    <button type="button" onclick="toggleAddToolForm()" class="bg-brass text-canvas px-4 py-2 rounded-xl text-xs font-bold">Registrar Herramienta</button>
                </div>
            </div>
        <% } else { %>
            <div class="overflow-x-auto border border-hairline rounded-2xl bg-surface shadow-panel">
                <table class="w-full text-left text-xs text-ink divide-y divide-hairline min-w-[580px]">
                    <thead class="bg-surface2/60 text-ink3 uppercase text-[10px] tracking-wider font-semibold">
                        <tr>
                            <th scope="col" class="py-3 px-4 w-1/2 sm:w-5/12">Herramienta & Notas</th>
                            <th scope="col" class="py-3 px-3 w-1/4 sm:w-2/12">Categoría</th>
                            <th scope="col" class="py-3 px-3 w-1/4 sm:w-3/12">Estado</th>
                            <th scope="col" class="py-3 px-4 text-right w-16 sm:w-2/12">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-hairline/60">
                        <% allTools.forEach(tool => { %>
                            <tr class="inventory-card tool-card hover:bg-surface2/40 transition-colors"
                                data-type="tool"
                                data-status="<%= tool.status %>"
                                data-category="<%= (tool.category || '').toLowerCase() %>"
                                data-name="<%= (tool.name || '').toLowerCase() %>"
                                data-notes="<%= (tool.notes || '').toLowerCase() %>">
                                <td class="py-2.5 px-4 min-w-0">
                                    <div class="font-semibold text-sm text-ink truncate max-w-[280px] sm:max-w-md" title="<%= tool.name %>">
                                        <%= tool.name %>
                                    </div>
                                    <% if (tool.notes) { %>
                                        <div class="text-[11px] text-ink3 mt-0.5 truncate max-w-[280px] sm:max-w-md flex items-center gap-1" title="<%= tool.notes %>">
                                            <svg class="w-3 h-3 text-ink3 shrink-0"><use href="#i-pin"/></svg>
                                            <span class="truncate"><%= tool.notes %></span>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="py-2.5 px-3 whitespace-nowrap">
                                    <span class="inline-block bg-surface2 text-brass border border-brass/20 px-2 py-0.5 rounded text-[11px] font-medium">
                                        <%= tool.category %>
                                    </span>
                                </td>
                                <td class="py-2.5 px-3 whitespace-nowrap">
                                    <select onchange="updateToolStatusDirect(<%= tool.id %>, this.value)"
                                            class="status-badge-select text-xs font-bold px-2.5 py-1 rounded-lg border appearance-none pr-6 cursor-pointer focus:outline-none transition-colors hover:brightness-110 <%= tool.status === 'available' ? 'bg-moss/10 border-moss/40 text-moss hover:border-moss hover:bg-moss/20' : tool.status === 'in_use' ? 'bg-amber-500/10 border-amber-500/40 text-amber-500 hover:border-amber-500 hover:bg-amber-500/20' : tool.status === 'to_buy' || tool.status === 'Por Comprar' ? 'bg-rust/10 border-rust/40 text-rust hover:border-rust hover:bg-rust/20' : 'bg-rust/10 border-rust/40 text-rust hover:border-rust hover:bg-rust/20' %>">
                                        <option value="available" <%= tool.status === 'available' ? 'selected' : '' %>>Disponible</option>
                                        <option value="in_use" <%= tool.status === 'in_use' ? 'selected' : '' %>>En Uso</option>
                                        <option value="to_buy" <%= tool.status === 'to_buy' || tool.status === 'Por Comprar' ? 'selected' : '' %>>Por Comprar</option>
                                        <option value="broken" <%= tool.status === 'broken' ? 'selected' : '' %>>Dañada</option>
                                    </select>
                                </td>
                                <td class="py-2.5 px-4 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1">
                                        <button type="button" onclick='openEditToolModal(<%= JSON.stringify(tool) %>)' title="Editar herramienta" class="p-1.5 text-ink3 hover:text-brass rounded-lg hover:bg-surface2 transition-colors">
                                            <svg class="w-3.5 h-3.5"><use href="#i-edit"/></svg>
                                        </button>
                                        <button type="button" onclick="deleteTool(<%= tool.id %>)" title="Eliminar herramienta" class="p-1.5 text-ink3 hover:text-rust rounded-lg hover:bg-surface2 transition-colors">
                                            <svg class="w-3.5 h-3.5"><use href="#i-close"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

