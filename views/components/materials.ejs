<!-- MÓDULO DE GESTIÓN DE MATERIALES E INVENTARIO DE TALLER -->
<div id="materials-module-container" class="space-y-6">
    <%
      const allMats = locals.materials || [];
      const allTools = locals.tools || [];
      const toBuyCount = allMats.filter(m => m.status === 'to_buy').length;
      const inStockCount = allMats.filter(m => m.status === 'in_stock').length;
      const outOfStockCount = allMats.filter(m => m.status === 'out_of_stock').length;
      const toolsAvailable = allTools.filter(t => t.status === 'available').length;
      const toolsInUse = allTools.filter(t => t.status === 'in_use').length;
      const toolsBroken = allTools.filter(t => t.status === 'broken').length;
    %>

    <!-- HEADER DE INVENTARIO Y BARRAS DE ACCIÓN -->
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-surface border border-hairline rounded-2xl p-5 shadow-panel">
        <div>
            <div class="flex items-center gap-2">
                <span class="text-[11px] font-mono font-semibold tracking-widest text-brass uppercase">LOGÍSTICA E INVENTARIO OS</span>
            </div>
            <h2 class="font-display text-xl font-bold text-ink mt-1 flex items-center gap-2">
                <svg class="w-5 h-5 text-brass"><use href="#i-box"/></svg>
                Inventario de Taller y Herramientas
            </h2>
            <p class="text-xs text-ink2 mt-0.5">Control global de insumos, stock de materiales, herramental y contexto formateado para IA</p>
        </div>

        <div class="flex items-center gap-2 flex-wrap shrink-0">
            <button type="button" onclick="openAiExportModal()" class="flex items-center gap-1.5 bg-brass/10 hover:bg-brass/20 text-brass border border-brass/30 px-3.5 py-2 rounded-xl text-xs font-bold transition-colors shadow-sm">
                <svg class="w-4 h-4"><use href="#i-terminal"/></svg>
                📋 Exportar Contexto para IA
            </button>
            <button type="button" onclick="toggleAddToolForm()" class="flex items-center gap-1.5 bg-surface2 hover:bg-hairline text-ink border border-hairline px-3.5 py-2 rounded-xl text-xs font-semibold transition-colors">
                <svg class="w-4 h-4 text-chalk"><use href="#i-plus"/></svg> Nueva Herramienta
            </button>
            <button type="button" onclick="toggleAddMaterialForm()" class="flex items-center gap-1.5 bg-brass hover:bg-brassdim text-canvas px-4 py-2 rounded-xl text-xs font-bold transition-colors shadow-sm">
                <svg class="w-4 h-4"><use href="#i-plus"/></svg> Nuevo Material
            </button>
            <button type="button" onclick="openImportMaterialsModal()" title="Importar JSON" class="p-2 bg-surface2 hover:bg-hairline text-ink border border-hairline rounded-xl text-xs font-semibold transition-colors">
                <svg class="w-4 h-4 text-chalk"><use href="#i-import"/></svg>
            </button>
        </div>
    </div>

    <!-- MÉTRICAS DE INVENTARIO -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="bg-surface border border-hairline rounded-xl p-3.5 text-center shadow-panel">
            <span class="block text-[10px] font-semibold text-ink3 uppercase tracking-wider">Insumos Registrados</span>
            <span class="block text-2xl font-bold font-mono text-ink mt-0.5"><%= allMats.length %></span>
        </div>
        <div class="bg-surface border border-moss/30 bg-moss/5 rounded-xl p-3.5 text-center shadow-panel">
            <span class="block text-[10px] font-semibold text-moss uppercase tracking-wider flex items-center justify-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-moss"></span> En Taller / Stock
            </span>
            <span class="block text-2xl font-bold font-mono text-moss mt-0.5" id="mat-in-stock-count"><%= inStockCount %></span>
        </div>
        <div class="bg-surface border border-rust/30 bg-rust/5 rounded-xl p-3.5 text-center shadow-panel">
            <span class="block text-[10px] font-semibold text-rust uppercase tracking-wider flex items-center justify-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-rust"></span> Por Comprar / Agotados
            </span>
            <span class="block text-2xl font-bold font-mono text-rust mt-0.5" id="mat-to-buy-count"><%= toBuyCount + outOfStockCount %></span>
        </div>
        <div class="bg-surface border border-brass/30 bg-brass/5 rounded-xl p-3.5 text-center shadow-panel">
            <span class="block text-[10px] font-semibold text-brass uppercase tracking-wider flex items-center justify-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-brass"></span> Herramientas (<%= toolsAvailable %> Avail)
            </span>
            <span class="block text-2xl font-bold font-mono text-brass mt-0.5"><%= allTools.length %></span>
        </div>
    </div>

    <!-- FORMULARIO NUEVO MATERIAL (OCULTO POR DEFECTO) -->
    <div id="add-material-form-card" class="hidden bg-surface border border-brass/40 rounded-2xl p-5 shadow-panel space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-brass"><use href="#i-plus"/></svg> Agregar Insumo / Material al Taller
            </h3>
            <button type="button" onclick="toggleAddMaterialForm()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <div id="add-material-error" class="hidden p-3 rounded-xl bg-rust/10 border border-rust/30 text-rust text-xs font-semibold"></div>

        <form action="/materials/add" method="post" id="add-material-form" onsubmit="submitAddMaterialForm(event)" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Proyecto Asociado</label>
                    <select name="project_id" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                        <% (locals.all_projects || []).forEach(p => { %>
                            <option value="<%= p.id %>" <%= p.is_active ? 'selected' : '' %>><%= p.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Nombre del Material / Insumo</label>
                    <input type="text" name="name" required placeholder="Ej. Listones Roble 2x4 3.2m, Bisagras Cazoleta" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Cantidad</label>
                    <input type="number" step="0.1" min="0.1" name="quantity" value="1" required class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-mono">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Unidad</label>
                    <select name="unit" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                        <option value="unidades">unidades</option>
                        <option value="piezas">piezas</option>
                        <option value="mm">mm</option>
                        <option value="mts">mts</option>
                        <option value="m2">m²</option>
                        <option value="kg">kg</option>
                        <option value="litros">litros</option>
                        <option value="kits">kits</option>
                        <option value="pares">pares</option>
                        <option value="cajas">cajas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Categoría</label>
                    <select name="category" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                        <option value="Madera">Madera</option>
                        <option value="Placas/Tableros">Placas / Tableros</option>
                        <option value="Tornillería">Tornillería</option>
                        <option value="Adhesivos/Barniz">Adhesivos / Barniz</option>
                        <option value="Insumos">Insumos</option>
                        <option value="Herrajes">Herrajes</option>
                        <option value="General">General</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Estado Inicial</label>
                    <select name="status" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-semibold">
                        <option value="in_stock" selected class="text-moss">🟢 En Taller</option>
                        <option value="to_buy" class="text-rust">🔴 Por Comprar</option>
                        <option value="out_of_stock" class="text-amber-500">⚠️ Agotado</option>
                    </select>
                </div>
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="toggleAddMaterialForm()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink">Cancelar</button>
                <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Guardar Insumo</button>
            </div>
        </form>
    </div>

    <!-- FORMULARIO NUEVA HERRAMIENTA (OCULTO POR DEFECTO) -->
    <div id="add-tool-form-card" class="hidden bg-surface border border-brass/40 rounded-2xl p-5 shadow-panel space-y-4">
        <div class="flex items-center justify-between border-b border-hairline pb-3">
            <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
                <svg class="w-4 h-4 text-brass"><use href="#i-plus"/></svg> Registrar Nueva Herramienta
            </h3>
            <button type="button" onclick="toggleAddToolForm()" class="text-ink3 hover:text-ink">
                <svg class="w-5 h-5"><use href="#i-close"/></svg>
            </button>
        </div>

        <div id="add-tool-error" class="hidden p-3 rounded-xl bg-rust/10 border border-rust/30 text-rust text-xs font-semibold"></div>

        <form action="/tools/add" method="post" id="add-tool-form" onsubmit="submitAddToolForm(event)" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="sm:col-span-1">
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Nombre Herramienta</label>
                    <input type="text" name="name" required placeholder="Ej. Sierra de Inmersión Makita SP6000, Formón 18mm" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Categoría</label>
                    <select name="category" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass">
                        <option value="Herramientas Eléctricas">Herramientas Eléctricas</option>
                        <option value="Herramientas Manuales" selected>Herramientas Manuales</option>
                        <option value="Medición y Trazado">Medición y Trazado</option>
                        <option value="Prensas y Sujeción">Prensas y Sujeción</option>
                        <option value="Accesorios y Plantillas">Accesorios y Plantillas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Estado</label>
                    <select name="status" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-brass font-semibold">
                        <option value="available" selected class="text-moss">🟢 Disponible en Taller</option>
                        <option value="in_use" class="text-amber-500">🟡 En Uso / Mantención</option>
                        <option value="broken" class="text-rust">🔴 Dañada / Reemplazar</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-[11px] font-semibold text-ink3 uppercase mb-1">Notas / Ubicación / Especificaciones</label>
                <input type="text" name="notes" placeholder="Ej. Estante A, requiere afilado de hoja, disco 56T" class="w-full bg-surface2 border border-hairline text-ink rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-brass">
            </div>

            <div class="flex justify-end gap-2 pt-2">
                <button type="button" onclick="toggleAddToolForm()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink">Cancelar</button>
                <button type="submit" class="bg-brass hover:bg-brassdim text-canvas px-5 py-2 rounded-xl text-xs font-bold transition-colors">Guardar Herramienta</button>
            </div>
        </form>
    </div>

    <!-- PESTAÑAS SUB-MÓDULOS Y NAVEGACIÓN -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-surface border border-hairline rounded-2xl p-3 shadow-panel">
        <div class="flex items-center gap-1 bg-surface2/60 p-1 rounded-xl border border-hairline/60">
            <button type="button" onclick="switchInventoryTab('materials')" id="inv-tab-materials" class="inv-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all bg-brass text-canvas shadow-sm">
                📦 Insumos y Materiales (<%= allMats.length %>)
            </button>
            <button type="button" onclick="switchInventoryTab('tools')" id="inv-tab-tools" class="inv-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-ink2 hover:text-ink">
                🛠️ Herramientas (<%= allTools.length %>)
            </button>
            <button type="button" onclick="switchInventoryTab('all')" id="inv-tab-all" class="inv-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all text-ink2 hover:text-ink">
                🌐 Vista Unificada
            </button>
        </div>

        <div class="flex items-center gap-2 flex-wrap">
            <!-- FILTRO DE CATEGORÍA DE TALLER -->
            <select id="inventory-category-filter" onchange="filterInventory()" class="bg-surface2 border border-hairline text-ink rounded-xl px-3 py-1.5 text-xs font-semibold focus:outline-none focus:border-brass">
                <option value="all">Todas las Categorías</option>
                <optgroup label="Materiales e Insumos">
                    <option value="madera">Madera</option>
                    <option value="placas/tableros">Placas / Tableros</option>
                    <option value="tornillería">Tornillería</option>
                    <option value="adhesivos/barniz">Adhesivos / Barniz</option>
                    <option value="herrajes">Herrajes</option>
                    <option value="insumos">Insumos</option>
                </optgroup>
                <optgroup label="Herramientas">
                    <option value="herramientas eléctricas">Herramientas Eléctricas</option>
                    <option value="herramientas manuales">Herramientas Manuales</option>
                    <option value="medición y trazado">Medición y Trazado</option>
                    <option value="prensas y sujeción">Prensas y Sujeción</option>
                    <option value="accesorios y plantillas">Accesorios y Plantillas</option>
                </optgroup>
            </select>

            <!-- BÚSQUEDA RÁPIDA -->
            <div class="relative min-w-[180px]">
                <svg class="w-4 h-4 absolute left-3 top-2.5 text-ink3"><use href="#i-search"/></svg>
                <input type="text" id="inventory-search-input" onkeyup="filterInventory()" placeholder="Buscar en inventario..." class="w-full bg-surface2 border border-hairline text-ink rounded-xl pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:border-brass">
            </div>
        </div>
    </div>

    <!-- VISTA 1: LISTA DE MATERIALES E INSUMOS -->
    <div id="materials-subpanel" class="space-y-3">
        <% if (allMats.length === 0) { %>
            <div class="bg-surface border border-dashed border-hairline rounded-2xl p-8 text-center">
                <div class="w-12 h-12 rounded-full bg-surface2 border border-hairline flex items-center justify-center text-ink3 mx-auto mb-3">
                    <svg class="w-6 h-6"><use href="#i-box"/></svg>
                </div>
                <h3 class="font-display text-base font-semibold text-ink">No hay insumos o materiales registrados</h3>
                <p class="text-xs text-ink3 mt-1 max-w-md mx-auto">Agrega tus insumos manualmente o importa una lista en JSON para sincronizar tu taller.</p>
                <div class="flex items-center justify-center gap-3 mt-4">
                    <button type="button" onclick="toggleAddMaterialForm()" class="bg-brass text-canvas px-4 py-2 rounded-xl text-xs font-bold">Agregar Material</button>
                </div>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 gap-2.5">
                <% allMats.forEach(mat => { %>
                    <div class="inventory-card material-card bg-surface hover:bg-surface2/60 border border-hairline rounded-xl p-3.5 transition-all flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-panel"
                         data-type="material"
                         data-status="<%= mat.status %>"
                         data-category="<%= (mat.category || '').toLowerCase() %>"
                         data-name="<%= (mat.name || '').toLowerCase() %>"
                         data-project="<%= (mat.project_name || '').toLowerCase() %>">
                        
                        <div class="flex items-start sm:items-center gap-3 min-w-0">
                            <!-- ESTADO DE MATERIAL CON MENU RÁPIDO -->
                            <div class="relative shrink-0">
                                <select onchange="updateMaterialStatusDirect(<%= mat.id %>, this.value)" 
                                        class="text-xs font-bold px-3 py-1.5 rounded-xl border appearance-none pr-7 cursor-pointer shadow-sm focus:outline-none <%= mat.status === 'in_stock' ? 'bg-moss/10 border-moss/40 text-moss' : mat.status === 'out_of_stock' ? 'bg-amber-500/10 border-amber-500/40 text-amber-500' : 'bg-rust/10 border-rust/40 text-rust' %>">
                                    <option value="in_stock" <%= mat.status === 'in_stock' ? 'selected' : '' %>>🟢 En Taller</option>
                                    <option value="to_buy" <%= mat.status === 'to_buy' ? 'selected' : '' %>>🔴 Por Comprar</option>
                                    <option value="out_of_stock" <%= mat.status === 'out_of_stock' ? 'selected' : '' %>>⚠️ Agotado</option>
                                </select>
                            </div>

                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <h4 class="font-semibold text-sm text-ink <%= mat.status === 'in_stock' ? '' : 'text-ink' %>">
                                        <%= mat.name %>
                                    </h4>
                                    <span class="text-[11px] font-mono bg-surface2 border border-hairline text-chalk px-2 py-0.5 rounded-md font-semibold">
                                        <%= mat.quantity %> <%= mat.unit %>
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 mt-1 text-[11px] text-ink3 flex-wrap">
                                    <span class="font-medium bg-surface2/80 px-2 py-0.5 rounded border border-hairline/60 text-ink2"><%= mat.category %></span>
                                    <span>• Proyecto: <strong class="text-ink2"><%= mat.project_name || 'General' %></strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- ACCIONES MATERIAL -->
                        <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
                            <button type="button" onclick='openEditMaterialModal(<%= JSON.stringify(mat) %>)' title="Editar material" class="p-2 text-ink3 hover:text-brass rounded-lg hover:bg-surface2 transition-colors">
                                <svg class="w-4 h-4"><use href="#i-edit"/></svg>
                            </button>
                            <button type="button" onclick="deleteMaterial(<%= mat.id %>)" title="Eliminar material" class="p-2 text-ink3 hover:text-rust rounded-lg hover:bg-surface2 transition-colors">
                                <svg class="w-4 h-4"><use href="#i-close"/></svg>
                            </button>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } %>
    </div>

    <!-- VISTA 2: LISTA DE HERRAMIENTAS -->
    <div id="tools-subpanel" class="space-y-3 hidden">
        <% if (allTools.length === 0) { %>
            <div class="bg-surface border border-dashed border-hairline rounded-2xl p-8 text-center">
                <div class="w-12 h-12 rounded-full bg-surface2 border border-hairline flex items-center justify-center text-brass mx-auto mb-3">
                    <svg class="w-6 h-6"><use href="#i-terminal"/></svg>
                </div>
                <h3 class="font-display text-base font-semibold text-ink">No hay herramientas registradas</h3>
                <p class="text-xs text-ink3 mt-1 max-w-md mx-auto">Registra tus sierras, formones, prensas y herramientas para un control seguro de taller.</p>
                <div class="flex items-center justify-center gap-3 mt-4">
                    <button type="button" onclick="toggleAddToolForm()" class="bg-brass text-canvas px-4 py-2 rounded-xl text-xs font-bold">Registrar Herramienta</button>
                </div>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <% allTools.forEach(tool => { %>
                    <div class="inventory-card tool-card bg-surface hover:bg-surface2/60 border border-hairline rounded-xl p-4 transition-all flex flex-col justify-between gap-3 shadow-panel"
                         data-type="tool"
                         data-status="<%= tool.status %>"
                         data-category="<%= (tool.category || '').toLowerCase() %>"
                         data-name="<%= (tool.name || '').toLowerCase() %>"
                         data-notes="<%= (tool.notes || '').toLowerCase() %>">
                        
                        <div>
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <span class="text-[10px] font-semibold uppercase tracking-wider text-brass bg-brass/10 px-2 py-0.5 rounded border border-brass/20"><%= tool.category %></span>
                                    <h4 class="font-semibold text-sm text-ink mt-1.5"><%= tool.name %></h4>
                                </div>

                                <!-- SELECTOR ESTADO HERRAMIENTA -->
                                <select onchange="updateToolStatusDirect(<%= tool.id %>, this.value)"
                                        class="text-[11px] font-bold px-2.5 py-1 rounded-lg border appearance-none pr-6 cursor-pointer focus:outline-none <%= tool.status === 'available' ? 'bg-moss/10 border-moss/40 text-moss' : tool.status === 'in_use' ? 'bg-amber-500/10 border-amber-500/40 text-amber-500' : 'bg-rust/10 border-rust/40 text-rust' %>">
                                    <option value="available" <%= tool.status === 'available' ? 'selected' : '' %>>🟢 Disponible</option>
                                    <option value="in_use" <%= tool.status === 'in_use' ? 'selected' : '' %>>🟡 En Uso</option>
                                    <option value="broken" <%= tool.status === 'broken' ? 'selected' : '' %>>🔴 Dañada</option>
                                </select>
                            </div>

                            <% if (tool.notes) { %>
                                <p class="text-xs text-ink2 mt-2 bg-surface2/80 p-2 rounded-lg border border-hairline/60 flex items-center gap-1.5">
                                    <span class="text-ink3">📌</span> <%= tool.notes %>
                                </p>
                            <% } %>
                        </div>

                        <div class="flex items-center justify-between border-t border-hairline/60 pt-2.5 text-[11px] text-ink3">
                            <span>Registrado: <%= tool.created_at ? tool.created_at.split('T')[0] : 'Taller' %></span>
                            <div class="flex items-center gap-1">
                                <button type="button" onclick='openEditToolModal(<%= JSON.stringify(tool) %>)' title="Editar herramienta" class="p-1.5 text-ink3 hover:text-brass rounded-lg hover:bg-surface2 transition-colors">
                                    <svg class="w-3.5 h-3.5"><use href="#i-edit"/></svg>
                                </button>
                                <button type="button" onclick="deleteTool(<%= tool.id %>)" title="Eliminar herramienta" class="p-1.5 text-ink3 hover:text-rust rounded-lg hover:bg-surface2 transition-colors">
                                    <svg class="w-3.5 h-3.5"><use href="#i-close"/></svg>
                                </button>
