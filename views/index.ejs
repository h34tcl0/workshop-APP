<!DOCTYPE html>
<html lang="es" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Workshop OS — Taller al Aire Libre</title>
    <meta name="description"
        content="Sistema operativo inteligente y sensible al clima para taller de carpintería y resina epóxica al aire libre.">
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/png" sizes="192x192" href="/static/icons/icon-192.png">
    <link rel="icon" type="image/svg+xml" href="/static/icons/icon.svg">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Workshop OS">
    <link rel="apple-touch-icon" href="/static/icons/icon-192.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        display: ['"Fraunces"', 'serif'],
                        sans: ['"IBM Plex Sans"', 'system-ui', 'sans-serif'],
                        mono: ['"IBM Plex Mono"', 'monospace'],
                    },
                    colors: {
                        canvas: '#080d14', // dark canvas matching weather background
                        surface: '#131c27', // var(--w-s1) - Weather card background
                        surface2: '#1a2532', // var(--w-s2) - Card inner items / inputs
                        hairline: '#2b3a4b', // var(--w-bd) - Weather card border
                        ink: '#e9f1f8', // var(--w-t1)
                        ink2: '#9cb1c3', // var(--w-t2)
                        ink3: '#64748b', // slate-500
                        brass: '#f4a83a', // var(--w-amber)
                        brassdim: '#d98e25',
                        moss: '#63cf8e', // var(--w-ok)
                        rust: '#eb5757', // var(--w-rust)
                        chalk: '#6db5e6', // var(--w-sky)
                    },
                    boxShadow: {
                        panel: 'inset 0 1px 0 rgba(255,255,255,0.05), 0 16px 40px rgba(0,0,0,0.45)',
                    }
                },
            },
        }
    </script>
    <link rel="stylesheet" href="/static/css/main.css">
</head>

<body class="bg-canvas text-ink min-h-screen antialiased overflow-x-clip">

    <!-- SPRITE DE ÍCONOS -->
    <svg class="hidden">
        <defs>
            <symbol id="i-mark" viewBox="0 0 32 32">
                <path d="M4 24 L16 6 L28 24 Z" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M11 24 L16 15 L21 24" fill="none" stroke="currentColor" stroke-width="2" />
                <line x1="4" y1="24" x2="28" y2="24" stroke="currentColor" stroke-width="2" />
            </symbol>
            <symbol id="i-gear" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </symbol>
            <symbol id="i-plus" viewBox="0 0 24 24">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </symbol>
            <symbol id="i-import" viewBox="0 0 24 24">
                <path d="M12 3v11m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke="currentColor"
                    stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            </symbol>
            <symbol id="i-inbox" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"></polyline>
                <path d="M5.45 5.11L2 12v6a2 2 0 002 2h16a2 2 0 002-2v-6l-3.45-6.89A2 2 0 0016.76 4H7.24a2 2 0 00-1.79 1.11z"></path>
            </symbol>
            <symbol id="i-zap" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </symbol>
            <symbol id="i-check" viewBox="0 0 24 24">
                <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                    stroke-linejoin="round" fill="none" />
            </symbol>
            <symbol id="i-chev-up" viewBox="0 0 24 24">
                <path d="M6 15l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round" fill="none" />
            </symbol>
            <symbol id="i-chev-down" viewBox="0 0 24 24">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round" fill="none" />
            </symbol>
            <symbol id="i-close" viewBox="0 0 24 24">
                <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </symbol>
            <symbol id="i-edit" viewBox="0 0 24 24">
                <path d="M16.5 4.5l3 3L8 19H5v-3L16.5 4.5z" fill="none" stroke="currentColor" stroke-width="1.7"
                    stroke-linejoin="round" />
            </symbol>
            <symbol id="i-pin" viewBox="0 0 24 24">
                <path d="M12 21s-7-6.4-7-11.5A7 7 0 0119 9.5C19 14.6 12 21 12 21z" fill="none" stroke="currentColor"
                    stroke-width="1.7" stroke-linejoin="round" />
                <circle cx="12" cy="9.5" r="2.2" fill="none" stroke="currentColor" stroke-width="1.7" />
            </symbol>
            <symbol id="i-search" viewBox="0 0 24 24">
                <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8" />
                <path d="M20 20l-4.5-4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </symbol>
            <symbol id="i-history" viewBox="0 0 24 24">
                <path d="M3 12a9 9 0 109-9 9 9 0 00-8 5" fill="none" stroke="currentColor" stroke-width="1.7"
                    stroke-linecap="round" />
                <path d="M3 4v4h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                    stroke-linejoin="round" fill="none" />
                <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
                    stroke-linejoin="round" fill="none" />
            </symbol>
            <symbol id="i-star" viewBox="0 0 24 24">
                <path d="M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z" fill="none"
                    stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </symbol>
            <symbol id="i-star-filled" viewBox="0 0 24 24">
                <path d="M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.1-5.4 3.1 1.3-6-4.6-4.1 6.1-.6z" fill="currentColor"
                    stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
            </symbol>
            <symbol id="i-chevron-down-sm" viewBox="0 0 24 24">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round" fill="none" />
            </symbol>
            <symbol id="i-help" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M9.3 9.3a2.7 2.7 0 115.1 1.4c-.5.9-1.4 1.1-1.9 1.9-.3.5-.4 1-.4 1.5" stroke="currentColor"
                    stroke-width="1.6" stroke-linecap="round" fill="none" />
                <circle cx="12" cy="17" r="0.9" fill="currentColor" stroke="none" />
            </symbol>
            <symbol id="i-sun" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8" />
                <path
                    d="M12 2.5v2.4M12 19v2.4M4.2 12H1.8M22.2 12h-2.4M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7L5.6 18.4"
                    stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </symbol>
            <symbol id="i-cloud" viewBox="0 0 24 24">
                <path
                    d="M6.5 18a4 4 0 01-.5-7.97A5 5 0 0116 8a3.5 3.5 0 013.5 3.5c0 .17-.01.33-.03.5A3.5 3.5 0 0119 18H6.5z"
                    fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
            </symbol>
            <symbol id="i-cloud-sun" viewBox="0 0 24 24">
                <circle cx="7.5" cy="7.5" r="2.6" fill="none" stroke="currentColor" stroke-width="1.6" />
                <path d="M7.5 2.8v1.4M7.5 12v-1.3M2.8 7.5h1.4M2.8 4l1.2 1.2M11.2 4L10 5.2" stroke="currentColor"
                    stroke-width="1.5" stroke-linecap="round" />
                <path
                    d="M8 19a3.6 3.6 0 01-.4-7.18A4.6 4.6 0 0116.4 10a3.1 3.1 0 013.1 3.1c0 .16 0 .3-.03.45A3.1 3.1 0 0119 19H8z"
                    fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
            </symbol>
            <symbol id="i-cloud-rain" viewBox="0 0 24 24">
                <path
                    d="M6.5 15a4 4 0 01-.5-7.97A5 5 0 0116 5a3.5 3.5 0 013.5 3.5c0 .17-.01.33-.03.5A3.5 3.5 0 0119 15H6.5z"
                    fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
                <path d="M8 18.5l-1 2.3M12.5 18.5l-1 2.3M17 18.5l-1 2.3" stroke="currentColor" stroke-width="1.7"
                    stroke-linecap="round" />
            </symbol>
            <symbol id="i-sidebar" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" fill="none" stroke="currentColor" stroke-width="1.7" />
                <path d="M9 3v18" stroke="currentColor" stroke-width="1.7" />
            </symbol>
            <symbol id="i-calendar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </symbol>
            <symbol id="i-wrench" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </symbol>
            <symbol id="i-box" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                <polyline points="3.29 7 12 12 20.71 7"/>
                <line x1="12" y1="22" x2="12" y2="12"/>
            </symbol>
            <symbol id="i-calc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2"/>
                <line x1="8" y1="6" x2="16" y2="6"/>
                <line x1="16" y1="14" x2="16" y2="18"/>
                <path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M8 18h.01M12 18h.01"/>
            </symbol>
            <symbol id="i-list" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"/>
                <line x1="8" y1="12" x2="21" y2="12"/>
                <line x1="8" y1="18" x2="21" y2="18"/>
                <line x1="3" y1="6" x2="3.01" y2="6"/>
                <line x1="3" y1="12" x2="3.01" y2="12"/>
                <line x1="3" y1="18" x2="3.01" y2="18"/>
            </symbol>
        </defs>
    </svg>

    <!-- HEADER -->
    <header class="sticky top-0 z-50 w-full max-w-[1440px] mx-auto px-2.5 sm:px-6 pt-2.5 sm:pt-3">
        <div
            class="bg-surface border border-hairline rounded-2xl shadow-panel px-3.5 sm:px-6 py-2.5 sm:py-3 flex flex-wrap md:flex-nowrap items-center justify-between gap-2 sm:gap-4 w-full min-w-0">
            <div class="flex items-center gap-2.5 shrink-0 min-w-0">
                <div
                    class="w-8 h-8 md:w-10 md:h-10 shrink-0 rounded-xl bg-surface2 border border-hairline flex items-center justify-center text-brass shadow-xs">
                    <svg class="w-4 h-4 md:w-5 md:h-5">
                        <use href="#i-mark" />
                    </svg>
                </div>
                <div class="min-w-0">
                    <h1 class="font-display text-sm sm:text-base md:text-xl font-semibold tracking-tight text-ink leading-none truncate">
                        Workshop OS
                    </h1>
                    <p class="hidden md:block text-[11px] text-ink3 font-medium tracking-wide mt-1 truncate">Taller de carpintería al aire libre</p>
                </div>
            </div>

            <div class="flex flex-wrap items-center justify-end gap-1.5 sm:gap-2.5 shrink-0 min-w-0 max-w-full">
                <!-- SEGMENTED MODE SWITCHER (Modo Enfoque | Planificación | Taller | Inventario) -->
                <%- include('components/mode_switcher') %>

                <form id="eval-form" action="/evaluation/force_run" method="post"
                    class="flex items-center gap-1 bg-surface2 border border-hairline rounded-xl p-1 sm:px-2 sm:py-1.5 shrink-0 max-w-full">
                    <button type="submit" id="eval-btn"
                        class="bg-brass hover:bg-brassdim text-canvas text-[11px] sm:text-xs font-semibold px-2 py-1 rounded-lg transition-colors whitespace-nowrap"
                        title="Ejecutar re-evaluación del clima y agenda">
                        Evaluar
                    </button>
                </form>

                <button type="button" onclick="openSettingsModal()" aria-label="Configuración"
                    class="flex items-center gap-1.5 bg-surface2 hover:bg-hairline border border-hairline text-ink2 hover:text-ink p-1.5 sm:p-2 md:px-3 md:py-2 rounded-xl text-xs md:text-sm font-medium transition-colors shrink-0">
                    <svg class="w-4 h-4 shrink-0 text-brass">
                        <use href="#i-gear" />
                    </svg>
                    <span class="hidden md:inline">Configuración</span>
                </button>

                <% if (locals.user) { %>
                <div class="flex items-center gap-2 bg-surface2 border border-hairline rounded-xl px-2.5 py-1.5 text-xs text-ink2 shrink-0">
                    <span class="hidden xl:inline text-ink font-medium"><%= user.email %></span>
                    <a href="/logout" title="Cerrar sesión" class="text-rust hover:text-rust/80 font-semibold transition-colors flex items-center gap-1">
                        <span>Salir</span>
                    </a>
                </div>
                <% } %>
            </div>
        </div>
    </header>

    <!-- MAIN GRID -->
    <main class="max-w-[1440px] mx-auto px-2.5 sm:px-6 py-4 sm:py-8 w-full max-w-full overflow-x-hidden">
        <!-- MODO INVENTARIO - MATERIALES Y HERRAMIENTAS (VISTA EXCLUSIVA) -->
        <div id="materials-view-wrapper" class="hidden w-full max-w-5xl mx-auto mb-8">
            <%- include('components/materials') %>
        </div>

        <!-- MODO PLANIFICACIÓN - AGENDA Y BACKLOG GRID -->
        <div id="main-layout-grid" class="flex flex-col lg:flex-row gap-6 lg:gap-8 w-full items-start min-w-0 max-w-full">

            <div id="backlog-container"
                class="w-full lg:w-1/2 shrink-0 transition-all duration-300 ease-in-out min-w-0 max-w-full overflow-hidden lg:max-w-[1000px]">
                <%- include('components/backlog') %>
            </div>

            <div id="agenda-container" class="w-full flex-1 min-w-0 transition-all duration-300 ease-in-out max-w-full overflow-hidden">
                <%- include('components/agenda') %>
            </div>

        </div>

        <!-- MODO TALLER - VISTA EXCLUSIVA TALLER (OCULTA POR DEFECTO) -->
        <div id="workshop-mode-view" class="hidden w-full space-y-8">
            <!-- CALCULADORA DE OFFSETS -->
            <%- include('components/workshop_calculator') %>

            <!-- VISTA RÁPIDA DE TAREAS Y CONTROLES DEL TALLER -->
            <div id="workshop-tasks-card" class="bg-surface border border-hairline rounded-3xl p-5 sm:p-7 shadow-panel max-w-2xl mx-auto space-y-4">
                <div class="flex items-center justify-between border-b border-hairline pb-3 gap-2 flex-wrap">
                    <h3 class="font-display text-lg font-bold text-ink flex items-center gap-2">
                        <svg class="w-5 h-5 text-brass"><use href="#i-list"/></svg>
                        Tareas Pendientes del Proyecto Activo
                    </h3>
                    <span class="text-xs font-mono bg-surface2 border border-hairline text-brass px-2.5 py-1 rounded-full font-bold">
                        <%= (locals.tasks || []).length %> Tareas
                    </span>
                </div>

                <div class="space-y-2.5">
                    <% if ((locals.tasks || []).length === 0) { %>
                        <p class="text-xs text-ink3 py-4 text-center">¡No hay tareas pendientes en la cola del proyecto!</p>
                    <% } else { %>
                        <% (locals.tasks || []).forEach(t => { %>
                            <div class="flex items-center justify-between p-3.5 bg-surface2 border border-hairline rounded-2xl gap-3">
                                <div class="min-w-0">
                                    <h4 class="font-bold text-sm text-ink truncate"><%= t.title %></h4>
                                    <p class="text-xs text-ink3 mt-0.5"><%= t.estimated_hours %>h activas • <%= t.curing_hours %>h curado</p>
                                </div>
                                <form action="/tasks/<%= t.id %>/complete" method="post" onsubmit="completeTaskInline(event, '<%= t.id %>')">
                                    <button type="submit" class="bg-moss/20 hover:bg-moss text-moss hover:text-canvas border border-moss/40 font-bold px-4 py-2.5 rounded-xl text-xs transition-colors min-h-[44px] flex items-center gap-1.5 shrink-0">
                                        <svg class="w-4 h-4"><use href="#i-check"/></svg> Completar
                                    </button>
                                </form>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>

            <!-- BOTÓN DESTACADO TÉRMINO DE LA JORNADA (DEBAJO DE LA TARJETA DE TAREAS) -->
            <div class="max-w-2xl mx-auto pt-1">
                <button type="button" onclick="confirmEndShift()" class="w-full bg-brass hover:bg-brassdim text-canvas font-bold px-6 py-3.5 rounded-2xl text-sm sm:text-base transition-all shadow-md hover:shadow-lg active:scale-[0.99] flex items-center justify-center gap-2.5 min-h-[50px]">
                    <svg class="w-5 h-5"><use href="#i-check"/></svg>
                    Término de la Jornada
                </button>
            </div>
        </div>
    </main>

    <%- include('components/settings_modal') %>

    <!-- Modal de feedback de evaluación on-screen (Telegram y Google Calendar) -->
    <div id="eval-feedback-modal" class="hidden fixed inset-0 z-[110] bg-canvas/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-hairline rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-hairline">
                <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-brass"></span>
                    Resultado de Evaluación
                </h3>
                <button type="button" onclick="closeEvalFeedbackModal()" class="text-ink3 hover:text-ink p-1">
                    <svg class="w-4 h-4"><use href="#i-close"/></svg>
                </button>
            </div>
            
            <div class="space-y-3">
                <div id="eval-feedback-day" class="p-3 bg-surface2 rounded-xl border border-hairline">
                    <p id="eval-feedback-status" class="text-xs font-bold uppercase tracking-wide text-brass"></p>
                    <p id="eval-feedback-reason" class="text-xs text-ink2 mt-1"></p>
                </div>

                <div class="p-3 bg-surface2 rounded-xl border border-hairline flex items-start gap-3">
                    <div class="text-base shrink-0">💬</div>
                    <div>
                        <p class="text-xs font-semibold text-ink">Notificación Telegram</p>
                        <p id="eval-feedback-tg-text" class="text-xs text-ink2 mt-0.5"></p>
                    </div>
                </div>

                <div class="p-3 bg-surface2 rounded-xl border border-hairline flex items-start gap-3">
                    <div class="text-base shrink-0">📅</div>
                    <div>
                        <p class="text-xs font-semibold text-ink">Google Calendar</p>
                        <p id="eval-feedback-cal-text" class="text-xs text-ink2 mt-0.5"></p>
                    </div>
                </div>
            </div>

            <button type="button" onclick="closeEvalFeedbackModal(true)" class="w-full bg-brass hover:bg-brassdim text-canvas font-semibold py-2.5 rounded-lg text-sm transition-colors min-h-[44px]">
                Aceptar y actualizar
            </button>
        </div>
    </div>

    <!-- Modal de Confirmación Término de la Jornada -->
    <div id="end-shift-confirm-modal" class="hidden fixed inset-0 z-[110] bg-canvas/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-hairline rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-hairline">
                <h3 class="font-display text-base font-bold text-ink flex items-center gap-2">
                    <svg class="w-5 h-5 text-brass"><use href="#i-check"/></svg>
                    ¿Finalizar la Jornada de Hoy?
                </h3>
                <button type="button" onclick="closeConfirmEndShiftModal()" class="text-ink3 hover:text-ink p-1">
                    <svg class="w-4 h-4"><use href="#i-close"/></svg>
                </button>
            </div>

            <p class="text-xs sm:text-sm text-ink2 leading-relaxed">
                Esta acción registrará el término de tu jornada laboral de hoy y ejecutará el <strong>check-in de cierre</strong> para verificar las tareas completadas.
            </p>

            <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-hairline">
                <button type="button" onclick="closeConfirmEndShiftModal()" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-ink2 hover:text-ink hover:bg-surface2 transition-colors min-h-[44px]">
                    Cancelar
                </button>
                <button type="button" onclick="executeEndShift()" id="confirm-end-shift-btn" class="bg-brass hover:bg-brassdim text-canvas font-bold px-5 py-2.5 rounded-xl text-xs transition-colors shadow-sm flex items-center gap-2 min-h-[44px]">
                    <svg class="w-4 h-4"><use href="#i-check"/></svg>
                    Confirmar y Hacer Check-in
                </button>
            </div>
        </div>
    </div>

    <!-- Modal Check-in Manual (Término de la Jornada) -->
    <div id="end-shift-modal" class="hidden fixed inset-0 z-[110] bg-canvas/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-surface border border-hairline rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between pb-3 border-b border-hairline">
                <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
                    <svg class="w-5 h-5 text-brass"><use href="#i-check"/></svg>
                    Check-in Término de la Jornada
                </h3>
                <button type="button" onclick="closeEndShiftModal()" class="text-ink3 hover:text-ink p-1">
                    <svg class="w-4 h-4"><use href="#i-close"/></svg>
                </button>
            </div>

            <div id="end-shift-msg" class="text-xs text-ink2 leading-relaxed bg-surface2 p-3 rounded-xl border border-hairline">
                <!-- Se llena dinámicamente -->
            </div>

            <form id="end-shift-form" onsubmit="submitEndShiftCheckin(event)" class="space-y-4">
                <input type="hidden" id="end-shift-log-id" name="dailyLogId" value="">
                
                <div class="space-y-2">
                    <label class="block text-xs font-bold text-ink uppercase tracking-wider">Selecciona las tareas terminadas hoy:</label>
                    <div id="end-shift-tasks-list" class="space-y-2 max-h-60 overflow-y-auto pr-1">
                        <!-- Tareas listadas aquí con checkboxes -->
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2 border-t border-hairline">
                    <button type="button" onclick="closeEndShiftModal()" class="px-4 py-2 text-xs font-semibold text-ink2 hover:text-ink min-h-[44px]">
                        Cancelar
                    </button>
                    <button type="submit" id="end-shift-submit-btn" class="bg-brass hover:bg-brassdim text-canvas font-bold px-5 py-2 rounded-xl text-xs transition-colors min-h-[44px]">
                        Guardar Check-in
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="toast"
        class="fixed bottom-6 right-6 left-6 sm:left-auto z-[100] bg-moss text-canvas px-5 py-3 rounded-lg font-semibold text-sm shadow-2xl hidden toast-animate">
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script src="/static/js/backlog.js"></script>
    <script src="/static/js/agenda.js"></script>
    <script src="/static/js/settings.js"></script>
    <script src="/static/js/map.js"></script>
    <script>
        async function refreshWorkshopView() {
            try {
                const res = await fetch(window.location.href);
                if (res.ok) {
                    const html = await res.text();
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newQueue = doc.getElementById('workshop-tasks-card');
                    const oldQueue = document.getElementById('workshop-tasks-card');
                    if (newQueue && oldQueue) {
                        oldQueue.innerHTML = newQueue.innerHTML;
                    }
                    const newAgenda = doc.getElementById('agenda-container');
                    const oldAgenda = document.getElementById('agenda-container');
                    if (newAgenda && oldAgenda) {
                        oldAgenda.innerHTML = newAgenda.innerHTML;
                    }
                    const newBacklog = doc.getElementById('backlog-container');
                    const oldBacklog = document.getElementById('backlog-container');
                    if (newBacklog && oldBacklog) {
                        oldBacklog.innerHTML = newBacklog.innerHTML;
                    }
                }
            } catch (e) {
                console.error('Error refreshing workshop view:', e);
            }
        }

        async function completeTaskInline(event, taskId) {
            event.preventDefault();
            try {
                const res = await fetch(`/tasks/${taskId}/complete`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                });
                if (res.ok) {
                    await refreshWorkshopView();
                }
            } catch (err) {
                console.error('Error completing task inline:', err);
            }
        }

        function closeEvalFeedbackModal(shouldReload = true) {
            const modal = document.getElementById('eval-feedback-modal');
            if (modal) modal.classList.add('hidden');
            if (shouldReload) {
                refreshWorkshopView();
            }
        }

        function confirmEndShift() {
            const modal = document.getElementById('end-shift-confirm-modal');
            if (modal) modal.classList.remove('hidden');
        }

        function closeConfirmEndShiftModal() {
            const modal = document.getElementById('end-shift-confirm-modal');
            if (modal) modal.classList.add('hidden');
        }

        async function executeEndShift() {
            const btn = document.getElementById('confirm-end-shift-btn');
            const origHTML = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<svg class="w-4 h-4 animate-spin"><use href="#i-refresh"/></svg> Procesando...`;
            }

            try {
                const res = await fetch('/api/checkin/end_shift', { method: 'POST' });
                const data = await res.json();

                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHTML;
                }

                closeConfirmEndShiftModal();

                if (!data.success) {
                    alert('Error al finalizar jornada: ' + (data.error || 'Error desconocido'));
                    return;
                }

                if (data.alreadyResolved) {
                    if (typeof showToast === 'function') {
                        showToast('ℹ️ El check-in de la jornada de hoy ya fue registrado previamente.');
                    } else {
                        alert('ℹ️ El check-in de la jornada de hoy ya fue registrado previamente.');
                    }
                    return;
                }

                if (data.telegramSent) {
                    if (typeof showToast === 'function') {
                        showToast('✅ Jornada finalizada. Check-in enviado por Telegram.');
                    } else {
                        alert('✅ Jornada finalizada. Check-in enviado por Telegram.');
                    }
                    await refreshWorkshopView();
                } else {
                    openEndShiftModal(data);
                }
            } catch (err) {
                console.error('Error al solicitar término de jornada:', err);
                alert('Error de conexión al terminar la jornada');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHTML;
                }
                closeConfirmEndShiftModal();
            }
        }

        function openEndShiftModal(data) {
            const modal = document.getElementById('end-shift-modal');
            const logIdInput = document.getElementById('end-shift-log-id');
            const msgDiv = document.getElementById('end-shift-msg');
            const tasksDiv = document.getElementById('end-shift-tasks-list');

            if (!modal) return;

            if (logIdInput) logIdInput.value = data.dailyLogId || '';

            if (msgDiv) {
                let reason = data.telegramError || 'No se pudo enviar la notificación por Telegram.';
                msgDiv.innerHTML = `<p class="font-semibold text-amber-400 mb-1">⚠️ Notificación por Telegram no disponible</p><p class="text-[11px] text-ink2">${reason}</p><p class="mt-1.5 font-medium text-ink">Por favor marca a continuación cuáles de las tareas programadas para hoy lograste terminar:</p>`;
            }

            if (tasksDiv) {
                const tasks = data.tasks || [];
                if (tasks.length === 0) {
                    tasksDiv.innerHTML = `<p class="text-xs text-ink3 py-3 text-center">No hay tareas programadas para la jornada de hoy.</p>`;
                } else {
                    tasksDiv.innerHTML = tasks.map(t => `
                        <label class="flex items-center gap-3 p-3 bg-surface2 border border-hairline rounded-xl cursor-pointer hover:border-brass/50 transition-colors">
                            <input type="checkbox" name="completedTasks" value="${t.id}" ${t.completed ? 'checked' : ''} class="w-4 h-4 rounded border-hairline text-brass focus:ring-brass accent-brass">
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold text-ink truncate">${t.title}</p>
                                ${t.project_name ? `<p class="text-[10px] text-ink3 truncate">${t.project_name}</p>` : ''}
                            </div>
                            <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-surface border border-hairline text-brass shrink-0">${t.estimated_hours}h</span>
                        </label>
                    `).join('');
                }
            }

            modal.classList.remove('hidden');
        }

        function closeEndShiftModal() {
            const modal = document.getElementById('end-shift-modal');
            if (modal) modal.classList.add('hidden');
        }

        async function submitEndShiftCheckin(event) {
            event.preventDefault();
            const form = document.getElementById('end-shift-form');
            const submitBtn = document.getElementById('end-shift-submit-btn');
            if (!form) return;

            const dailyLogId = document.getElementById('end-shift-log-id')?.value;
            const checkedBoxes = form.querySelectorAll('input[name="completedTasks"]:checked');
            const completedTaskIds = Array.from(checkedBoxes).map(cb => parseInt(cb.value, 10));

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Guardando...';
            }

            try {
                const res = await fetch('/api/checkin/resolve', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        dailyLogId: dailyLogId ? parseInt(dailyLogId, 10) : null,
                        completedTaskIds
                    })
                });

                const data = await res.json();
                if (data.success) {
                    closeEndShiftModal();
                    if (typeof showToast === 'function') {
                        showToast('✅ Check-in guardado exitosamente.');
                    }
                    await refreshWorkshopView();
                } else {
                    alert('Error al guardar el check-in: ' + (data.error || 'Error desconocido'));
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Guardar Check-in';
                    }
                }
            } catch (err) {
                console.error('Error guardando check-in manual:', err);
                alert('Error de conexión al guardar el check-in');
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Guardar Check-in';
                }
            }
        }

        Object.assign(window, {
            closeEvalFeedbackModal,
            confirmEndShift,
            closeConfirmEndShiftModal,
            executeEndShift,
            openEndShiftModal,
            closeEndShiftModal,
            submitEndShiftCheckin
        });

        document.addEventListener('DOMContentLoaded', function () {
            const evalForm = document.getElementById('eval-form');
            const evalBtn = document.getElementById('eval-btn');

            if (evalForm) {
                evalForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    
                    if (evalBtn) {
                        evalBtn.disabled = true;
                        evalBtn.innerHTML = `
                            <svg class="animate-spin h-3.5 w-3.5 text-canvas inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        `;
                    }

                    fetch('/evaluation/force_run', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({})
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (evalBtn) {
                            evalBtn.disabled = false;
                            evalBtn.innerText = 'Evaluar';
                        }

                        const modal = document.getElementById('eval-feedback-modal');
                        const statusEl = document.getElementById('eval-feedback-status');
                        const reasonEl = document.getElementById('eval-feedback-reason');
                        const tgText = document.getElementById('eval-feedback-tg-text');
                        const calText = document.getElementById('eval-feedback-cal-text');

                        if (modal && statusEl && reasonEl && tgText && calText) {
                            const isViable = data.status === 'DAY_VIABLE';
                            statusEl.innerText = isViable ? 'Día Viable' : 'Día Bloqueado';
                            statusEl.className = isViable ? 'text-xs font-bold uppercase tracking-wide text-moss' : 'text-xs font-bold uppercase tracking-wide text-rust';
                            reasonEl.innerText = data.reason || (isViable ? 'Ventana de trabajo habilitada.' : 'No se puede trabajar al aire libre.');

                            tgText.innerText = data.telegramReason || (data.telegramSent ? '✅ Mensaje enviado a Telegram' : '⚠️ Telegram no configurado / omitido');
                            calText.innerText = data.calendarReason || (data.calendarSynced ? '📅 Eventos agendados en Google Calendar' : 'ℹ️ Google Calendar no conectado');

                            modal.classList.remove('hidden');
                        } else {
                            refreshWorkshopView();
                        }
                    })
                    .catch(err => {
                        console.error('Error in evaluation:', err);
                        if (evalBtn) {
                            evalBtn.disabled = false;
                            evalBtn.innerText = 'Evaluar';
                        }
                        evalForm.submit();
                    });
                });
            }

            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW registration error:', err));
            }
        });
    </script>
</body>

</html>
