<!DOCTYPE html>
<html lang="es" class="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Cuenta — Workshop OS</title>
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0f172a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        display: ['"Fraunces"', 'serif'],
                        sans: ['"IBM Plex Sans"', 'system-ui', 'sans-serif'],
                    },
                    colors: {
                        canvas: '#020617',
                        surface: '#0f172a',
                        surface2: '#1e293b',
                        hairline: '#334155',
                        ink: '#f8fafc',
                        ink2: '#94a3b8',
                        ink3: '#64748b',
                        brass: '#6366f1',
                        brassdim: '#4f46e5',
                        rust: '#f43f5e',
                    }
                },
            },
        }
    </script>
</head>

<body class="bg-canvas text-ink min-h-screen antialiased flex items-center justify-center p-4">

    <div class="w-full max-w-md bg-surface border border-hairline rounded-2xl p-6 sm:p-8 shadow-2xl space-y-6">
        
        <div class="text-center space-y-2">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-surface2 border border-hairline text-brass mb-2">
                <svg class="w-6 h-6" viewBox="0 0 32 32">
                    <path d="M4 24 L16 6 L28 24 Z" fill="none" stroke="currentColor" stroke-width="2" />
                    <path d="M11 24 L16 15 L21 24" fill="none" stroke="currentColor" stroke-width="2" />
                    <line x1="4" y1="24" x2="28" y2="24" stroke="currentColor" stroke-width="2" />
                </svg>
            </div>
            <h1 class="font-display text-2xl font-bold tracking-tight text-ink">Workshop OS</h1>
            <p class="text-xs text-ink2">Crea tu cuenta para organizar tu taller</p>
        </div>

        <% if (locals.error) { %>
        <div class="bg-rust/10 border border-rust/30 text-rust rounded-lg px-3.5 py-2.5 text-xs font-medium flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <circle cx="12" cy="12" r="10" stroke-width="2"/>
                <line x1="12" y1="8" x2="12" y2="12" stroke-width="2" stroke-linecap="round"/>
                <circle cx="12" cy="16" r="1"/>
            </svg>
            <span><%= error %></span>
        </div>
        <% } %>

        <form action="/register" method="post" class="space-y-4">
            <div>
                <label for="email" class="block text-xs font-semibold text-ink2 uppercase tracking-wider mb-1">Correo Electrónico</label>
                <input type="email" id="email" name="email" required placeholder="tu@email.com" value="<%= locals.email || '' %>"
                    class="w-full bg-surface2 text-ink border border-hairline rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:border-brass transition-colors">
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold text-ink2 uppercase tracking-wider mb-1">Contraseña</label>
                <input type="password" id="password" name="password" required placeholder="Mínimo 6 caracteres"
                    class="w-full bg-surface2 text-ink border border-hairline rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:border-brass transition-colors">
            </div>

            <div>
                <label for="password_confirm" class="block text-xs font-semibold text-ink2 uppercase tracking-wider mb-1">Confirmar Contraseña</label>
                <input type="password" id="password_confirm" name="password_confirm" required placeholder="Repite tu contraseña"
                    class="w-full bg-surface2 text-ink border border-hairline rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:border-brass transition-colors">
            </div>

            <button type="submit"
                class="w-full bg-brass hover:bg-brassdim text-ink text-sm font-semibold py-2.5 px-4 rounded-lg transition-colors shadow-lg">
                Registrarse
            </button>
        </form>

        <div class="pt-4 border-t border-hairline text-center">
            <p class="text-xs text-ink3">
                ¿Ya tienes una cuenta? <a href="/login" class="text-brass hover:underline font-semibold">Inicia Sesión</a>
            </p>
        </div>

    </div>

</body>
</html>
