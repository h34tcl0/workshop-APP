<!-- Modal de feedback de evaluación on-screen (Telegram y Google Calendar) -->
<div id="eval-feedback-modal" class="hidden fixed inset-0 z-[110] bg-canvas/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-surface border border-hairline rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-hairline">
            <h3 class="font-display text-base font-semibold text-ink flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-brass"></span>
                Resultado de Evaluación
            </h3>
            <button type="button" onclick="closeEvalFeedbackModal()" class="text-ink3 hover:text-ink p-1">
                <svg class="w-4 h-4"><use href="#i-close"/></svg>
            </button>
        </div>
        
        <div class="space-y-3">
            <div id="eval-feedback-day" class="p-3 bg-surface2 rounded-xl border border-hairline">
                <p id="eval-feedback-status" class="text-xs font-bold uppercase tracking-wide text-brass"></p>
                <p id="eval-feedback-reason" class="text-xs text-ink2 mt-1"></p>
            </div>

            <div class="p-3 bg-surface2 rounded-xl border border-hairline flex items-start gap-3">
                <div class="text-base shrink-0">💬</div>
                <div>
                    <p class="text-xs font-semibold text-ink">Notificación Telegram</p>
                    <p id="eval-feedback-tg-text" class="text-xs text-ink2 mt-0.5"></p>
                </div>
            </div>

            <div class="p-3 bg-surface2 rounded-xl border border-hairline flex items-start gap-3">
                <div class="text-base shrink-0">📅</div>
                <div>
                    <p class="text-xs font-semibold text-ink">Google Calendar</p>
                    <p id="eval-feedback-cal-text" class="text-xs text-ink2 mt-0.5"></p>
                </div>
            </div>
        </div>

        <button type="button" onclick="closeEvalFeedbackModal(true)" class="w-full bg-brass hover:bg-brassdim text-canvas font-semibold py-2.5 rounded-lg text-sm transition-colors min-h-[44px]">
            Aceptar y actualizar
        </button>
    </div>
</div>
