<script>
    async function completeTaskInline(event, taskId) {
        event.preventDefault();
        try {
            const res = await fetch(`/tasks/${taskId}/complete`, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
            });
            if (res.ok) {
                await refreshWorkshopView();
            }
        } catch (err) {
            console.error('Error completing task inline:', err);
        }
    }

    function closeEvalFeedbackModal(shouldReload = true) {
        const modal = document.getElementById('eval-feedback-modal');
        if (modal) modal.classList.add('hidden');
        if (shouldReload) {
            refreshWorkshopView();
        }
    }

    function confirmEndShift() {
        const modal = document.getElementById('end-shift-confirm-modal');
        if (modal) modal.classList.remove('hidden');
    }

    function closeConfirmEndShiftModal() {
        const modal = document.getElementById('end-shift-confirm-modal');
        if (modal) modal.classList.add('hidden');
    }

    async function executeEndShift() {
        const btn = document.getElementById('confirm-end-shift-btn');
        const origHTML = btn ? btn.innerHTML : '';
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<svg class="w-4 h-4 animate-spin"><use href="#i-refresh"/></svg> Procesando...`;
        }

        try {
            const res = await fetch('/api/checkin/end_shift', { method: 'POST' });
            const data = await res.json();

            if (btn) {
                btn.disabled = false;
                btn.innerHTML = origHTML;
            }

            closeConfirmEndShiftModal();

            if (!data.success) {
                alert('Error al finalizar jornada: ' + (data.error || 'Error desconocido'));
                return;
            }

            if (data.alreadyResolved) {
                if (typeof showToast === 'function') {
                    showToast('ℹ️ El check-in de la jornada de hoy ya fue registrado previamente.');
                } else {
                    alert('ℹ️ El check-in de la jornada de hoy ya fue registrado previamente.');
                }
                return;
            }

            if (data.telegramSent) {
                if (typeof showToast === 'function') {
                    showToast('✅ Jornada finalizada. Check-in enviado por Telegram.');
                } else {
                    alert('✅ Jornada finalizada. Check-in enviado por Telegram.');
                }
                await refreshWorkshopView();
            } else {
                openEndShiftModal(data);
            }
        } catch (err) {
            console.error('Error al solicitar término de jornada:', err);
            alert('Error de conexión al terminar la jornada');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = origHTML;
            }
            closeConfirmEndShiftModal();
        }
    }

    function openEndShiftModal(data) {
        const modal = document.getElementById('end-shift-modal');
        const logIdInput = document.getElementById('end-shift-log-id');
        const msgDiv = document.getElementById('end-shift-msg');
        const tasksDiv = document.getElementById('end-shift-tasks-list');

        if (!modal) return;

        if (logIdInput) logIdInput.value = data.dailyLogId || '';

        if (msgDiv) {
            let reason = data.telegramError || 'No se pudo enviar la notificación por Telegram.';
            msgDiv.innerHTML = `<p class="font-semibold text-amber-400 mb-1">⚠️ Notificación por Telegram no disponible</p><p class="text-[11px] text-ink2">${reason}</p><p class="mt-1.5 font-medium text-ink">Por favor marca a continuación cuáles de las tareas programadas para hoy lograste terminar:</p>`;
        }

        if (tasksDiv) {
            const tasks = data.tasks || [];
            if (tasks.length === 0) {
                tasksDiv.innerHTML = `<p class="text-xs text-ink3 py-3 text-center">No hay tareas programadas para la jornada de hoy.</p>`;
            } else {
                tasksDiv.innerHTML = tasks.map(t => `
                    <label class="flex items-center gap-3 p-3 bg-surface2 border border-hairline rounded-xl cursor-pointer hover:border-brass/50 transition-colors">
                        <input type="checkbox" name="completedTasks" value="${t.id}" ${t.completed ? 'checked' : ''} class="w-4 h-4 rounded border-hairline text-brass focus:ring-brass accent-brass">
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-bold text-ink truncate">${t.title}</p>
                            ${t.project_name ? `<p class="text-[10px] text-ink3 truncate">${t.project_name}</p>` : ''}
                        </div>
                        <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-surface border border-hairline text-brass shrink-0">${t.estimated_hours}h</span>
                    </label>
                `).join('');
            }
        }

        modal.classList.remove('hidden');
    }

    function closeEndShiftModal() {
        const modal = document.getElementById('end-shift-modal');
        if (modal) modal.classList.add('hidden');
    }

    async function submitEndShiftCheckin(event) {
        event.preventDefault();
        const form = document.getElementById('end-shift-form');
        const submitBtn = document.getElementById('end-shift-submit-btn');
        if (!form) return;

        const dailyLogId = document.getElementById('end-shift-log-id')?.value;
        const checkedBoxes = form.querySelectorAll('input[name="completedTasks"]:checked');
        const completedTaskIds = Array.from(checkedBoxes).map(cb => parseInt(cb.value, 10));

        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Guardando...';
        }

        try {
            const res = await fetch('/api/checkin/resolve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    dailyLogId: dailyLogId ? parseInt(dailyLogId, 10) : null,
                    completedTaskIds
                })
            });

            const data = await res.json();
            if (data.success) {
                closeEndShiftModal();

                // Desvanecimiento y remoción inmediata de elementos en el DOM sin esperar el refresco
                const floatingBanner = document.getElementById('checkin-floating-banner');
                if (floatingBanner) {
                    floatingBanner.classList.add('transition-all', 'duration-300', 'opacity-0', 'scale-95');
                    setTimeout(() => floatingBanner.remove(), 300);
                }

                if (typeof showToast === 'function') {
                    showToast('✅ Check-in guardado exitosamente.');
                }
                await refreshWorkshopView();
            } else {
                alert('Error al guardar el check-in: ' + (data.error || 'Error desconocido'));
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Guardar Check-in';
                }
            }
        } catch (err) {
            console.error('Error guardando check-in manual:', err);
            alert('Error de conexión al guardar el check-in');
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Guardar Check-in';
            }
        }
    }

    Object.assign(window, {
        closeEvalFeedbackModal,
        confirmEndShift,
        closeConfirmEndShiftModal,
        executeEndShift,
        openEndShiftModal,
        closeEndShiftModal,
        submitEndShiftCheckin,
        openPauseRangeModal,
        closePauseRangeModal,
        submitPauseRangeForm,
        submitClearRangeAction
    });

    function openPauseRangeModal() {
        const modal = document.getElementById('pause-range-modal');
        if (!modal) return;
        const startInput = document.getElementById('pause-start-date');
        const endInput = document.getElementById('pause-end-date');
        
        const today = new Date();
        const yyyy = today.getFullYear();
        const mm = String(today.getMonth() + 1).padStart(2, '0');
        const dd = String(today.getDate()).padStart(2, '0');
        const todayStr = `${yyyy}-${mm}-${dd}`;
        
        const nextWeek = new Date(today.getTime() + 7 * 24 * 60 * 60 * 1000);
        const nwY = nextWeek.getFullYear();
        const nwM = String(nextWeek.getMonth() + 1).padStart(2, '0');
        const nwD = String(nextWeek.getDate()).padStart(2, '0');
        const nextWeekStr = `${nwY}-${nwM}-${nwD}`;
        
        if (startInput && !startInput.value) startInput.value = todayStr;
        if (endInput && !endInput.value) endInput.value = nextWeekStr;
        
        modal.classList.remove('hidden');
    }

    function closePauseRangeModal() {
        const modal = document.getElementById('pause-range-modal');
        if (modal) modal.classList.add('hidden');
    }

    async function submitPauseRangeForm(e) {
        e.preventDefault();
        const form = document.getElementById('pause-range-form');
        const submitBtn = document.getElementById('pause-submit-btn');
        if (!form) return;
        
        const start_date = form.start_date.value;
        const end_date = form.end_date.value;
        const note = form.note.value;

        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="animate-spin mr-1">⏳</span> Pausando...';
        }

        try {
            const res = await fetch('/day-overrides/range', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ start_date, end_date, note })
            });
            const data = await res.json();
            if (data.success) {
                closePauseRangeModal();
                if (typeof showToast === 'function') {
                    showToast('Agenda pausada correctamente.');
                }
                await refreshWorkshopView();
            } else {
                alert(data.error || 'No se pudo pausar el rango seleccionado.');
            }
        } catch (err) {
            console.error('Error pausing range:', err);
            form.submit();
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg><span>Pausar Agenda</span>';
            }
        }
    }

    async function submitClearRangeAction() {
        const form = document.getElementById('pause-range-form');
        if (!form) return;
        const start_date = form.start_date.value;
        const end_date = form.end_date.value;
        if (!start_date || !end_date) {
            alert('Por favor selecciona las fechas de inicio y término.');
            return;
        }

        if (!confirm(`¿Desbloquear la agenda y reanudar actividades entre ${start_date} y ${end_date}?`)) {
            return;
        }

        try {
            const res = await fetch('/day-overrides/clear-range', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ start_date, end_date })
            });
            const data = await res.json();
            if (data.success) {
                closePauseRangeModal();
                if (typeof showToast === 'function') {
                    showToast('Rango de vacaciones reanudado.');
                }
                await refreshWorkshopView();
            } else {
                alert(data.error || 'No se pudo desbloquear el rango.');
            }
        } catch (err) {
            console.error('Error clearing range:', err);
            alert('Error de conexión al reanudar rango.');
        }
    }

    function openOverdueCheckinsModal(focusDateIso) {
        const modal = document.getElementById('overdue-checkins-modal');
        if (!modal) return;
        modal.classList.remove('hidden');
        if (focusDateIso) {
            const targetEl = document.getElementById('overdue-card-' + focusDateIso);
            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                targetEl.classList.add('ring-2', 'ring-amber-400');
                setTimeout(() => targetEl.classList.remove('ring-2', 'ring-amber-400'), 2000);
            }
        }
    }

    function closeOverdueCheckinsModal() {
        const modal = document.getElementById('overdue-checkins-modal');
        if (modal) modal.classList.add('hidden');
    }

    async function resolveOverdueDay(dateIso, dailyLogId, markCompleted) {
        let completedTaskIds = [];
        if (markCompleted) {
            const checkedBoxes = document.querySelectorAll(`input[name="task-completed-${dateIso}"]:checked`);
            checkedBoxes.forEach(cb => completedTaskIds.push(Number(cb.value)));
        }

        try {
            const res = await fetch('/api/checkin/resolve', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    dailyLogId: dailyLogId ? Number(dailyLogId) : undefined,
                    dateIso: dateIso,
                    completedTaskIds: completedTaskIds
                })
            });
            const data = await res.json();
            if (data.success) {
                if (typeof showToast === 'function') {
                    showToast(`Jornada ${dateIso} resuelta correctamente.`);
                }
                closeOverdueCheckinsModal();
                await refreshWorkshopView();
            } else {
                alert(data.error || 'No se pudo resolver la jornada.');
            }
        } catch (err) {
            console.error('Error al resolver jornada vencida:', err);
            alert('Error de conexión al resolver jornada.');
        }
    }

    async function resolveAllOverdueDays() {
        if (!confirm('¿Reprogramar todas las tareas de jornadas vencidas al backlog y cerrar los días pendientes?')) {
            return;
        }

        const btn = document.getElementById('btn-resolve-all-overdue');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = 'Reprogramando...';
        }

        try {
            const res = await fetch('/api/checkin/resolve-all-overdue', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                }
            });
            const data = await res.json();
            if (data.success) {
                if (typeof showToast === 'function') {
                    showToast(data.message || 'Jornadas vencidas resueltas.');
                }
                closeOverdueCheckinsModal();
                await refreshWorkshopView();
            } else {
                alert(data.error || 'No se pudieron resolver las jornadas.');
            }
        } catch (err) {
            console.error('Error al resolver todas las jornadas vencidas:', err);
            alert('Error de conexión.');
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(err => console.log('SW registration error:', err));
        }
    });
</script>
