<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Panel de Administración - AgendApp</title>
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="min-h-full flex flex-col bg-slate-950 font-sans antialiased text-slate-200">
  <div class="hidden">
    <%- include('partials/_svg_icons') %>
  </div>

  <!-- Header / Navigation Bar -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-30 px-4 sm:px-6 py-3.5">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2 text-amber-500 hover:text-amber-400 font-serif font-bold text-xl tracking-tight transition-colors">
          <span>🪵 AgendApp</span>
        </a>
        <span class="text-xs px-2.5 py-0.5 rounded-full font-mono font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30">
          ADMIN
        </span>
      </div>

      <div class="flex items-center gap-3">
        <a href="/" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg transition-colors">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>Volver al Taller</span>
        </a>
        <span class="text-xs text-slate-400 hidden sm:inline-block font-mono"><%= user.email %></span>
        <a href="/logout" class="px-2.5 py-1.5 text-xs font-medium text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition-colors">
          Cerrar Sesión
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">
    <!-- Top Stats Banner -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between">
        <span class="text-xs font-medium text-slate-400">Total Usuarios</span>
        <span class="text-2xl font-bold font-mono text-slate-100 mt-1" id="stat-total-users"><%= stats.total_users %></span>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between">
        <span class="text-xs font-medium text-slate-400">Activos</span>
        <span class="text-2xl font-bold font-mono text-emerald-400 mt-1" id="stat-active-users"><%= stats.active_users %></span>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between">
        <span class="text-xs font-medium text-slate-400">Bloqueados / Revocados</span>
        <span class="text-2xl font-bold font-mono text-amber-400 mt-1" id="stat-restricted-users"><%= stats.blocked_users + stats.revoked_users %></span>
      </div>
      <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex flex-col justify-between">
        <span class="text-xs font-medium text-slate-400">Administradores</span>
        <span class="text-2xl font-bold font-mono text-sky-400 mt-1" id="stat-admin-users"><%= stats.admin_users %></span>
      </div>
    </div>

    <!-- Navigation Tabs Header -->
    <div class="border-b border-slate-800 flex items-center gap-2 overflow-x-auto no-scrollbar">
      <button type="button" id="tab-btn-users" onclick="switchAdminTab('users')" class="admin-tab-btn active px-4 py-2.5 text-sm font-medium border-b-2 border-amber-500 text-amber-400 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <span>Usuarios</span>
      </button>
      <button type="button" id="tab-btn-limits" onclick="switchAdminTab('limits')" class="admin-tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        <span>Cuotas & Límites</span>
      </button>
      <button type="button" id="tab-btn-system" onclick="switchAdminTab('system')" class="admin-tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>
        <span>Sistema</span>
      </button>
      <button type="button" id="tab-btn-audit" onclick="switchAdminTab('audit')" class="admin-tab-btn px-4 py-2.5 text-sm font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <span>Auditoría</span>
      </button>
    </div>

    <!-- Tab Contents Panels -->
    <div id="tab-panel-users" class="admin-tab-panel space-y-4">
      <%- include('components/admin/_tab_users') %>
    </div>
    <div id="tab-panel-limits" class="admin-tab-panel hidden space-y-4">
      <%- include('components/admin/_tab_limits') %>
    </div>
    <div id="tab-panel-system" class="admin-tab-panel hidden space-y-4">
      <%- include('components/admin/_tab_system') %>
    </div>
    <div id="tab-panel-audit" class="admin-tab-panel hidden space-y-4">
      <%- include('components/admin/_tab_audit') %>
    </div>
  </main>

  <!-- Step-up Authentication Security Modal -->
  <%- include('components/admin/_modal_step_up') %>

  <!-- Feedback Toast Container -->
  <div id="admin-toast" class="fixed bottom-5 right-5 z-50 transform translate-y-16 opacity-0 transition-all duration-300 px-4 py-3 rounded-xl border text-sm font-medium shadow-2xl flex items-center gap-3"></div>

  <!-- Client-side Scripts -->
  <script>
    function switchAdminTab(tabName) {
      document.querySelectorAll('.admin-tab-btn').forEach(btn => {
        btn.classList.remove('active', 'border-amber-500', 'text-amber-400');
        btn.classList.add('border-transparent', 'text-slate-400');
      });
      document.querySelectorAll('.admin-tab-panel').forEach(p => p.classList.add('hidden'));

      const activeBtn = document.getElementById(`tab-btn-${tabName}`);
      const activePanel = document.getElementById(`tab-panel-${tabName}`);
      if (activeBtn) {
        activeBtn.classList.add('active', 'border-amber-500', 'text-amber-400');
        activeBtn.classList.remove('border-transparent', 'text-slate-400');
      }
      if (activePanel) activePanel.classList.remove('hidden');

      if (tabName === 'users' && window.loadAdminUsers) window.loadAdminUsers();
      if (tabName === 'system' && window.loadAdminSystemSettings) window.loadAdminSystemSettings();
      if (tabName === 'audit' && window.loadAdminAuditLogs) window.loadAdminAuditLogs();
    }

    function showAdminToast(msg, type = 'success') {
      const toast = document.getElementById('admin-toast');
      if (!toast) return;
      toast.textContent = msg;
      toast.className = `fixed bottom-5 right-5 z-50 px-4 py-3 rounded-xl border text-sm font-medium shadow-2xl flex items-center gap-3 transition-all duration-300 ${
        type === 'success' ? 'bg-emerald-950/90 text-emerald-300 border-emerald-700/60' : 'bg-red-950/90 text-red-300 border-red-700/60'
      }`;
      toast.classList.remove('translate-y-16', 'opacity-0');
      setTimeout(() => toast.classList.add('translate-y-16', 'opacity-0'), 4000);
    }
  </script>
  <script src="/js/admin/adminUsers.js"></script>
  <script src="/js/admin/adminLimits.js"></script>
  <script src="/js/admin/adminSystem.js"></script>
  <script src="/js/admin/adminAudit.js"></script>
</body>
</html>
